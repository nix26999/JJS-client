for i,cat in ipairs(cats) do
 local name=cat[1]
 if cat[3]~=lastGroup then lastGroup=cat[3];make("TextLabel",side,{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text=lastGroup,TextColor3=T.mut,Font=Enum.Font.GothamBold,TextSize=9,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=i*10-1}) end
 local b=make("TextButton",side,{Size=UDim2.new(1,0,0,30),BackgroundColor3=T.p2,BackgroundTransparency=i==1 and 0 or 1,Text=name,TextColor3=i==1 and T.txt or T.dim,Font=Enum.Font.GothamMedium,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=i*10});corner(b,8);buttons[name]=b

 bindCapture=function()
  CAS:UnbindAction(action);if pairInFlight or not(enabledV2 or enabledV3) or not running then return end
  CAS:BindActionAtPriority(action,function(_,state)
   if typing() then startArmed=false;return Enum.ContextActionResult.Pass end
   if state==Enum.UserInputState.Begin then if not active and os.clock()>=suppressStartUntil then startArmed=true end
   elseif state==Enum.UserInputState.End then local launch=startArmed;startArmed=false;if launch and not active then start() end
   elseif state==Enum.UserInputState.Cancel then startArmed=false end
   return Enum.ContextActionResult.Sink
  end,false,4000,Enum.KeyCode.Three)
 end
 start=function()
  if active or not(enabledV2 or enabledV3) or not running or os.clock()<suppressStartUntil then return end;runVersion=enabledV3 and 3 or 2

 end
 local function dashPathClear(r,tr,dir) local travel=dir*17.5;local relative=flat(r.Position-tr.Position);local t=math.clamp(-relative:Dot(travel)/math.max(travel:Dot(travel),.001),0,1);return(relative+travel*t).Magnitude>=SIDE_MIN end
 local function flickCamera(dashKey,right)
  local cam=workspace.CurrentCamera;if not cam or typing() then return end;local degrees=dashKey==Enum.KeyCode.D and -CFG.Turn or CFG.Turn;if calculatorEnabled and autoCameraAngle and targetRoot then degrees=signedYaw(cam.CFrame.LookVector,targetRoot.Position-cam.CFrame.Position) end;if math.abs(degrees)<.01 then return end

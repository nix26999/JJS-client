toggle(tc,"Todo Macro",function() return todoEnabled end,function(v) todoEnabled=v end)
local todoStatus=make("TextLabel",tc,{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="Ready",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(tc)+2})
local sc=card(pages.Settings,"Session","RightShift hides/shows the menu; X hides it")
local status=make("TextLabel",sc,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text="Ready",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3})
local unload=make("TextButton",sc,{Size=UDim2.new(1,0,0,30),BackgroundColor3=Color3.fromRGB(130,45,65),Text="Unload",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=4}); corner(unload,8)
local okVIM,VIM=pcall(function() return game:GetService("VirtualInputManager") end)
local function todoWait(seconds)
 local finish=os.clock()+seconds
 while running and todoEnabled and os.clock()<finish do task.wait() end
 return running and todoEnabled
end
local function todoKey(key)
 assert(okVIM and VIM,"Input simulation unavailable")
 VIM:SendKeyEvent(true,key,false,game)
 task.wait(.035)
 VIM:SendKeyEvent(false,key,false,game)
end
local function runTodo()
 if todoBusy or busy or not running or not todoEnabled then return end
 todoBusy=true; busy=true
 local ok,err=pcall(function()
  if not todoWait(.8) then return end
  todoKey(Enum.KeyCode.R)
  if not todoWait(.1) then return end
  todoKey(Enum.KeyCode.Two)
  if not todoWait(.65) then return end
  todoKey(Enum.KeyCode.Two)
 end)
 todoBusy=false; busy=false
 if running then
  todoStatus.Text=ok and (todoEnabled and "Sequence finished" or "Cancelled") or tostring(err)
  todoStatus.TextColor3=ok and T.dim or T.warn
 end
end
local keyHeld=false
local function release() if keyHeld and okVIM then pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Three,false,game) end) end; keyHeld=false end
local function send(duration)
 assert(okVIM and VIM,"Input simulation unavailable")
 keyHeld=true; VIM:SendKeyEvent(true,Enum.KeyCode.Three,false,game)
 local untilTime=os.clock()+duration
 while running and enabled and os.clock()<untilTime do task.wait() end
 release()
end
local function run()
 if busy or not enabled or not running then return end
 busy=true
 local ms,action=delayMs,mode
 local ok,err=pcall(function()
  task.wait(ms/1000)
  if not running or not enabled then return end
  local count=action=="Triple" and 3 or action=="Double" and 2 or 1
  for i=1,count do
   if not enabled or not running then break end
   send(action=="Hold" and ms/1000 or .035)
   if i<count then task.wait(.08) end
  end
 end)
 release(); busy=false
 if running then status.Text=ok and "Action finished (not a hit confirmation)" or tostring(err) end
end
local function chainActive() return running and chainEnabled end
local function chainWait(seconds)
 local finish=os.clock()+seconds
 while chainActive() and os.clock()<finish do task.wait() end
 return chainActive()
end
local function chainClickLMB()
 if not chainActive() then return false end
 assert(okVIM and VIM,"Input simulation unavailable")
 -- Always attempt mouse-up, even if cancellation or an input error happens mid-click.
 local pressed=false
 local ok,err=pcall(function()
  VIM:SendMouseButtonEvent(0,0,0,true,game,0)
  pressed=true
  chainWait(.035)
 end)
 if pressed then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
 if not ok then error(err,0) end
 return chainActive()
end
local function chainPress3()
 if not chainActive() then return false end
 send(.035)
 return chainActive()
end
local function runChain()
 if busy or not chainActive() then return end
 busy=true
 local ok,err=pcall(function()
  for i=1,chainRepeats do
   if not chainActive() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(.65) then break end
   if not chainClickLMB() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(.65) then break end
   if not chainClickLMB() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if i%2==0 and i<chainRepeats then
    chainCooldownUntil=os.clock()+5
    busy=false
    return
   end
  end
 end)
 release()
 busy=false
 if running then status.Text=ok and "Copied Auto Blackflash sequence finished" or tostring(err) end
end
local humanoids={}
local function track(o) if o:IsA("Humanoid") then humanoids[o]=true end end
connect(workspace.DescendantAdded,track)
connect(workspace.DescendantRemoving,function(o) humanoids[o]=nil end)
for _,o in ipairs(workspace:GetDescendants()) do track(o) end
local function target()
 local char=LP.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root then return nil,nil end
 local best,distance=nil,lockDistance
 local bestModel=nil
 for hum in pairs(humanoids) do
  local model=hum.Parent
  if model and model:IsA("Model") and model~=char and hum.Health>0 then
   local owner=Players:GetPlayerFromCharacter(model)
   if owner or includeNPC then
    local part=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if part and part:IsA("BasePart") then
     local d=(part.Position-root.Position).Magnitude
     if d<distance then best=part; distance=d; bestModel=model end
    end
   end
  end
 end
 return best,bestModel
end
local bind="AutoBlackflashCamera"
local cached,targetModel,lastScan=nil,nil,0
RS:BindToRenderStep(bind,Enum.RenderPriority.Camera.Value+1,function(dt)
 if not running or not lockOn then cached=nil; return end
 if UIS:GetFocusedTextBox() then return end
 if os.clock()-lastScan>.2 then cached,targetModel=target(); lastScan=os.clock() end
 local cam=workspace.CurrentCamera
 if cam and cached and cached.Parent then
  local aimPos=cached.Position
  if targetModel and lockTargetMode=="Back" then
   local root=targetModel:FindFirstChild("HumanoidRootPart")
   if root then aimPos=root.Position-root.CFrame.LookVector*3 end
  end
  local delta=aimPos-cam.CFrame.Position
  if delta.Magnitude>.01 then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,aimPos),1-math.exp(-18*dt)) end
  if pullEnabled and cached.Parent then
   local char=LP.Character
   local root=char and char:FindFirstChild("HumanoidRootPart")
   if root then
    local direction=aimPos-root.Position
    if direction.Magnitude>.5 then root.AssemblyLinearVelocity=direction.Unit*pullStrength end
   end
  end
 end
end)
local function clapClick()
 if not okVIM or not VIM then return end
 VIM:SendMouseButtonEvent(0,0,0,true,game,0)
 task.wait(.035)
 VIM:SendMouseButtonEvent(0,0,0,false,game,0)
end
local function runPerfectClap()
 if not perfectClapEnabled or not running then return end
 task.delay(perfectClapDelay/1000,function()
  if running and perfectClapEnabled then clapClick() end
 end)
end
local blockKeyDown=false
local function setBlock(state)
 if state==blockKeyDown then return end
 if not okVIM or not VIM then return end
 local ok=pcall(function()
  VIM:SendKeyEvent(state,Enum.KeyCode.F,false,game)
 end)
 if ok then blockKeyDown=state end
end
local function attackerNearby()
 local char=LP.Character
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root or not hum or hum.Health<=0 then return false end
 for _,player in ipairs(Players:GetPlayers()) do
  if player~=LP then
   local other=player.Character
   local otherHum=other and other:FindFirstChildOfClass("Humanoid")
   local otherRoot=other and other:FindFirstChild("HumanoidRootPart")
   if otherHum and otherHum.Health>0 and otherRoot then
    if (otherRoot.Position-root.Position).Magnitude<=blockRange then
     return true
    end
   end
  end
 end
 return false
end
connect(RS.Heartbeat,function()
 setBlock(running and autoBlockEnabled and not gui:GetAttribute("BlackflashChainV2Active") and not gui:GetAttribute("BlackflashChainV3Active") and not gui:GetAttribute("GojoQuickComboActive") and not gui:GetAttribute("MasterMacroActive") and not gui:GetAttribute("MasterDashActive") and attackerNearby())
end)
connect(LP.CharacterRemoving,function()
 setBlock(false)
end)


local Dash=(function()
 local current=nil;local nextReady=0;local api={}
 local function finish(job,reason)
  if job.done then return end
  if not job.released then
   job.released=true
   pcall(function() VIM:SendKeyEvent(false,job.side,false,game) end)
   pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Q,false,game) end)
  end
  if job.humanoid.Parent then job.humanoid:Move(Vector3.zero,false);job.humanoid.AutoRotate=job.oldRotate end
  pcall(function() job.camera.CameraType=job.cameraType end)
  job.done=true;job.error=reason
  if current==job then current=nil;gui:SetAttribute("MasterDashActive",false) end
  if reason then gui:SetAttribute("MasterLastError",reason) end
 end
 function api.start(side,valid)
  if current then return nil,"Another side dash owns inputs" end
  if os.clock()<nextReady then return nil,"Estimated side dash cooldown" end
  if not okVIM or not VIM then return nil,"Input simulation unavailable" end
  local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart");local camera=workspace.CurrentCamera
  if not h or not r or h.Health<=0 or not camera then return nil,"Character/camera unavailable" end
  local target,minimum=nil,math.huge
  for th in pairs(humanoids) do
   local model=th.Parent;local tr=model and model:FindFirstChild("HumanoidRootPart")
   if model and model:IsA("Model") and model~=c and model:IsDescendantOf(workspace) and tr and th.Health>0 then local d=(tr.Position-r.Position).Magnitude;if d<minimum then minimum=d;target={model=model,humanoid=th,root=tr} end end
  end
  if not target then return nil,"No living player or NPC" end
  side=side==Enum.KeyCode.A and Enum.KeyCode.A or Enum.KeyCode.D
  local job={side=side,target=target,character=c,humanoid=h,root=r,camera=camera,cameraType=camera.CameraType,oldRotate=h.AutoRotate,valid=valid,started=os.clock(),done=false,released=false}
  current=job;nextReady=job.started+2
  gui:SetAttribute("MasterDashActive",true);gui:SetAttribute("MasterLastAction","Side dash: "..side.Name)
  h.AutoRotate=false;camera.CameraType=Enum.CameraType.Scriptable
  local ok,err=pcall(function() VIM:SendKeyEvent(true,side,false,game);VIM:SendKeyEvent(true,Enum.KeyCode.Q,false,game) end)
  if not ok then finish(job,tostring(err));return nil,tostring(err) end
  sideTimer.start();return job
 end
 function api.await(job,valid)
  while not job.done do
   if valid then local ok,result=pcall(valid);if not ok or result~=true then finish(job,"Cancelled");break end end
   RS.Heartbeat:Wait()
  end
  if job.error then error(job.error,0) end
 end
 function api.cancel() if current then finish(current,"Cancelled") end end
 local name="MasterSharedDash"
 RS:BindToRenderStep(name,Enum.RenderPriority.Last.Value+100,function()
  local job=current;if not job then return end
  local ok,err=pcall(function()
   if not running or UIS:GetFocusedTextBox() or LP.Character~=job.character or workspace.CurrentCamera~=job.camera or not job.root.Parent or job.humanoid.Health<=0 or not job.target.model:IsDescendantOf(workspace) or not job.target.root.Parent or job.target.humanoid.Health<=0 then finish(job,"Dash lifecycle changed");return end
   if job.valid then local good,result=pcall(job.valid);if not good or result~=true then finish(job,"Cancelled");return end end
   local elapsed=os.clock()-job.started;local root,camera,tr=job.root,job.camera,job.target.root
   if elapsed<.300 then
    local away=Vector3.new(root.Position.X-tr.Position.X,0,root.Position.Z-tr.Position.Z);if away.Magnitude<.01 then away=Vector3.new(0,0,1) end;away=away.Unit
    local tangent=Vector3.new(away.Z,0,-away.X)*(job.side==Enum.KeyCode.D and 1 or -1)
    job.humanoid:Move(tangent,false)
    local aim=Vector3.new(tr.Position.X,root.Position.Y,tr.Position.Z);if (aim-root.Position).Magnitude>.01 then root.CFrame=CFrame.lookAt(root.Position,aim) end
    local cameraAim=tr.Position+Vector3.new(0,1,0);if (cameraAim-camera.CFrame.Position).Magnitude>.01 then camera.CFrame=CFrame.lookAt(camera.CFrame.Position,cameraAim) end
   else
    if not job.released then job.released=true;VIM:SendKeyEvent(false,job.side,false,game);VIM:SendKeyEvent(false,Enum.KeyCode.Q,false,game);job.humanoid:Move(Vector3.zero,false) end
    if not job.from then job.from=camera.CFrame.Rotation;job.to=CFrame.Angles(0,math.rad(job.side==Enum.KeyCode.D and -80 or 80),0)*job.from end
    local alpha=math.clamp((elapsed-.300)/.120,0,1);alpha=alpha*alpha*(3-2*alpha)
    camera.CFrame=CFrame.new(camera.CFrame.Position)*job.from:Lerp(job.to,alpha)
    if elapsed>=.500 then finish(job) end
   end
  end)
  if not ok then finish(job,tostring(err));REPORT("Master shared dash",err) end
 end)
 connect(UIS.WindowFocusReleased,api.cancel);connect(LP.CharacterRemoving,api.cancel)
 local function shutdown() api.cancel();RS:UnbindFromRenderStep(name) end
 connect(unload.Activated,shutdown);connect(gui.Destroying,shutdown)
 return api
end)()

-- Added combo only. K starts; K again cancels. Timings require in-game tuning.
;(function()
 local active=false
 local token=0
 local heldKey=nil
 local mouseHeld=false
 local panel=card(pages.Combos,"Crushing / Feverish Combo","K: play or cancel | M1 x3 > 1 > M1 x3 > Jump > wait 350 ms > 2 > Space + M1")
 local label=make("TextLabel",panel,{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="Ready - timings are untested",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3})
 local button=make("TextButton",panel,{Size=UDim2.new(1,0,0,30),BackgroundColor3=T.p2,Text="Play / Cancel Combo (K)",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=4}); corner(button,6)
 local timing={punchGap=.35,afterPunches=.20,afterOne=2.0,afterTwo=.750,jumpLead=.12,beforeTwoJumpDelay=.350}
 local function releaseCombo()
  if okVIM and VIM then
   if heldKey then pcall(function() VIM:SendKeyEvent(false,heldKey,false,game) end) end
   if mouseHeld then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
  end
  heldKey=nil; mouseHeld=false
 end
 local function cancel()
  token+=1; active=false; manualSequenceBusy=false; releaseCombo()
  if label.Parent then label.Text="Ready" end
 end
 local function toggleCombo()
  if active then cancel(); return end
  if busy or manualSequenceBusy then label.Text="Wait for the other macro to finish"; return end
  if not okVIM or not VIM then label.Text="Input simulation unavailable"; return end
  active=true; manualSequenceBusy=true; token+=1
  local id=token
  task.spawn(function()
   local function check()
    local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not running or token~=id or not h or h.Health<=0 then error("Combo cancelled",0) end
   end
   local function waitFor(seconds)
    local finish=os.clock()+seconds
    repeat check(); task.wait() until os.clock()>=finish
    check()
   end
   local function click()
    check(); mouseHeld=true
    VIM:SendMouseButtonEvent(0,0,0,true,game,0)
    waitFor(.035)
    VIM:SendMouseButtonEvent(0,0,0,false,game,0); mouseHeld=false
   end
   local function key(code)
    check(); heldKey=code; VIM:SendKeyEvent(true,code,false,game)
    waitFor(.035)
    VIM:SendKeyEvent(false,code,false,game); heldKey=nil
   end
   local function punches()
    for i=1,3 do click(); if i<3 then waitFor(timing.punchGap) end end
    waitFor(timing.afterPunches)
   end
   local ok,err=pcall(function()
    label.Text="Running combo"
    punches(); key(Enum.KeyCode.One); waitFor(timing.afterOne)
    punches(); key(Enum.KeyCode.Space); waitFor(timing.beforeTwoJumpDelay)
    key(Enum.KeyCode.Two); waitFor(timing.afterTwo)
    heldKey=Enum.KeyCode.Space; VIM:SendKeyEvent(true,heldKey,false,game)
    waitFor(timing.jumpLead); click()
    VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game); heldKey=nil
   end)
   if token==id then
    releaseCombo(); active=false; manualSequenceBusy=false
    if label.Parent then label.Text=ok and "Inputs sent - not a hit confirmation" or tostring(err) end
   end
  end)
 end
 connect(button.Activated,toggleCombo)
 connect(UIS.InputBegan,function(input,processed)
  if processed or UIS:GetFocusedTextBox() then return end
  if input.KeyCode==Enum.KeyCode.K then toggleCombo() end
 end)
 connect(LP.CharacterRemoving,cancel)
 connect(gui.Destroying,cancel)
 connect(unload.Activated,cancel)
end)()

-- Yuji Black Flash input sequence. Separate from existing macros.
;(function()
 local active=false
 local generation=0
 local held={}
 local mouseDown=false
 local side=Enum.KeyCode.D
 local secondTapDelay=.40
 local box=card(pages.Yuji,"Yuji Black Flash Setup","L: run/cancel | 2 punches > side + Q + 3 > camera flick > 3")
 box.LayoutOrder=6
 local feedback=make("TextLabel",box,{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Text="Nearest-target dash; fixed 300 ms / smooth 80-degree flick",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3})
 local function button(text,order)
  local b=make("TextButton",box,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text=text,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=11,LayoutOrder=order});corner(b,6);return b
 end
 local sideButton=button("Dash side: D (right)",4)
 connect(sideButton.Activated,function()
  side=side==Enum.KeyCode.D and Enum.KeyCode.A or Enum.KeyCode.D
  sideButton.Text=side==Enum.KeyCode.D and "Dash side: D (right)" or "Dash side: A (left)"
 end)
 local playButton=button("Run / Cancel (L)",6)
 local function releaseAll()
  for key in pairs(held) do
   pcall(function() VIM:SendKeyEvent(false,key,false,game) end)
  end
  held={}
  if mouseDown then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
  mouseDown=false
 end
 local function cancel()
  generation+=1;active=false;manualSequenceBusy=false;releaseAll()
  if feedback.Parent then feedback.Text="Cancelled / ready" end
 end
 local function start()
  if active then cancel();return end
  if busy or manualSequenceBusy then feedback.Text="Wait for the existing macro to finish";return end
  if not okVIM or not VIM then feedback.Text="Input simulation unavailable";return end
  active=true;manualSequenceBusy=true;generation+=1
  local id=generation
  local chosenSide=side
  task.spawn(function()
   local function check()
    local char=LP.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if generation~=id or not running or not hum or hum.Health<=0 then error("Cancelled",0) end
   end
   local function waitFor(seconds)
    local untilTime=os.clock()+seconds
    repeat check();task.wait() until os.clock()>=untilTime
    check()
   end
   local function key(code,down)
    check()
    if down then held[code]=true end
    VIM:SendKeyEvent(down,code,false,game)
    if not down then held[code]=nil end
   end
   local function punch()
    check();mouseDown=true
    VIM:SendMouseButtonEvent(0,0,0,true,game,0)
    waitFor(.035)
    VIM:SendMouseButtonEvent(0,0,0,false,game,0);mouseDown=false
   end
   local ok,err=pcall(function()
    feedback.Text="Running - manually position near your opponent first"
    punch();waitFor(.35);punch();waitFor(.20)
    local started=os.clock()
    local dashJob,why=Dash.start(chosenSide,function() return generation==id and active end)
    if not dashJob then error(why,0) end
    key(Enum.KeyCode.Three,true);waitFor(.035);key(Enum.KeyCode.Three,false)
    local remaining=secondTapDelay-(os.clock()-started)
    if remaining>0 then waitFor(remaining) end
    key(Enum.KeyCode.Three,true);waitFor(.035);key(Enum.KeyCode.Three,false)
    Dash.await(dashJob,function() return generation==id and active end)
   end)
   if generation==id then
    releaseAll();active=false;manualSequenceBusy=false
    if feedback.Parent then feedback.Text=ok and "Inputs sent - no hit or cooldown reset confirmed" or tostring(err) end
   end
  end)
 end
 connect(playButton.Activated,start)
 connect(UIS.InputBegan,function(input,processed)
  if processed or UIS:GetFocusedTextBox() then return end
  if input.KeyCode==Enum.KeyCode.L then start() end
 end)
 connect(LP.CharacterRemoving,cancel)
 connect(gui.Destroying,cancel)
 connect(unload.Activated,cancel)
end)()

-- Follow Behind: immediate clear-route movement; pathfinding, auto jumps, named picker.
;(function()
 local PFS=game:GetService("PathfindingService")
 local on,dashes,autoJump=false,true,true;local chosen,target=nil,nil;local direction=Vector3.zero
 local owned,oldRotate,face=nil,nil,nil;local route,blocked=nil,nil;local points,index={},2;local planned=nil
 local computing=false;local epoch=0;local sprintDown,sending=false,false;local held,physical={},{};local dashTicket=0
 local pauseUntil,frontReady,quickReady=0,0,0;local paused=false;local jumpingIndex=nil;local jumpStarted,jumpAir=0,false
 local FRONT_DISTANCE,QUICKSTEP_DISTANCE=25,17.5
 local movement={[Enum.KeyCode.W]=true,[Enum.KeyCode.A]=true,[Enum.KeyCode.S]=true,[Enum.KeyCode.D]=true}
 local box=card(pages.Movement,"Follow Behind - Automatic Path Jumps","Direct clear-route movement | airborne sprint/dashes | front 25 / side-back 17.5")
 local picked=make("TextLabel",box,{Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,Text="Target: nearest player",TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3})
 local search=make("TextBox",box,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text="",PlaceholderText="Search username / display name",ClearTextOnFocus=false,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=4});corner(search,6)
 local list=make("ScrollingFrame",box,{Size=UDim2.new(1,0,0,130),BackgroundColor3=T.p2,BorderSizePixel=0,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=3,LayoutOrder=5});make("UIListLayout",list,{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder})
 local info=make("TextLabel",box,{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Text="Off",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=6});ord[box]=6
 local function rig() local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart");if h and r and h.Health>0 then return h,r end end
 local function flat(v) return Vector3.new(v.X,0,v.Z) end
 local function send(k,v) if not okVIM or not VIM then return false end;sending=true;local ok=pcall(function() VIM:SendKeyEvent(v,k,false,game) end);sending=false;return ok end
 local function sprint(v)
  if sprintDown==v then return end;sprintDown=v;if not v then send(Enum.KeyCode.W,false);return end
  local a=send(Enum.KeyCode.W,true);local b=send(Enum.KeyCode.W,false);local c=send(Enum.KeyCode.W,true);if not(a and b and c) then send(Enum.KeyCode.W,false);sprintDown=false end
 end
 local function releaseDash() dashTicket+=1;for k in pairs(held) do send(k,false) end;held={} end
 local function restore() if owned and owned.Parent then owned.AutoRotate=oldRotate end;owned=nil;face=nil end
 local function clear() if blocked then blocked:Disconnect();blocked=nil end;if route then route:Destroy();route=nil end;points={};index=2;planned=nil;jumpingIndex=nil end
 local function invalidate() epoch+=1;computing=false;clear() end
 local function halt() sprint(false);direction=Vector3.zero;local h=rig();if h then h:Move(Vector3.zero,false) end end
 local function reset() invalidate();releaseDash();halt();restore();target=nil end
 local function interrupted()
  if busy or todoBusy or manualSequenceBusy or UIS:GetFocusedTextBox() then return true end
  for k in pairs(physical) do if movement[k] then return true end end
  return not sprintDown and not held[Enum.KeyCode.W] and UIS:IsKeyDown(Enum.KeyCode.W)
 end
 connect(UIS.InputBegan,function(i) local k=i.KeyCode;if sending or held[k] or(k==Enum.KeyCode.W and sprintDown) then return end;if movement[k] then physical[k]=true end;if on and k==Enum.KeyCode.Q and not UIS:GetFocusedTextBox() then pauseUntil=os.clock()+.75 end end)
 connect(UIS.InputEnded,function(i) local k=i.KeyCode;if sending or held[k] or(k==Enum.KeyCode.W and sprintDown) then return end;physical[k]=nil end)
 connect(UIS.WindowFocusReleased,function() physical={};sprint(false);releaseDash();pauseUntil=os.clock()+.5 end)
 local rows={}
 local function filter() local q=search.Text:lower();for _,e in ipairs(rows) do e.b.Visible=q=="" or e.text:find(q,1,true)~=nil end end
 local function rebuild()
  for _,e in ipairs(rows) do e.c:Disconnect();e.b:Destroy() end;rows={}
  local function row(text,n,id) local b=make("TextButton",list,{Size=UDim2.new(1,0,0,26),BackgroundColor3=T.p2,Text=text,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=n});corner(b,5);local c=b.Activated:Connect(function() chosen=id;reset();picked.Text="Target: "..text end);table.insert(rows,{b=b,c=c,text=text:lower()}) end
  row("Nearest player (automatic)",0,nil);local ps=Players:GetPlayers();table.sort(ps,function(a,b) return a.Name:lower()<b.Name:lower() end);for i,p in ipairs(ps) do if p~=LP then row(p.DisplayName.." (@"..p.Name..")",i,p.UserId) end end;filter()
 end
 connect(search:GetPropertyChangedSignal("Text"),filter);connect(Players.PlayerAdded,rebuild);connect(Players.PlayerRemoving,function(p) if p==target then reset() end;task.defer(function() if running and gui.Parent then rebuild() end end) end);rebuild()
 toggle(box,"Follow Behind + Sprint",function() return on end,function(v) on=v;reset();info.Text=v and "Finding target..." or "Off" end)
 toggle(box,"Automatic Pathfinding Jumps",function() return autoJump end,function(v) autoJump=v;invalidate() end)
 toggle(box,"Use Front / Side / Back Dashes",function() return dashes end,function(v) dashes=v;if not v then releaseDash() end end)
 local function paramsFor(tc) local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude;p.FilterDescendantsInstances={LP.Character,tc};p.RespectCanCollide=true;return p end
 local function clearDirectRoute(r,goal,tc)
  local delta=flat(goal-r.Position);if delta.Magnitude<.05 or math.abs(goal.Y-r.Position.Y)>3 then return false end
  local p=paramsFor(tc);local side=Vector3.new(-delta.Z,0,delta.X).Unit*1.5
  for _,shift in ipairs({Vector3.zero,side,-side,Vector3.new(0,-1.5,0)}) do if workspace:Raycast(r.Position+shift,delta,p) then return false end end

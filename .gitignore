  disconnectFight();detachEvidence();evidenceTracks={};lastPairAt=-math.huge;invalidateCaches();active=true;busy=true;manualSequenceBusy=true;generation+=1;nextDash=0;strafeKey=Enum.KeyCode.D;sideChoiceUntil=0;flickUntil=0;smoothMove=Vector3.zero;needPostJumpBackoff=false;pairInFlight=false;startArmed=false
  gui:SetAttribute("BlackflashChainV2Active",true);gui:SetAttribute("BlackflashChainV3Active",runVersion==3);local id=generation
  task.spawn(function()
   local completed,cyclesFinished=0,0;local targetModel=nil;local mixupUsed=false;local recoveryJumpActive=false
   local pendingHit=false;local hitReadyAt=0;local failedSideAttempts=0;local nextFallbackJump=0
   local progressPos=nil;local progressAt=os.clock();local yielded=0;local nextAttemptAt=0;local rejected=0
   local function beat() yielded+=1;RS.Heartbeat:Wait() end

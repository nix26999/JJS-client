    if os.clock()>deadline then moveGoal=nil;error("jump-behind timed out",0) end;RS.Heartbeat:Wait()
   until false
  end
  local function bf(token)
   moveGoal=nil;hum:Move(Vector3.zero,false);info.Text="Waiting for Black Flash readiness"
   waitFor(token,cfg.CloseTimeout/1000,function() return ready(token,"BlackflashStart") end)

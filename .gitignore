connect(shutdown.Event,unload);connect(close.Activated,unload);connect(unloadButton.Activated,unload);connect(gui.Destroying,cleanup)
selectPage=function(name,clear) if not pages[name] then return end;selected=name;if clear then search.Text="" end;if filter then filter() end end
filter=function()
 local q=string.lower(search.Text):match("^%s*(.-)%s*$");local matches={};local any=false
 for _,cat in ipairs(cats) do local name=cat[1];local category=q~="" and (string.find(string.lower(name),q,1,true) or string.find(string.lower(cat[2]),q,1,true));local found=not not category
  for item,s in pairs(sections) do if s.page==name then local match=q=="" or category or string.find(s.query,q,1,true);item.Visible=not not match;if match then found=true end end end
  matches[name]=found;if found then any=true end

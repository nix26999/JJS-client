 -- Exact half-space fraction for an oriented rectangular part box, not a mesh hitbox.
 local function partRearFraction(part,origin,normal)
  local size=part.Size;local cf=part.CFrame;local center=normal:Dot(cf.Position-origin)
  local widths={};for _,w in ipairs({math.abs(normal:Dot(cf.RightVector))*size.X,math.abs(normal:Dot(cf.UpVector))*size.Y,math.abs(normal:Dot(cf.LookVector))*size.Z}) do if w>1e-4 then table.insert(widths,w) end end
  local n=#widths;local span=0;for _,w in ipairs(widths) do span+=w*.5 end
  if center>=span then return 0 end;if center<=-span then return 1 end;if n==0 then return 0 end
  local t=span-center;local total=0;local denom=n==3 and 6 or n==2 and 2 or 1
  for _,w in ipairs(widths) do denom*=w end
  for mask=0,2^n-1 do local shift,sign=0,1;for i=1,n do if bit32.band(mask,bit32.lshift(1,i-1))~=0 then shift+=widths[i];sign=-sign end end;total+=sign*math.max(t-shift,0)^n end

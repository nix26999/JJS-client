 end
 stopForDefeat=function(reason) if not active then return end;local name=fightModel and fightModel.Name or "target";stop("V2 stopped: "..name.." "..(reason or "defeated")..". Press 3 for a new run.");suppressStartUntil=os.clock()+.15;if bindCapture then bindCapture() end end
 local function ensureFightAlive()
  if not active then return false end

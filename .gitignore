   local function steerOver(tr)
    local h,r=rig();if not h or not tr then return end;local d=spacing(tr)
    if d and d>CATCHUP_DISTANCE then local v=flat(tr.Position-r.Position);move("catchup",v.Magnitude>.01 and v.Unit or Vector3.zero) else local look=flat(tr.CFrame.LookVector);if look.Magnitude>.01 then local v=flat(tr.Position-look.Unit*4-r.Position);move("jumpOver",v.Magnitude>.05 and v.Unit or Vector3.zero) end end
   end
   local function jumpOverTarget()
    check();local model=targetModel;local _,tr=updateTarget();local h,r=rig();if not tr or not h or h.FloorMaterial==Enum.Material.Air or(r.Position-tr.Position).Magnitude>JUMP_OVER_MAX or os.clock()<nextFallbackJump then return false end
    nextFallbackJump=os.clock()+1.25;releasePositioning();say("V2: last-resort jump - sides blocked/stuck");local began=os.clock();local airborne=false;steerOver(tr);tapJump();recoveryJumpActive=true
    repeat check();local _,t=updateTarget();local hum=rig();if not t or model~=targetModel or not hum then releasePositioning();return false end
     if hum.FloorMaterial==Enum.Material.Air then airborne=true end;steerOver(t)
     if os.clock()-began>=.12 and rearSide(t,true) and attackReady(t) then markJumpBehind();return true end
     if not airborne and os.clock()-began>.35 then break end;if airborne and hum.FloorMaterial~=Enum.Material.Air and os.clock()-began>.2 then break end;beat()
    until os.clock()-began>=2.5
    local _,t=updateTarget();if airborne and rearSide(t,true) then markJumpBehind() else recoveryJumpActive=false;releasePositioning() end;failedSideAttempts=0;progressPos=nil;return false
   end
   local function recover(tr)
    check();key(Enum.KeyCode.Q,false);local d,offset,hum,r=spacing(tr);if not d then releasePositioning();beat();return end
    if(r.Position-tr.Position).Magnitude>JUMP_OVER_MAX then local height=math.abs(r.Position.Y-tr.Position.Y)
     if height>JUMP_OVER_MAX or offset.Magnitude<.05 then releasePositioning() else jumpApproachGoal=math.min(4.5,math.max(0,math.sqrt(math.max(0,36-height*height))-.15));move("jumpApproach",-offset.Unit) end;beat();return
    end
    if hum.FloorMaterial~=Enum.Material.Air then jumpOverTarget();beat() else recoveryJumpActive=true;steerOver(tr);beat() end
   end
   local function frontBackdash(tr,away)
    check();local d,_,h,r=spacing(tr);if not d or not frontSide(tr) or actualRange(tr)>ATTACK_MAX then return false end
    local model=targetModel;releasePositioning();mixupUsed=true;recoveryJumpActive=false;needPostJumpBackoff=false;previousLockOn=lockOn;borrowedLock=true;lockOn=false;lockSuppressed=true;flickUntil=0;flickRotation=nil;mixFacing=away;phase="turnAway"
    r.CFrame=CFrame.lookAt(r.Position,r.Position+away);local cam=workspace.CurrentCamera;if cam then cam.CFrame=CFrame.lookAt(cam.CFrame.Position,cam.CFrame.Position+away) end
    waitFor(.05);local _,t=updateTarget();if model~=targetModel or not frontSide(t) then releasePositioning();restoreLock();return false end
    move("backMixup",-away);waitFor(.035);local _,beforeQ=updateTarget();if model~=targetModel or not frontSide(beforeQ) then releasePositioning();restoreLock();return false end
    key(Enum.KeyCode.Q,true);waitFor(.035);key(Enum.KeyCode.Q,false);waitFor(.215);releasePositioning();restoreLock();flickUntil=0
    say("V2: S+Q movement complete - body still must be >=75% behind");return model==targetModel
   end
   local function attackStep()
    releasePositioning();failedSideAttempts=0;progressPos=nil
    if pendingHit then
     if os.clock()<hitReadyAt or animationBusy() then say("V2: waiting for finishing LMB / action recovery");beat();return end
     if clickLMB() then pendingHit=false;if runVersion==3 then cyclesFinished+=1;completed=0;resetRoute();say("V3: cycle complete - repeating on same target") else stop("V2 finished: 4 observed-activation input pairs + LMB. BF hits not verified.");bindCapture() end end;return
    end
    if os.clock()<nextAttemptAt or animationBusy() then beat();return end
    say("V2: BF input pair "..(completed+1).."/"..CFG.Repeats.." | >=75% body behind")
    if inputPair() then completed+=1
     if completed>=CFG.Repeats then pendingHit=true;hitReadyAt=os.clock()+(runVersion==3 and CFG.CycleWait/1000 or 0) else resetRoute() end
    end
   end
   local function positionWithSides(tr,d,away,h,r,jammed)
    local right=navigationRight(away);local dir=useSide(r,tr,right);local walk=walkingSide(r,tr,right)
    if jammed and failedSideAttempts>=2 then recover(tr);return end
    if d<SIDE_MIN then if not objectInRoute(r,tr,away,2) then move("sideSetup",away);beat() elseif walk then orbit(tr,walk) else recover(tr) end
    elseif dir and os.clock()>=nextDash then local success,attempted=sideDash(r,tr,dir);if success then failedSideAttempts=0 elseif attempted then failedSideAttempts+=1;strafeKey=strafeKey==Enum.KeyCode.A and Enum.KeyCode.D or Enum.KeyCode.A;sideChoiceUntil=os.clock()+.7 end
    elseif walk then orbit(tr,walk) else recover(tr) end
   end
   local function step()
    check();local p,tr=updateTarget();if not tr then releasePositioning();beat();return end;local d,offset,h,r=spacing(tr);local away=offset.Magnitude>.01 and offset.Unit or Vector3.new(0,0,1)
    if not progressPos or(r.Position-progressPos).Magnitude>.5 or phase=="idle" then progressPos=r.Position;progressAt=os.clock() end;local jammed=os.clock()-progressAt>.85 and steering.Magnitude>.2
    if recoveryJumpActive and rearSide(tr,true) and actualRange(tr)<=ATTACK_MAX then markJumpBehind() end
    if needPostJumpBackoff then if d<POST_JUMP_MIN then move("postJumpBackoff",away);beat();return else needPostJumpBackoff=false;releasePositioning() end end
    if d>CATCHUP_DISTANCE then move("catchup",-away);beat()
    elseif not pendingHit and turnaroundMixups and not mixupUsed and frontSide(tr) and actualRange(tr)<=ATTACK_MAX and h.FloorMaterial~=Enum.Material.Air and math.random(1,3)==1 then frontBackdash(tr,away)
    elseif rearSide(tr) then
     if actualRange(tr)>ATTACK_MAX then if math.abs(r.Position.Y-tr.Position.Y)>ATTACK_MAX then releasePositioning();beat() else move("attackApproach",-away);beat() end
     elseif attackReady(tr) then attackStep() else releasePositioning();beat() end
    elseif recoveryJumpActive and h.FloorMaterial==Enum.Material.Air then steerOver(tr);beat()
    else recoveryJumpActive=false;positionWithSides(tr,d,away,h,r,jammed) end
   end
   local ok,err=pcall(function()
    while active and generation==id do valid();local beforeYield=yielded
     if typing() then pauseTyping();repeat valid();beat() until not typing();bindCapture() else local success,problem=pcall(step);if not success then if problem==TYPING then pauseTyping() else error(problem,0) end end end
     if active and generation==id and yielded==beforeYield then beat() end
    end
   end)
   if generation==id then stop(ok and "Chain stopped" or tostring(err));bindCapture() end
  end)
 end
 -- The legacy InputBegan bridge only arms; CAS/InputEnded starts after physical release.
 blackflashV2Trigger=function() if not(enabledV2 or enabledV3) then return false end;if not active and not typing() and os.clock()>=suppressStartUntil then startArmed=true end;return true end
 connect(UIS.InputEnded,function(i) if i.KeyCode==Enum.KeyCode.Three and startArmed and not active and not pairInFlight and not typing() then startArmed=false;start() end end)
 toggle(box,"Blackflash Chain V2",function() return enabledV2 end,function(v) enabledV2=v;if not v and active and runVersion==2 then stop("V2 off") end;feedback.Text=v and "V2 ready - press AND release 3" or "V2 off";bindCapture() end)

 toggle(box3,"Blackflash Chain V3",
  function() return enabledV3 end,
  function(v)
   enabledV3=v
   if not v and active and runVersion==3 then stop("V3 off") end
   feedback3.Text=v and "V3 ready - press AND release 3; 4 pairs per cycle" or "V3 off"
   bindCapture()
  end
 )
 toggle(box,"Include NPCs (shared V2/V3)",
  function() return includeNPCsV2 end,
  function(v)
   includeNPCsV2=v;targetRoot=nil;invalidateCaches()
   if not v and active and runVersion==3 and fightModel and not Players:GetPlayerFromCharacter(fightModel) then
    stop("V3 stopped: NPC targeting disabled. Press/release 3 again.")
   end
   bindCapture()
  end
 )
 toggle(box,"Front-only turnaround S + Q movement",function() return turnaroundMixups end,function(v) turnaroundMixups=v end)
 make("TextLabel",box,{
  Size=UDim2.new(1,0,0,164),BackgroundTransparency=1,
  Text=table.concat({"4 input pairs per cycle. Black Flash inputs require >=75% ","of estimated character body-box volume behind the target ","and actual root distance <=7 studs. Accessories are excluded. ","Press AND release 3 to start. Each pair releases movement ","and temporarily unbinds this module's 3-key capture. ","Second 3 is scheduled 400 ms after the first key-down ","and gets a fresh body/range check. ","Animation or health-change evidence is required to count ","a pair, but does not confirm a Black Flash hit. ","S+Q movement never bypasses the body gate."}),
  TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=10,LayoutOrder=nextOrder(box)+2
 })
 make("TextLabel",box3,{
  Size=UDim2.new(1,0,0,116),BackgroundTransparency=1,
  Text=table.concat({"V3: 4 evidence-observed input pairs, wait at least 300 ms, ","then a body/range-checked LMB. Repeat against the same ","target until death, despawn, or off. ","Finishing LMB remains queued until positioning and ","action-recovery checks pass. ","Death/despawn releases inputs and requires a new ","press/release of 3. V3 takes priority if both enabled."}),
  TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=10,LayoutOrder=nextOrder(box3)+2
 })
 toggle(calcBox,"Route Calculator / Auto Side",function() return calculatorEnabled end,function(v) calculatorEnabled=v;routeCache=nil end)
 toggle(calcBox,"Auto camera angle (override fixed 90)",function() return autoCameraAngle end,function(v) autoCameraAngle=v end)
 make("TextLabel",calcBox,{
  Size=UDim2.new(1,0,0,104),BackgroundTransparency=1,
  Text=table.concat({"Side dashes take priority. Walk/orbit during Q cooldown ","instead of immediately jumping. Jump-over is a last resort ","for blocked side routes or repeated failed dashes while stuck; ","takeoff requires <=6 actual studs. ","Fixed repeat gap: 345 ms; default camera turn: 90 degrees; ","camera hold: 200 ms. Route times and body percentages ","are estimates, not server hit confirmation."}),
  TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=10,LayoutOrder=nextOrder(calcBox)+2
 })
 local lastCalc=-math.huge
 connect(RS.Heartbeat,function()
  if not running or not gui.Parent then return end
  if active and not ensureFightAlive() then return end
  local now=os.clock();if now-lastCalc<.25 then return end;lastCalc=now
  local p,tr=closest();local d,offset=spacing(tr);local text
  if not p or not tr or not d then text="No live target"
  else
   local fraction=bodyBehindFraction(tr,false);local distance=actualRange(tr)
   local lines={"Target: "..p.DisplayName,string.format("Estimated body behind: %.1f%% / required %.0f%%",fraction*100,CFG.BodyBehind*100),string.format("Actual root distance: %.2f / %d studs",distance,ATTACK_MAX)}
   if not calculatorEnabled then table.insert(lines,"Calculator off - direct D/A selection")
   elseif d<.05 then table.insert(lines,"Too close for an orbit estimate")
   else
    local plan=calculateRoute(tr,navigationRight(offset.Unit))
    if plan then
     local function routeLine(route)
      if route.Blocked then return string.format("%.1f deg / %.1f studs / blocked",route.Degrees,route.Distance) end
      return string.format("%.1f deg / %.1f studs / ~%.2f s",route.Degrees,route.Distance,route.Time)
     end
     table.insert(lines,"Left: "..routeLine(plan.Left));table.insert(lines,"Right: "..routeLine(plan.Right))
     local side=plan.Side==Enum.KeyCode.A and "A" or plan.Side==Enum.KeyCode.D and "D" or "walk / last-resort recovery"
     table.insert(lines,"Estimated clear side: "..side)
    else table.insert(lines,"Unable to estimate orbit") end
   end
   text=table.concat(lines,string.char(10))
  end
  if calcStatus.Text~=text then calcStatus.Text=text end
 end)
 RS:BindToRenderStep(cameraBind,Enum.RenderPriority.Camera.Value+2,function(dt)
  if not active or typing() or not ensureFightAlive() then return end
  -- Keep the camera on the pair's target during its windup.
  if not pairInFlight then local p,tr=closest();watchFight(p);if not active then return end;targetRoot=tr end
  enforcePriority();local cam=workspace.CurrentCamera;if not cam then return end
  local tr=targetRoot;local desired=nil;local alpha=1-math.exp(-14*dt)
  if lockSuppressed and mixFacing.Magnitude>.01 then desired=CFrame.lookAt(cam.CFrame.Position,cam.CFrame.Position+mixFacing).Rotation
  elseif os.clock()<flickUntil and flickRotation and flickFrom then
   local t=math.clamp((os.clock()-flickStarted)/.12,0,1);local eased=t*t*(3-2*t)
   cam.CFrame=CFrame.new(cam.CFrame.Position)*flickFrom:Lerp(flickRotation,eased);return
  elseif tr and tr.Parent then
   local aim=tr.Position+Vector3.new(0,1,0)
   if(aim-cam.CFrame.Position).Magnitude>.05 then desired=CFrame.lookAt(cam.CFrame.Position,aim).Rotation end
  end
  if desired then cam.CFrame=CFrame.new(cam.CFrame.Position)*cam.CFrame.Rotation:Lerp(desired,alpha) end
 end)
 RS:BindToRenderStep(faceBind,Enum.RenderPriority.Character.Value+7,function(dt)
  if not active or typing() or not ensureFightAlive() or not targetRoot or not targetRoot.Parent then return end
  enforcePriority();local d,offset,h,r=spacing(targetRoot);if not d then return end
  if owned~=h then restoreFacing();owned=h;oldRotate=h.AutoRotate end;h.AutoRotate=false
  local vector=steering;local remaining=nil
  if pairInFlight then vector=Vector3.zero;smoothMove=Vector3.zero
  elseif phase=="postJumpBackoff" then remaining=math.max(0,POST_JUMP_AIM-d)
  elseif phase=="catchup" then remaining=math.max(0,d-CATCHUP_DISTANCE)
  elseif phase=="attackApproach" then remaining=math.max(0,d-4)
  elseif phase=="sideSetup" then remaining=math.max(0,SIDE_SETUP_AIM-d)
  elseif phase=="jumpApproach" then remaining=math.max(0,d-jumpApproachGoal)
  elseif phase=="jumpOver" then
   local look=flat(targetRoot.CFrame.LookVector)
   if look.Magnitude>.01 then local delta=flat(targetRoot.Position-look.Unit*4-r.Position);remaining=delta.Magnitude;vector=delta.Magnitude>.05 and delta.Unit or Vector3.zero end
  end
  if remaining then
   local travel=math.max(h.WalkSpeed*math.max(dt,1/240),.01);vector=vector*math.clamp(remaining/travel,0,1)
   if remaining<=.05 and phase~="jumpOver" then releasePositioning();vector=Vector3.zero end
  end
  if pairInFlight or phase=="idle" then smoothMove=Vector3.zero else smoothMove=smoothMove:Lerp(vector,1-math.exp(-18*dt)) end
  if remaining and smoothMove.Magnitude>vector.Magnitude and smoothMove.Magnitude>.001 then smoothMove=smoothMove.Unit*vector.Magnitude end
  h:Move(smoothMove,false)
  local aim=lockSuppressed and(r.Position+mixFacing) or Vector3.new(targetRoot.Position.X,r.Position.Y,targetRoot.Position.Z)
  if(aim-r.Position).Magnitude>.05 then local desired=CFrame.lookAt(r.Position,aim).Rotation;r.CFrame=CFrame.new(r.Position)*r.CFrame.Rotation:Lerp(desired,1-math.exp(-18*dt)) end
 end)
 connect(LP.CharacterRemoving,function() stop("Your character removed. Press/release 3 again.");bindCapture() end)
 connect(UIS.WindowFocusReleased,function() startArmed=false;if active then stop("Window lost focus. Press/release 3 again.");bindCapture() end end)
 local function shutdown()
  enabledV2=false;enabledV3=false;startArmed=false;CAS:UnbindAction(action);stop("Off");blackflashV2Trigger=nil
  RS:UnbindFromRenderStep(cameraBind);RS:UnbindFromRenderStep(faceBind)
 end
 connect(unload.Activated,shutdown);connect(gui.Destroying,shutdown);bindCapture()
end
local function cleanup()
 if not running then return end
 running=false; enabled=false; todoEnabled=false; autoBlockEnabled=false; perfectClapEnabled=false; rmbJumpEnabled=false; pullEnabled=false; lockOn=false; chainEnabled=false; release()
 if blockKeyDown then setBlock(false) end
 RS:UnbindFromRenderStep(bind)
 for _,conn in ipairs(conns) do conn:Disconnect() end
 if gui.Parent then gui:Destroy() end
end
connect(gui.Destroying,cleanup)
connect(unload.Activated,cleanup)
connect(close.Activated,function() main.Visible=false end)
connect(UIS.InputBegan,function(i)
 if UIS:GetFocusedTextBox() then return end
 if i.KeyCode==Enum.KeyCode.RightShift then main.Visible=not main.Visible end
 if i.KeyCode==Enum.KeyCode.R and perfectClapEnabled then
  task.spawn(runPerfectClap)
 end
 if i.UserInputType==Enum.UserInputType.MouseButton1 and rmbJumpEnabled and not busy and not todoBusy then
  local now=os.clock()
  if now-rmbLastClick>0.6 then rmbClicks=0 end
  rmbLastClick=now
  rmbClicks+=1
  if rmbClicks>=3 then
   rmbClicks=0
   local char=LP.Character
   local hum=char and char:FindFirstChildOfClass("Humanoid")
   if hum and hum.Health>0 then hum.Jump=true end
  end
 end
 if i.KeyCode==Enum.KeyCode.Three and blackflashV2Trigger and blackflashV2Trigger() then return end
 if i.KeyCode==Enum.KeyCode.Three and not busy then
  local now=os.clock()
  lastThreeTime=now
  if todoEnabled then task.spawn(runTodo); return end
  task.spawn(run)
  if chainEnabled and now>=chainCooldownUntil then task.spawn(runChain) end
 end
end)
local dragging,start,pos,touch
connect(top.InputBegan,function(i)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true; start=i.Position; pos=main.Position; touch=i end
end)
connect(UIS.InputEnded,function(i) if i==touch then dragging=false end end)
connect(UIS.InputChanged,function(i)
 if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i==touch) then local d=i.Position-start; main.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y) end
end)
connect(RS.Heartbeat,function()
 local cam=workspace.CurrentCamera
 if cam then scale.Scale=math.min(1,math.max(.25,math.min((cam.ViewportSize.X-24)/760,(cam.ViewportSize.Y-64)/540))) end
end)
status.Text="Default: 325 ms | Dash 6s | Side Dash 2s"

do
 local holder=make("Frame",gui,{Name="SideNotifications",AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-16,.5,0),Size=UDim2.new(0,300,.8,0),BackgroundTransparency=1})
 make("UIListLayout",holder,{Padding=UDim.new(0,8),VerticalAlignment=Enum.VerticalAlignment.Center,SortOrder=Enum.SortOrder.LayoutOrder})
 local alive=true;local count=0;local cards,links,recent={},{},{};local watched=setmetatable({},{__mode="k"})
 local function listen(s,f) local c=s:Connect(f);table.insert(links,c) end
 local function notice(title,text,color)
  if not alive then return end;local key=title..text;local now=os.clock();if recent[key] and now-recent[key]<1.5 then return end;recent[key]=now
  while #cards>=5 do table.remove(cards,1):Destroy() end;count+=1
  local f=make("Frame",holder,{Size=UDim2.fromOffset(300,74),BackgroundColor3=T.card,BorderSizePixel=0,LayoutOrder=count});corner(f,8);make("UIStroke",f,{Color=color,Transparency=.3})
  make("TextLabel",f,{BackgroundTransparency=1,Position=UDim2.fromOffset(12,8),Size=UDim2.new(1,-24,0,18),Text=title,TextColor3=color,Font=Enum.Font.GothamBold,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
  make("TextLabel",f,{BackgroundTransparency=1,Position=UDim2.fromOffset(12,29),Size=UDim2.new(1,-24,0,36),Text=text,TextWrapped=true,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left});table.insert(cards,f)
  task.delay(3.5,function() if not alive then return end;local i=table.find(cards,f);if i then table.remove(cards,i) end;f:Destroy() end)
 end
 local function hook(o)
  if watched[o] or o:IsDescendantOf(holder) then return end;watched[o]=true
  if o:IsA("TextButton") and o.Text=="" then
   local label=o:FindFirstChildWhichIsA("TextLabel");local track=nil
   for _,child in ipairs(o:GetChildren()) do if child:IsA("Frame") and child.Size==UDim2.fromOffset(36,18) then track=child;break end end
   if label and track then listen(track:GetPropertyChangedSignal("BackgroundColor3"),function() local c=track.BackgroundColor3;local on=math.abs(c.R-T.acc.R)+math.abs(c.G-T.acc.G)+math.abs(c.B-T.acc.B)<.03;notice(on and "Enabled" or "Disabled",label.Text,on and T.ok or T.warn) end) end
  elseif o:IsA("TextLabel") then
   local last=o.Text;listen(o:GetPropertyChangedSignal("Text"),function()
    local text=o.Text;if text==last then return end;last=text;local s=text:lower()
    local err=s:find("failed",1,true) or s:find("unavailable",1,true) or s:find("error",1,true)
    local event=s:find("finished",1,true) or s:find("inputs sent",1,true) or s:find("cancelled",1,true) or s:find("playing:",1,true)
    if err or event then notice(err and "Notice" or "Activity",text,err and T.warn or T.acc) end
   end)
  end
 end
 for _,o in ipairs(gui:GetDescendants()) do hook(o) end
 listen(gui.DescendantAdded,function(o) task.defer(function() if alive and o.Parent then hook(o) end end) end)
 listen(gui.Destroying,function() alive=false;for _,c in ipairs(links) do c:Disconnect() end end)
 notice("Ready","V2/V3 merged: >=75% body behind, <=7 studs; press/release 3; 400 ms follow-up.",T.acc)
end

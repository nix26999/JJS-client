toggle(impactCard,"Kill Finisher (16 frames / 14 FPS)",function() return impactFramesEnabled end,function(v) impactFramesEnabled=v;if not v then cancelImpact() end end)
toggle(impactCard,"Allow ESTIMATED lethal triggers",function() return confirmationMode=="EstimatedLethal" end,function(v) confirmationMode=v and "EstimatedLethal" or "ConfirmedOnly";gui:SetAttribute("KillFinisherConfirmationMode",confirmationMode);pendingBlackflash=nil;cancelImpact();updateFinisherStatus() end)

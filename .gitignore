 if cat[3]~=lastGroup then lastGroup=cat[3];local t=text(side,lastGroup,nil,UDim2.new(1,0,0,18),9);t.LayoutOrder=i*10-1;t.TextColor3=T.mut end
 local b=make("TextButton",side,{Text=name,Size=UDim2.new(1,0,0,30),LayoutOrder=i*10,BackgroundColor3=T.p2,BackgroundTransparency=i==1 and 0 or 1,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12});corner(b);buttons[name]=b
 local p=make("ScrollingFrame",content,{Name=name,Position=UDim2.fromOffset(0,96),Size=UDim2.new(1,0,1,-96),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),Visible=i==1});pages[name]=p
 make("UIPadding",p,{PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,16)});make("UIListLayout",p,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder})

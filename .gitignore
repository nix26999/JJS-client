updateFinisherStatus()
local function bindConfirmedRemote(object)
 if not object or object.Name~=CONFIRMED_REMOTE_NAME or not object:IsA("RemoteEvent") then return end
 if confirmedRemote==object then return end
 if confirmedConnection then confirmedConnection:Disconnect() end
 confirmedRemote=object;lastConfirmedId=0
 confirmedConnection=connect(object.OnClientEvent,function(payload)
  if not running or confirmationMode~="ConfirmedOnly" then return end
  if type(payload)~="table" or payload.kind~="BlackFlashKill" or type(payload.id)~="number" or payload.id~=payload.id or payload.id<=lastConfirmedId then return end
  lastConfirmedId=payload.id
  if impactFramesEnabled then playImpactFrames() end
 end)
 updateFinisherStatus()
end
bindConfirmedRemote(ReplicatedStorage:FindFirstChild(CONFIRMED_REMOTE_NAME))
connect(ReplicatedStorage.ChildAdded,bindConfirmedRemote)
connect(ReplicatedStorage.ChildRemoved,function(object) if object==confirmedRemote then if confirmedConnection then confirmedConnection:Disconnect();confirmedConnection=nil end;confirmedRemote=nil;updateFinisherStatus() end end)
local function humanoidRoot(h) local m=h and h.Parent;local r=m and m:FindFirstChild("HumanoidRootPart");return r and r:IsA("BasePart") and r or nil end
local function livingLocal()
 local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");return c and h and h.Health>0 and c:FindFirstChild("HumanoidRootPart")
end
local function isNearby(h)
 local a=livingLocal();local b=humanoidRoot(h);local m=h and h.Parent
 return a and b and m and m:IsA("Model") and m~=LP.Character and m:FindFirstChildOfClass("Humanoid")==h and h:IsDescendantOf(workspace) and (a.Position-b.Position).Magnitude<=BLACKFLASH_NEARBY_RANGE
end
local function selectedV2Humanoid()
 local ref=gui:FindFirstChild("BlackflashChainV2Target");local selected=ref and ref.Value
 if selected then return selected:IsA("Humanoid") and selected or selected:IsA("Model") and selected:FindFirstChildOfClass("Humanoid") end
end
local function trackHumanoid(h)
 if not h:IsA("Humanoid") or trackedHumanoids[h] then return end
 local r={health=h.Health};trackedHumanoids[h]=r
 r.connection=h.HealthChanged:Connect(function(health)
  local before=r.health;r.health=health;local candidate=pendingBlackflash
  if not running or not focused or UIS:GetFocusedTextBox() or health>=before or before<=0 or not candidate or os.clock()>candidate.deadline or not candidate.targets[h] or not isNearby(h) then return end
  if candidate.character~=LP.Character then return end
  -- Keep candidate alive for its whole window, so an earlier nonlethal health
  -- update does not prevent observing a later lethal update in that same window.
  if not candidate.hit then candidate.hit=true;if popupEnabled then showBlackflashPopup(false) end end
  if confirmationMode=="EstimatedLethal" and health<=0 and not notifiedEstimated[h] then
   notifiedEstimated[h]=true
   if impactFramesEnabled then playImpactFrames() end
  end
 end)
end
local function untrackHumanoid(h) local r=trackedHumanoids[h];if not r then return end;r.connection:Disconnect();trackedHumanoids[h]=nil end
connect(workspace.DescendantAdded,trackHumanoid);connect(workspace.DescendantRemoving,untrackHumanoid)
for _,o in ipairs(workspace:GetDescendants()) do trackHumanoid(o) end
local function noteThreeTap(now)
 now=now or os.clock();local candidate
 if lastTapAt then
  local gap=now-lastTapAt
  if gap>=BLACKFLASH_MIN_GAP and gap<=BLACKFLASH_MAX_GAP then
   local targets={}
   if gui:GetAttribute("BlackflashChainV2Enabled") then
    local h=selectedV2Humanoid()
    if h and h.Health>0 and isNearby(h) then targets[h]=true end
   else for h in pairs(trackedHumanoids) do if h.Health>0 and isNearby(h) then targets[h]=true end end end
   candidate={targets=targets,deadline=now+BLACKFLASH_HIT_WINDOW,hit=false,character=LP.Character}
   pendingBlackflash=candidate;lastTapAt=nil
  else lastTapAt=now end
 else lastTapAt=now end
 return candidate
end
local macroCard,macroHeading=card(pages.Yuji,"Black Flash Follow-up","Press 3 normally; send the follow-up after 350 ms","auto blackflash macro 3 350 ms")
macroHeading.Size=UDim2.new(1,-34,0,20)
local macroSettings=make("Frame",macroCard,{Name="ModuleSettings",Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Visible=false,LayoutOrder=100})
make("UIListLayout",macroSettings,{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder})
local arrow=make("TextButton",macroHeading,{Name="SettingsArrow",AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Size=UDim2.fromOffset(26,20),Text=">",TextColor3=T.acc,BackgroundColor3=T.p2,Font=Enum.Font.GothamBold,TextSize=15,BorderSizePixel=0});corner(arrow,6)
connect(arrow.Activated,function() macroSettings.Visible=not macroSettings.Visible;arrow.Text=macroSettings.Visible and "v" or ">" end)
local chainCard=card(pages.Yuji,"Blackflash Chain","Tap 3; up to four pairs after estimated hits. Not server hit confirmation.","blackflash chain four rounds health estimate")
local chainStatus
local function stopCurrent()
 local job=currentJob;currentJob=nil
 if job then
  if job.thread and job.thread~=coroutine.running() then pcall(task.cancel,job.thread) end
  if job.keyDown and VIM then
   syntheticSending=true;echoUntil=os.clock()+.1
   pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Three,false,game) end)
   syntheticSending=false
  end
 end
 macroBusy,chainBusy=false,false
end
cancelMacro=function() if currentJob and currentJob.mode=="MACRO" then stopCurrent() end end
cancelChain=function() if currentJob and currentJob.mode=="CHAIN" then stopCurrent() end;if chainStatus then chainStatus.Text=chainEnabled and "Ready. Tap/release 3." or "OFF - estimated health loss controls continuation" end end
paintMacroToggle=toggle(macroSettings,"Auto Blackflash",function() return macroEnabled end,function(v)
 stopCurrent();macroEnabled=v
 if v then chainEnabled=false;if paintChainToggle then paintChainToggle() end end
end)
paintChainToggle=toggle(chainCard,"Blackflash Chain",function() return chainEnabled end,function(v)
 stopCurrent();chainEnabled=v
 if v then macroEnabled=false;if paintMacroToggle then paintMacroToggle() end end
end)
chainStatus=note(chainCard,"OFF - estimated health loss controls continuation")
local settingsCard=card(pages.Settings,"Session","Unload the menu and disconnect its listeners","unload close cleanup")
local unloadButton=make("TextButton",settingsCard,{Size=UDim2.new(1,0,0,30),BackgroundColor3=T.p2,Text="UNLOAD SCRIPT",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=11,BorderSizePixel=0,LayoutOrder=nextOrder(settingsCard)+2});corner(unloadButton,6)
local reopen=make("TextButton",gui,{Name="Reopen",Size=UDim2.fromOffset(138,36),Position=UDim2.new(0,14,1,-50),BackgroundColor3=T.panel,Text="OPEN JJS MENU",TextColor3=T.acc,Font=Enum.Font.GothamBold,TextSize=11,Visible=false,BorderSizePixel=0});corner(reopen)
local function show(v) main.Visible=v;reopen.Visible=not v end
connect(minimize.Activated,function() show(false) end);connect(reopen.Activated,function() show(true) end)
local function jobValid(job)
 return running and focused and currentJob==job and LP.Character==job.character and livingLocal() and not UIS:GetFocusedTextBox() and (job.mode=="CHAIN" and chainEnabled or job.mode=="MACRO" and macroEnabled)
end
local function waitUntil(job,deadline)
 while jobValid(job) do local left=deadline-os.clock();if left<=0 then return true end;task.wait(math.min(left,.015)) end;return false
end
local function sendThree(job,down)
 if down then job.keyDown=true end
 syntheticSending=true;echoUntil=os.clock()+.1
 local ok,err=pcall(function() VIM:SendKeyEvent(down,Enum.KeyCode.Three,false,game) end)
 syntheticSending=false
 if not ok then error(err,0) end
 if not down then job.keyDown=false end
end
local function startJob(started)
 if currentJob or not VIM or not livingLocal() then return end
 local mode=chainEnabled and "CHAIN" or macroEnabled and "MACRO" or nil;if not mode then return end
 local job={mode=mode,character=LP.Character,keyDown=false,physicalReleased=false};currentJob=job
 macroBusy=mode=="MACRO";chainBusy=mode=="CHAIN"
 job.thread=task.defer(function()
  local ok,err=xpcall(function()
   local rounds=mode=="CHAIN" and CHAIN_ROUNDS or 1
   for round=1,rounds do
    if not jobValid(job) then return end
    local first=started
    if round>1 then
     lastTapAt=nil;first=os.clock();noteThreeTap(first);sendThree(job,true)
     if not waitUntil(job,first+.035) then return end;sendThree(job,false)
    end
    if not waitUntil(job,first+.350) then return end
    if round==1 and not job.physicalReleased then chainStatus.Text="Cancelled: release the initial 3 before 350 ms.";return end
    local second=os.clock();local candidate=noteThreeTap(second)
    sendThree(job,true)
    if not waitUntil(job,second+.035) then return end;sendThree(job,false)
    if mode=="CHAIN" then
     chainStatus.Text=string.format("Round %d/%d: watching estimated health loss.",round,rounds)
     if not candidate then chainStatus.Text="Stopped: timing outside estimate window.";return end
     while jobValid(job) and not candidate.hit and os.clock()<=candidate.deadline do task.wait() end
     if not jobValid(job) then return end
     if not candidate.hit then chainStatus.Text="Stopped: no estimated hit. Tap 3 to retry.";return end
     if round<rounds and not waitUntil(job,os.clock()+CHAIN_RETRY_DELAY) then return end
    end
   end
   if mode=="CHAIN" then chainStatus.Text="Four estimated rounds complete. Tap 3 again." end
  end,function(e) return debug.traceback(tostring(e),2) end)
  if currentJob~=job then return end
  stopCurrent()
  if not ok then
   macroEnabled,chainEnabled=false,false;paintMacroToggle();paintChainToggle();chainStatus.Text="Input failed; modules OFF."
   warn("Blackflash input failed: "..tostring(err))
  end
 end)
end
connect(UIS.InputBegan,function(input,processed)
 if syntheticSending or (input.KeyCode==Enum.KeyCode.Three and os.clock()<echoUntil) then return end
 if UIS:GetFocusedTextBox() then return end
 if input.KeyCode==Enum.KeyCode.RightShift then show(not main.Visible);return end
 if processed or input.KeyCode~=Enum.KeyCode.Three or threeHeld then return end
 threeHeld=true
 if currentJob then return end
 if not focused or not livingLocal() then return end
 if macroEnabled or chainEnabled then lastTapAt=nil end
 local now=os.clock();noteThreeTap(now)
 if (macroEnabled or chainEnabled) and not VIM then warn("Virtual input unavailable");return end
 startJob(now)
end)
connect(UIS.InputEnded,function(input)
 if input.KeyCode==Enum.KeyCode.Three and not syntheticSending and os.clock()>=echoUntil then threeHeld=false;if currentJob then currentJob.physicalReleased=true end end
end)
local function resetDetection() lastTapAt=nil;pendingBlackflash=nil;threeHeld=false end
connect(UIS.WindowFocusReleased,function() focused=false;stopCurrent();resetDetection();drag=nil;cancelImpact() end)
connect(UIS.WindowFocused,function() focused=true end)
connect(UIS.TextBoxFocused,function() stopCurrent();resetDetection() end)
connect(LP.CharacterRemoving,function() stopCurrent();resetDetection();cancelImpact() end)
local function cleanup()
 if cleanedUp then return end
 cleanedUp=true;running=false;macroEnabled=false;chainEnabled=false;popupEnabled=false;impactFramesEnabled=false;drag=nil
 stopCurrent();resetDetection();cancelImpact();popupToken+=1
 if popup then popup:Destroy();popup=nil end
 for h in pairs(trackedHumanoids) do untrackHumanoid(h) end
 for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end;table.clear(conns)
end
local function unload() cleanup();if gui.Parent then gui:Destroy() end end
connect(shutdown.Event,unload);connect(close.Activated,unload);connect(unloadButton.Activated,unload);connect(gui.Destroying,cleanup)
local function renderPage(name)
 selectedPage=name;title.Text=name;desc.Text=descriptions[name]
 for _,cat in ipairs(cats) do local key=cat[1];local selected=key==name;pages[key].Visible=selected;buttons[key].BackgroundTransparency=selected and 0 or 1;buttons[key].TextColor3=selected and T.txt or T.dim end
end
selectPage=function(name,clearSearch)
 if not pages[name] then return end;selectedPage=name
 if clearSearch and search.Text~="" then suppressSearch=true;search.Text="";suppressSearch=false end
 if filter then filter() else renderPage(name) end
end
filter=function()
 local query=string.lower(search.Text):match("^%s*(.-)%s*$");local matches={};local anyMatch=false
 for _,cat in ipairs(cats) do
  local name=cat[1];local categoryMatch=query~="" and (string.find(string.lower(name),query,1,true) or string.find(string.lower(descriptions[name]),query,1,true))
  local pageMatch=categoryMatch or false
  for item,section in pairs(searchSections) do
   if section.page==pages[name] and item.Parent==pages[name] then local match=query=="" or categoryMatch or string.find(section.text,query,1,true);item.Visible=not not match;if match then pageMatch=true end end
  end
  matches[name]=pageMatch;if pageMatch then anyMatch=true end
 end
 if query~="" and not matches[selectedPage] then for _,cat in ipairs(cats) do if matches[cat[1]] then selectedPage=cat[1];break end end end
 renderPage(selectedPage);emptyState.Visible=query~="" and not anyMatch
end
connect(search:GetPropertyChangedSignal("Text"),function() if not suppressSearch then filter() end end);filter()
local function clampWindow()
 local size=root.AbsoluteSize;local ws=main.AbsoluteSize;if size.X<=0 or size.Y<=0 or ws.X<=0 or ws.Y<=0 then return end
 local p=main.AbsolutePosition-root.AbsolutePosition;local x=math.clamp(p.X,0,math.max(0,size.X-ws.X));local y=math.clamp(p.Y,0,math.max(0,size.Y-ws.Y));main.Position=UDim2.fromOffset(x+ws.X*main.AnchorPoint.X,y+ws.Y*main.AnchorPoint.Y)
end
local function fitWindow()
 local size=root.AbsoluteSize;if size.X<=0 or size.Y<=0 then return end
 scale.Scale=math.max(.05,math.min(1,size.X/760,size.Y/540));clampWindow();task.defer(function() if running then clampWindow() end end)
end
connect(root:GetPropertyChangedSignal("AbsoluteSize"),fitWindow)
connect(top.InputBegan,function(input)
 if drag then return end
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then drag=input;dragStart=Vector2.new(input.Position.X,input.Position.Y);dragOrigin=main.AbsolutePosition-root.AbsolutePosition end
end)
connect(UIS.InputChanged,function(input)
 if not drag or (input.UserInputType~=Enum.UserInputType.MouseMovement and input~=drag) then return end
 local size=root.AbsoluteSize;local ws=main.AbsoluteSize;local delta=Vector2.new(input.Position.X,input.Position.Y)-dragStart
 local x=math.clamp(dragOrigin.X+delta.X,0,math.max(0,size.X-ws.X));local y=math.clamp(dragOrigin.Y+delta.Y,0,math.max(0,size.Y-ws.Y));main.Position=UDim2.fromOffset(x+ws.X*main.AnchorPoint.X,y+ws.Y*main.AnchorPoint.Y)
end)
connect(UIS.InputEnded,function(input) if input==drag then drag=nil;dragStart=nil;dragOrigin=nil end end)
fitWindow()

     for _,track in ipairs(animator:GetPlayingAnimationTracks()) do seenTracks[track]=true end
     evidenceLink=animator.AnimationPlayed:Connect(function(track)
      if not active or generation~=id or seenTracks[track] or track.Looped then return end
      local priority=track.Priority;if priority==Enum.AnimationPriority.Idle or priority==Enum.AnimationPriority.Movement then return end
      local name=(track.Name or ""):lower();for _,word in ipairs({"idle","walk","run","jump","fall","climb","swim"}) do if name:find(word,1,true) then return end end

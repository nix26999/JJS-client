 end
 local function navigationRight(away) local cam=workspace.CurrentCamera;local right=cam and flat(cam.CFrame.RightVector) or Vector3.new(-away.Z,0,away.X);if os.clock()<flickUntil and flickRight.Magnitude>.01 then right=flickRight end;if right.Magnitude<.01 then right=Vector3.new(-away.Z,0,away.X) end;return right.Unit end
 local function signedYaw(a,b) a=flat(a);b=flat(b);if a.Magnitude<.01 or b.Magnitude<.01 then return 0 end;a=a.Unit;b=b.Unit;return math.deg(math.atan2(a:Cross(b).Y,math.clamp(a:Dot(b),-1,1))) end
 local function calculateRoute(tr,right,force)

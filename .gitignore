       pulse(token,Enum.KeyCode.Space);waitFor(token,math.max(0,cfg.JumpToStrike-cfg.Pulse)/1000);pulse(token,Enum.KeyCode.One);waitFor(token,cfg.StrikesWait/1000)
       jumpBehind(token);bf(token);three(token);waitFor(token,math.max(0,cfg.M1Gap-cfg.Pulse)/1000)
       jumpBehind(token);bf(token);three(token);pulse(token,Enum.KeyCode.Space);waitFor(token,cfg.JumpDelay/1000)
       waitFor(token,.7,function() return hum.FloorMaterial==Enum.Material.Air end)
       down=true;RS.RenderStepped:Wait();waitFor(token,0);click(token);waitFor(token,cfg.CrushingWait/1000)
       down=false;RS.RenderStepped:Wait();waitFor(token,0);pulse(token,Enum.KeyCode.Two)
      else
       waitFor(token,math.max(0,cfg.M1Gap-cfg.Pulse)/1000);local _,tr=targetRig();local initialY=tr.Position.Y

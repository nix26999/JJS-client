 local search=make("TextBox",box,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text="",PlaceholderText="Pick by username or display name",ClearTextOnFocus=false,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=4});corner(search,6)
 local list=make("ScrollingFrame",box,{Size=UDim2.new(1,0,0,130),BackgroundColor3=T.p2,BorderSizePixel=0,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=3,LayoutOrder=5});make("UIListLayout",list,{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder})
 local info=make("TextLabel",box,{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Text="Off",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextWrapped=true,LayoutOrder=6});ord[box]=6;local rows={}
 local function filter() local q=search.Text:lower();for _,e in ipairs(rows) do e.b.Visible=q=="" or e.text:find(q,1,true)~=nil end end
 local function rebuild()
  for _,e in ipairs(rows) do e.c:Disconnect();e.b:Destroy() end;rows={};local ps=Players:GetPlayers();table.sort(ps,function(a,b) return a.Name:lower()<b.Name:lower() end)
  for i,p in ipairs(ps) do if p~=LP then local label=p.DisplayName.." (@"..p.Name..")";local b=make("TextButton",list,{Size=UDim2.new(1,0,0,26),BackgroundColor3=T.p2,Text=label,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=i});corner(b,5);local c=b.Activated:Connect(function() chosen=p.UserId;picked.Text="Target: "..label;last=-math.huge end);table.insert(rows,{b=b,c=c,text=label:lower()}) end end;filter()
 end
 connect(search:GetPropertyChangedSignal("Text"),filter);connect(Players.PlayerAdded,rebuild);connect(Players.PlayerRemoving,function(p) if chosen==p.UserId then chosen=nil;picked.Text="Target: none selected" end;task.defer(function() if running and gui.Parent then rebuild() end end) end);rebuild()
 toggle(box,"Loop Teleport Behind",function() return on end,function(v) on=v;gui:SetAttribute("BehindTeleportActive",v);last=-math.huge;info.Text=v and "Choose a target above" or "Off" end)
 moduleSlider(box,"Repeat interval",50,1000,intervalMs," ms",function() return intervalMs end,function(v) intervalMs=v end)
 moduleSlider(box,"Behind distance",2,12,behindDistance," studs",function() return behindDistance end,function(v) behindDistance=v end)
 connect(RS.Heartbeat,function()
  if not running or not on or busy or todoBusy or manualSequenceBusy or UIS:GetFocusedTextBox() or gui:GetAttribute("JumpPowerAirborne") then return end
  local now=os.clock();if now-last<intervalMs/1000 then return end;local p=chosen and Players:GetPlayerByUserId(chosen)
  local c=LP.Character;local tc=p and p.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart");local th=tc and tc:FindFirstChildOfClass("Humanoid");local tr=tc and tc:FindFirstChild("HumanoidRootPart")
  if not h or not r or not th or not tr or h.Health<=0 or th.Health<=0 then info.Text="Waiting for selected live player";return end
  local look=Vector3.new(tr.CFrame.LookVector.X,0,tr.CFrame.LookVector.Z);if look.Magnitude<.01 then return end;look=look.Unit
  local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={c,tc};params.RespectCanCollide=true
  last=now;if workspace:Raycast(tr.Position,-look*behindDistance,params) then info.Text="Behind position blocked";return end
  local pos=tr.Position-look*behindDistance;r.CFrame=CFrame.lookAt(pos,Vector3.new(tr.Position.X,pos.Y,tr.Position.Z));r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero;info.Text="Looping behind "..p.DisplayName
 end)
 local function stop() on=false;pcall(function() gui:SetAttribute("BehindTeleportActive",false) end);for _,e in ipairs(rows) do e.c:Disconnect() end end;connect(unload.Activated,stop);connect(gui.Destroying,stop)
end)()

-- V2/V3: majority-body rear gate and isolated 3-key input pairs.
local function TRACE(err) return debug.traceback(tostring(err),2) end
local function REPORT(name,err)
 warn(name..": "..tostring(err))
 pcall(function() gui:SetAttribute("JJS_LastModuleError",name..": "..tostring(err));status.Text="Module error: "..name end)
end
--[[
COMPLETE REPLACEMENT: Blackflash V2/V3 InstallModule wrapper only.
Requires the existing full script's Main, helpers, TRACE, and REPORT.
Leave all other modules and bootstrap code unchanged.

Integration contract (NOT a built-in JJS interface):
_G.JJSVerifiedCombat = {
 subscribe = function(callback)
  -- Connect actual, server-attributed damaging-hit feedback.
  -- Emit only relevant combat acknowledgements, not animation guesses:
  -- callback({confirmed=true, attackerUserId=actualUserId,
  --  targetModel=actualDamagedModel, damage=positiveDamage,
  --  hitId=uniqueServerHitId, serverTime=serverTimestamp})
  -- Return an object exposing :Disconnect().
 end,
 isReady = function(action, targetModel)
  -- Return true only when the actual game allows the action.
  -- Actions: BlackflashStart, BlackflashFollowup, LMB.
 end,
}
No adapter means no attack inputs. Generic health changes do not qualify.
The adapter must filter the relevant attack acknowledgements; the generic
fields above do not independently prove an attack's causal identity.
400 ms follow-up is retained, not live-calibrated. No artificial cycle or
repeat sleep. Self-tests below execute on installation in Roblox; separate
model tests do not constitute live-game or Luau-runtime verification.
]]
do
 local function InstallModule()
  local CAS=game:GetService("ContextActionService")
  local CFG={Repeats=4,FollowupDelay=.400,KeyPulse=.035,HitTimeout=.800,
   AttackRange=7,BodyBehind=.75,SideMin=6,SideAim=6.35,SideCooldown=2,
   JumpRange=6,JumpRetry=1.25,PostJumpMin=5,PostJumpAim=5.25,
   CameraResponse=14,MovementResponse=18,
   SourceName="JJSVerifiedCombat"}
  local ACTION="JJSBlackflashV2Activate"
  local CAMERA_BIND="JJSBlackflashV2Camera"
  local FACING_BIND="JJSBlackflashV2Facing"
  local MOVE_KEYS={Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D}
  local BODY_NAMES={Head=true,Torso=true,UpperTorso=true,LowerTorso=true,
   ["Left Arm"]=true,["Right Arm"]=true,["Left Leg"]=true,["Right Leg"]=true,
   LeftUpperArm=true,LeftLowerArm=true,LeftHand=true,RightUpperArm=true,RightLowerArm=true,RightHand=true,
   LeftUpperLeg=true,LeftLowerLeg=true,LeftFoot=true,RightUpperLeg=true,RightLowerLeg=true,RightFoot=true}
  local S={enabledV2=false,enabledV3=false,includeNPCs=false,turnaround=false,calculator=true,autoCameraAngle=false,
   active=false,version=2,generation=0,armed=false,syntheticThree=false,stage="OFF",
   held={},mouseDown=false,connections={},model=nil,humanoid=nil,root=nil,
   ownedHumanoid=nil,oldAutoRotate=nil,moveMode="idle",desiredMove=Vector3.zero,smoothMove=Vector3.zero,
   sideKey=Enum.KeyCode.D,sidePreferenceUntil=0,nextDash=0,failedDashes=0,nextJump=0,
   jumpAirborne=false,backoff=false,pairCount=0,cycleCount=0,pairStarted=0,deadline=0,
   source=nil,sourceConnection=nil,progressPosition=nil,progressAt=0,
   flickFrom=nil,flickTo=nil,flickStarted=0,flickUntil=0,mixUsed=false,mixFacing=nil,
   borrowedLock=false,oldLock=false,partsCharacter=nil,parts={},partsDirty=true,
   partConnections={},routeAt=-math.huge,route=nil}
  local start,stop,bindCapture,tick
  local function finite(value)
   return type(value)=="number" and value==value and value>-math.huge and value<math.huge
  end
  local function flat(vector) return Vector3.new(vector.X,0,vector.Z) end
  local function unitOrZero(vector) return vector.Magnitude>.001 and vector.Unit or Vector3.zero end
  local function rig()
   local character=LP.Character
   local humanoid=character and character:FindFirstChildOfClass("Humanoid")
   local root=character and character:FindFirstChild("HumanoidRootPart")
   if humanoid and root and humanoid.Health>0 then return character,humanoid,root end
  end
  local function typing() return UIS:GetFocusedTextBox()~=nil end
  local function disconnect(connection)
   if connection then pcall(function() connection:Disconnect() end) end
  end
  local function disconnectList(list)
   for _,connection in ipairs(list) do disconnect(connection) end
   table.clear(list)
  end

  -- Pure attributed-hit gate. Neither animation nor health events open it.
  local function newHitGate(userId,clock)
   local gate={userId=userId,clock=clock,ticket=nil,used={},ring={},ringIndex=0}
   function gate:cancel()
    if self.ticket then self.ticket.closed=true end
    self.ticket=nil
   end
   function gate:begin(target,duration)
    self:cancel()
    local now=self.clock()
    self.ticket={target=target,openedAt=now,deadline=now+duration,hit=false,closed=false}
    return self.ticket
   end
   function gate:accept(event)
    local ticket=self.ticket
    if not ticket or ticket.closed or ticket.hit or type(event)~="table" or event.confirmed~=true then return false end
    local now=self.clock()
    if now>ticket.deadline or event.attackerUserId~=self.userId or event.targetModel~=ticket.target
     or not finite(event.damage) or event.damage<=0 or not finite(event.serverTime)
     or event.serverTime<ticket.openedAt or event.serverTime>ticket.deadline
     or event.serverTime>now+.15 then return false end
    local idType=type(event.hitId)
    if idType=="string" then
     if #event.hitId==0 or #event.hitId>128 then return false end
    elseif idType=="number" then
     if not finite(event.hitId) then return false end
    else return false end
    local key=idType..":"..tostring(event.hitId)
    if self.used[key] then return false end
    self.ringIndex=self.ringIndex%256+1
    local oldKey=self.ring[self.ringIndex]
    if oldKey then self.used[oldKey]=nil end
    self.ring[self.ringIndex]=key;self.used[key]=true
    ticket.hit=true;ticket.hitId=event.hitId
    return true
   end
   return gate
  end
  local function runHitGateTests()
   local now=10;local target={};local otherTarget={}
   local gate=newHitGate(123,function() return now end)
   local function event(overrides)
    local result={confirmed=true,attackerUserId=123,targetModel=target,damage=5,hitId="hit-1",serverTime=now}
    for key,value in pairs(overrides or {}) do result[key]=value end
    return result
   end
   gate:begin(target,1)
   assert(not gate:accept(event({attackerUserId=456})))
   assert(not gate:accept(event({targetModel=otherTarget})))
   assert(not gate:accept(event({confirmed=false})))
   assert(not gate:accept(event({damage=0})))
   assert(not gate:accept(event({damage=-5})))
   assert(not gate:accept(event({serverTime=9})))
   assert(not gate:accept(event({serverTime=100})))
   assert(not gate:accept(event({damage=0/0})))
   assert(not gate:accept(event({damage=math.huge})))
   assert(not gate:accept(event({hitId=""})))
   assert(not gate:accept(event({hitId={}})))
   assert(gate:accept(event()))
   assert(not gate:accept(event({hitId="hit-2"})))
   gate:begin(target,1)
   assert(not gate:accept(event()))
   assert(gate:accept(event({hitId="hit-2"})))
   gate:begin(target,1);now=12
   assert(not gate:accept(event({hitId="hit-3"})))
   gate:begin(target,1);gate:cancel()
   assert(not gate:accept(event({hitId="hit-4"})))
   now=20;gate:begin(target,.1)
   assert(not gate:accept(event({hitId="after-deadline",serverTime=20.11})))
   gate:cancel()
   return true
  end
  assert(runHitGateTests(),"Hit-gate self-tests failed")
  gui:SetAttribute("JJS_HitGateTestsPassed",true)
  local gate=newHitGate(LP.UserId,function() return workspace:GetServerTimeNow() end)

  -- UI
  local box2=card(pages.Yuji,"Blackflash Chain V2","4 hit-confirmed pairs + hit-confirmed LMB, then stop")
  box2.LayoutOrder=3
  local feedback2=make("TextLabel",box2,{Size=UDim2.new(1,0,0,72),BackgroundTransparency=1,Text="V2 off",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[box2]=3
  local box3=card(pages.Yuji,"Blackflash Chain V3","Repeat only after your attributed hit; no artificial cycle pause")
  box3.LayoutOrder=4
  local feedback3=make("TextLabel",box3,{Size=UDim2.new(1,0,0,72),BackgroundTransparency=1,Text="V3 off",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[box3]=3
  local routeBox=card(pages.Yuji,"V2 / V3 Route Calculator","Stable side preference; side dash before jump recovery")
  routeBox.LayoutOrder=5
  local routeStatus=make("TextLabel",routeBox,{Size=UDim2.new(1,0,0,112),BackgroundTransparency=1,Text="No target",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3});ord[routeBox]=3
  local function say(text)
   local label=S.version==3 and feedback3 or feedback2
   if label.Parent and label.Text~=text then label.Text=text end
  end

  -- Owned inputs and cleanup
  local function key(code,down)
   if down then
    if S.held[code] then return end
    S.held[code]=true
   elseif not S.held[code] then return end
   if code==Enum.KeyCode.Three then S.syntheticThree=true end
   local ok,err=pcall(function() VIM:SendKeyEvent(down,code,false,game) end)
   S.syntheticThree=false
   if not down then S.held[code]=nil end
   if not ok then error(err,0) end
  end
  local function releaseMovement()
   S.moveMode="idle";S.desiredMove=Vector3.zero;S.smoothMove=Vector3.zero
   for _,code in ipairs(MOVE_KEYS) do key(code,false) end
   key(Enum.KeyCode.Q,false)
  end
  local function setMovement(mode,vector,sideKey)
   S.moveMode=mode;S.desiredMove=vector
   if sideKey then S.sideKey=sideKey end
   key(Enum.KeyCode.W,mode=="catchup" or mode=="approach" or mode=="jump")
   key(Enum.KeyCode.S,mode=="open" or mode=="backoff" or mode=="mix")
   local sideways=mode=="side" or mode=="orbit"
   key(Enum.KeyCode.A,sideways and S.sideKey==Enum.KeyCode.A)
   key(Enum.KeyCode.D,sideways and S.sideKey==Enum.KeyCode.D)
   if mode~="side" and mode~="mix" then key(Enum.KeyCode.Q,false) end
  end
  local function restoreLock()
   if S.borrowedLock then lockOn=S.oldLock end
   S.borrowedLock=false;S.mixFacing=nil
  end
  local function releaseAll()
   for code in pairs(S.held) do pcall(function() VIM:SendKeyEvent(false,code,false,game) end) end
   table.clear(S.held)
   if S.mouseDown then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
   S.mouseDown=false;S.desiredMove=Vector3.zero;S.smoothMove=Vector3.zero;S.moveMode="idle"
   local _,humanoid=rig()
   if humanoid then humanoid:Move(Vector3.zero,false) end
   if S.ownedHumanoid and S.ownedHumanoid.Parent then S.ownedHumanoid.AutoRotate=S.oldAutoRotate end
   S.ownedHumanoid=nil;restoreLock()
  end
  stop=function(reason)
   local wasActive=S.active
   S.active=false;S.generation+=1;S.armed=false;S.stage="OFF"
   gate:cancel();disconnect(S.sourceConnection);S.sourceConnection=nil;S.source=nil
   disconnectList(S.connections);releaseAll()
   S.model=nil;S.humanoid=nil;S.root=nil;S.flickUntil=0;S.backoff=false
   if wasActive then busy=false;manualSequenceBusy=false end
   gui:SetAttribute("BlackflashChainV2Active",false);gui:SetAttribute("BlackflashChainV3Active",false)
   say(reason or "Stopped - press/release 3 again")
   if bindCapture then bindCapture() end
  end

  -- Cached body part references; transforms and sizes remain live.
  local function bodyParts(character)
   if S.partsCharacter~=character then
    disconnectList(S.partConnections);S.partsCharacter=character;S.partsDirty=true
    table.insert(S.partConnections,character.ChildAdded:Connect(function() S.partsDirty=true end))
    table.insert(S.partConnections,character.ChildRemoved:Connect(function() S.partsDirty=true end))
   end
   if S.partsDirty then
    table.clear(S.parts)
    for _,part in ipairs(character:GetChildren()) do
     if part:IsA("BasePart") and BODY_NAMES[part.Name] then table.insert(S.parts,part) end
    end
    S.partsDirty=false
   end
   return S.parts
  end
  local function partRearFraction(part,origin,normal)
   local cf,size=part.CFrame,part.Size;local center=normal:Dot(cf.Position-origin);local widths={}
   for _,width in ipairs({math.abs(normal:Dot(cf.RightVector))*size.X,math.abs(normal:Dot(cf.UpVector))*size.Y,math.abs(normal:Dot(cf.LookVector))*size.Z}) do
    if width>.0001 then table.insert(widths,width) end
   end
   local count=#widths;local span=0
   for _,width in ipairs(widths) do span+=width*.5 end
   if center>=span then return 0 end
   if center<=-span then return 1 end
   if count==0 then return 0 end
   local total=0;local distance=span-center;local denominator=count==3 and 6 or count==2 and 2 or 1
   for _,width in ipairs(widths) do denominator*=width end
   for mask=0,2^count-1 do
    local shift,sign=0,1
    for index=1,count do
     if bit32.band(mask,bit32.lshift(1,index-1))~=0 then shift+=widths[index];sign=-sign end
    end
    total+=sign*math.max(distance-shift,0)^count
   end
   return math.clamp(total/denominator,0,1)
  end
  local function bodyBehind(targetRoot)
   local character,_,root=rig()
   if not character or not targetRoot or not targetRoot.Parent then return 0 end
   local normal=unitOrZero(flat(targetRoot.CFrame.LookVector))
   if normal.Magnitude==0 or normal:Dot(root.Position-targetRoot.Position)>=0 then return 0 end
   local total,behind=0,0
   for _,part in ipairs(bodyParts(character)) do
    if part.Parent==character then
     local volume=part.Size.X*part.Size.Y*part.Size.Z;total+=volume
     behind+=volume*partRearFraction(part,targetRoot.Position,normal)
    end
   end
   return total>0 and behind/total or 0
  end
  local function attackReady()
   local _,_,root=rig()
   return root~=nil and S.root~=nil and S.root.Parent~=nil and S.humanoid~=nil and S.humanoid.Health>0
    and(root.Position-S.root.Position).Magnitude<=CFG.AttackRange and bodyBehind(S.root)>=CFG.BodyBehind
  end
  local function closest()
   local _,_,root=rig();if not root then return end
   local result,minimum=nil,math.huge
   for humanoid in pairs(humanoids) do
    local model=humanoid.Parent
    if humanoid.Health>0 and model and model:IsA("Model") and model~=LP.Character and model:IsDescendantOf(workspace) then
     local player=Players:GetPlayerFromCharacter(model)
     if player~=LP and(player or S.includeNPCs) then
      local otherRoot=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
      if otherRoot and otherRoot:IsA("BasePart") then
       local distance=(otherRoot.Position-root.Position).Magnitude
       if distance<minimum then
        minimum=distance;result={model=model,humanoid=humanoid,root=otherRoot,name=player and player.DisplayName or model.Name}
       end
      end
     end
    end
   end
   return result
  end

  -- Geometry routes. One reusable raycast filter per character/target.
  local function blocked(root,direction,length)
   if direction.Magnitude<.001 then return false end
   if not S.rayParams or S.rayCharacter~=LP.Character or S.rayTarget~=S.model then
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={LP.Character,S.model};params.RespectCanCollide=true
    S.rayParams=params;S.rayCharacter=LP.Character;S.rayTarget=S.model
   end
   for _,shift in ipairs({Vector3.zero,Vector3.new(0,-1.5,0),Vector3.new(0,1,0)}) do
    if workspace:Raycast(root.Position+shift,direction.Unit*length,S.rayParams) then return true end
   end
   return false
  end
  local function routes(root,away,distance)
   local now=os.clock()
   local targetLook=unitOrZero(flat(S.root.CFrame.LookVector))
   local camera=workspace.CurrentCamera
   local right=camera and unitOrZero(flat(camera.CFrame.RightVector)) or Vector3.new(-away.Z,0,away.X)
   if right.Magnitude==0 then right=Vector3.new(-away.Z,0,away.X) end
   local _,humanoid=rig();local speed=humanoid and math.max(humanoid.WalkSpeed,1) or 16
   if S.route and now-S.routeAt<.1 and(root.Position-S.route.position).Magnitude<.5
    and(S.root.Position-S.route.targetPosition).Magnitude<.5 and away:Dot(S.route.away)>.99
    and targetLook:Dot(S.route.targetLook)>.99 and right:Dot(S.route.cameraRight)>.99
    and math.abs(speed-S.route.speed)<1 then return S.route end
   local rear=-targetLook
   local angle=math.atan2(away:Cross(rear).Y,math.clamp(away:Dot(rear),-1,1))
   local rightSign=away:Cross(right).Y>=0 and 1 or -1
   local cone=math.acos(math.clamp(.65/math.max(distance,.65),0,1))
   local function evaluate(direction,turn,sideKey)
    local radians=math.max(0,(angle*turn)%(math.pi*2)-cone)
    local travel=direction*17.5;local offset=flat(root.Position-S.root.Position)
    local fraction=math.clamp(-offset:Dot(travel)/math.max(travel:Dot(travel),.001),0,1)
    return {key=sideKey,direction=direction,walkClear=not blocked(root,direction,3),
     dashClear=distance>=CFG.SideMin and(offset+travel*fraction).Magnitude>=CFG.SideMin and not blocked(root,direction,17.5),
     degrees=math.deg(radians),eta=distance*radians/speed}
   end
   S.route={position=root.Position,away=away,targetPosition=S.root.Position,targetLook=targetLook,cameraRight=right,speed=speed,
    right=evaluate(right,rightSign,Enum.KeyCode.D),left=evaluate(-right,-rightSign,Enum.KeyCode.A)}
   S.routeAt=now;return S.route
  end
  local function selectSide(route,field)
   local current=S.sideKey==Enum.KeyCode.A and route.left or route.right
   local other=S.sideKey==Enum.KeyCode.A and route.right or route.left
   if not current[field] then
    if not other[field] then return end
    current=other
   elseif S.calculator and other[field] and os.clock()>=S.sidePreferenceUntil and other.eta+.12<current.eta then current=other end
   if current.key~=S.sideKey then S.sideKey=current.key;S.sidePreferenceUntil=os.clock()+.7 end
   return current
  end
  local function orbit(root,away,distance,side)
   local tangent=side.direction-away*side.direction:Dot(away)
   if tangent.Magnitude<.1 then
    tangent=Vector3.new(-away.Z,0,away.X)
    if tangent:Dot(side.direction)<0 then tangent=-tangent end
   end
   local vector=tangent.Unit*.75+away*math.clamp((CFG.SideAim-distance)*.8,-.65,.65)
   if vector.Magnitude>1 then vector=vector.Unit end
   setMovement("orbit",vector,side.key)
  end
  -- Re-check lifecycle and geometry after an adapter callback returns.
  local function sourceReady(action)
   if not S.active or not S.source then return false end
   local source,token,target=S.source,S.generation,S.model
   local ok,ready=pcall(source.isReady,action,target)
   if not S.active or S.generation~=token or S.model~=target or S.source~=source or rawget(_G,CFG.SourceName)~=source or typing() then return false end
   if not ok then stop("Stopped: readiness adapter failed: "..tostring(ready));return false end
   if ready~=true then say("Waiting for actual action readiness: "..action);return false end
   return attackReady()
  end
  local function beginPair()
   if not attackReady() or not sourceReady("BlackflashStart") then return false end
   releaseMovement();gate:begin(S.model,CFG.FollowupDelay+CFG.HitTimeout+.2)
   S.pairStarted=os.clock();S.stage="FIRST_DOWN";S.deadline=S.pairStarted+CFG.KeyPulse
   CAS:UnbindAction(ACTION);key(Enum.KeyCode.Three,true)
   say(("Pair %d/%d - waiting for your hit"):format(S.pairCount+1,CFG.Repeats));return true
  end
  local function beginLMB()
   if not attackReady() or not sourceReady("LMB") then return false end
   releaseMovement();gate:begin(S.model,CFG.HitTimeout+.2)
   S.mouseDown=true;VIM:SendMouseButtonEvent(0,0,0,true,game,0)
   S.stage="MOUSE_DOWN";S.deadline=os.clock()+CFG.KeyPulse;return true
  end
  local function beginFallbackJump(root,humanoid)
   if os.clock()<S.nextJump or humanoid.FloorMaterial==Enum.Material.Air
    or(root.Position-S.root.Position).Magnitude>CFG.JumpRange then releaseMovement();return end
   S.nextJump=os.clock()+CFG.JumpRetry;S.jumpAirborne=false;S.stage="JUMP_DOWN"
   S.pairStarted=os.clock();S.deadline=S.pairStarted+CFG.KeyPulse
   key(Enum.KeyCode.Space,true);humanoid.Jump=true
  end
  local function setup(root,humanoid)
   local offset=flat(root.Position-S.root.Position);local distance=offset.Magnitude
   local away=distance>.001 and offset.Unit or Vector3.new(0,0,1)
   if S.backoff then
    if distance<CFG.PostJumpMin then setMovement("backoff",away);return end
    S.backoff=false
   end
   if(root.Position-S.root.Position).Magnitude>CFG.AttackRange then
    if distance>.1 then setMovement("catchup",-away) else releaseMovement() end
    return
   end
   if attackReady() then
    releaseMovement()
    if S.pairCount>=CFG.Repeats then beginLMB() else beginPair() end
    return
   end
   local now=os.clock()
   if not S.progressPosition or(root.Position-S.progressPosition).Magnitude>.5 or S.moveMode=="idle" then
    S.progressPosition=root.Position;S.progressAt=now
   end
   local stuck=now-S.progressAt>.85 and S.desiredMove.Magnitude>.2
   local route=routes(root,away,distance);local dash=selectSide(route,"dashClear");local walk=selectSide(route,"walkClear")
   if S.turnaround and not S.mixUsed then
    local look=unitOrZero(flat(S.root.CFrame.LookVector))
    if away:Dot(look)>=.55 and humanoid.FloorMaterial~=Enum.Material.Air and math.random(1,3)==1 then
     releaseMovement();S.mixUsed=true;S.oldLock=lockOn;S.borrowedLock=true;lockOn=false;S.mixFacing=away
     root.CFrame=CFrame.lookAt(root.Position,root.Position+away)
     local camera=workspace.CurrentCamera
     if camera then camera.CFrame=CFrame.lookAt(camera.CFrame.Position,camera.CFrame.Position+away) end
     S.stage="MIX_TURN";S.deadline=now+.05;return
    end
   end
   if stuck and S.failedDashes>=2 then
    if distance>CFG.JumpRange then setMovement("approach",-away) else beginFallbackJump(root,humanoid) end
    return
   end
   if distance<CFG.SideMin then
    if not blocked(root,away,2) then setMovement("open",away)
    elseif walk then orbit(root,away,distance,walk) else beginFallbackJump(root,humanoid) end
    return
   end
   if dash and now>=S.nextDash then
    releaseMovement();S.sideKey=dash.key;local token=S.generation
    local job=Dash.start(dash.key,function() return S.active and S.generation==token end)
    if not job then return end
    S.sharedDash=job;S.nextDash=now+CFG.SideCooldown;S.stage="DASH";return
   end
   if walk then orbit(root,away,distance,walk)
   elseif distance>CFG.JumpRange then setMovement("approach",-away) else beginFallbackJump(root,humanoid) end
  end

  -- Bounded state machine: inputs are released before waiting for acknowledgements.
  local function step()
   if not running or typing() then stop("Stopped: focus changed. Press/release 3 again.");return end
   local _,humanoid,root=rig()
   if not humanoid or not S.model or not S.model:IsDescendantOf(workspace)
    or not S.humanoid or not S.humanoid.Parent or S.humanoid.Health<=0
    or not S.root or not S.root.Parent then stop("Stopped: character or target unavailable.");return end
   if rawget(_G,CFG.SourceName)~=S.source then stop("Stopped: verified-hit adapter changed during the run.");return end
   for _=1,8 do
    if not S.active then return end
    local now=os.clock();local stage=S.stage
    if stage=="SETUP" then setup(root,humanoid);return
    elseif stage=="FIRST_DOWN" then
     if now<S.deadline then return end
     key(Enum.KeyCode.Three,false);S.stage="WAIT_SECOND";S.deadline=S.pairStarted+CFG.FollowupDelay
    elseif stage=="WAIT_SECOND" then
     if now<S.deadline then return end
     if not attackReady() or not sourceReady("BlackflashFollowup") then
      if S.active then stop("Stopped: follow-up body/range/readiness check failed.") end
      return
     end
     key(Enum.KeyCode.Three,true);S.stage="SECOND_DOWN";S.deadline=now+CFG.KeyPulse;return
    elseif stage=="SECOND_DOWN" then
     if now<S.deadline then return end
     key(Enum.KeyCode.Three,false);S.stage="WAIT_HIT"
     if gate.ticket then gate.ticket.deadline=workspace:GetServerTimeNow()+CFG.HitTimeout end
     bindCapture()
    elseif stage=="WAIT_HIT" or stage=="WAIT_LMB_HIT" then
     local ticket=gate.ticket
     if not ticket then stop("Stopped: hit-confirmation ticket missing.");return end
     if ticket.hit then
      gate:cancel()
      if stage=="WAIT_LMB_HIT" then
       if S.version==2 then stop("V2 finished: four hit-confirmed pairs and LMB.");return end
       S.cycleCount+=1;S.pairCount=0
      else S.pairCount+=1 end
      S.failedDashes=0;S.mixUsed=false;S.progressPosition=nil;S.stage="SETUP"
      setup(root,humanoid);return
     end
     if workspace:GetServerTimeNow()>ticket.deadline then stop("Stopped: your hit was not confirmed; no next repeat.") end
     return
    elseif stage=="MOUSE_DOWN" then
     if now<S.deadline then return end
     VIM:SendMouseButtonEvent(0,0,0,false,game,0);S.mouseDown=false;S.stage="WAIT_LMB_HIT"
     if gate.ticket then gate.ticket.deadline=workspace:GetServerTimeNow()+CFG.HitTimeout end
    elseif stage=="DASH" then
     local job=S.sharedDash
     if not job or job.done then
      S.sharedDash=nil
      if job and job.error then stop("Stopped: "..job.error);return end
      if attackReady() then S.failedDashes=0 else S.failedDashes+=1 end
      S.stage="SETUP"
     end
     return
    elseif stage=="JUMP_DOWN" or stage=="JUMPING" then
     local rear=unitOrZero(flat(S.root.CFrame.LookVector));local goal=S.root.Position-rear*4
     setMovement("jump",unitOrZero(flat(goal-root.Position)))
     if humanoid.FloorMaterial==Enum.Material.Air then S.jumpAirborne=true end
     if stage=="JUMP_DOWN" and now>=S.deadline then key(Enum.KeyCode.Space,false);S.stage="JUMPING" end
     if S.jumpAirborne and attackReady() then
      key(Enum.KeyCode.Space,false) -- Also release if success precedes pulse deadline.
      releaseMovement();S.backoff=true;S.stage="SETUP"
     elseif now-S.pairStarted>2.5 or(now-S.pairStarted>.4 and humanoid.FloorMaterial~=Enum.Material.Air) then
      key(Enum.KeyCode.Space,false);releaseMovement();S.failedDashes=0;S.progressPosition=nil;S.stage="SETUP"
     end
     return
    elseif stage=="MIX_TURN" then
     if now<S.deadline then return end
     setMovement("mix",-S.mixFacing);S.stage="MIX_S";S.deadline=now+.035;return
    elseif stage=="MIX_S" then
     if now<S.deadline then return end
     key(Enum.KeyCode.Q,true);S.stage="MIX_Q";S.deadline=now+CFG.KeyPulse;return
    elseif stage=="MIX_Q" then
     if now<S.deadline then return end
     key(Enum.KeyCode.Q,false);S.stage="MIX_RECOVER";S.deadline=now+.215;return
    elseif stage=="MIX_RECOVER" then
     if now<S.deadline then return end
     releaseMovement();restoreLock();S.stage="SETUP";return
    else stop("Stopped: unknown chain state "..tostring(stage));return end
   end
  end
  local stepping=false
  tick=function()
   if stepping or not S.active or S.stage=="CONNECTING" then return end
   stepping=true;local ok,err=xpcall(step,TRACE);stepping=false
   if not ok then stop("Stopped: "..tostring(err));REPORT("Blackflash V2/V3 runtime",err) end
  end

  -- Activation
  start=function()
   if S.active or not running or typing() then return end
   S.version=S.enabledV3 and 3 or 2
   if not S.enabledV2 and not S.enabledV3 then return end
   if busy or todoBusy or manualSequenceBusy then say("Wait for the other macro.");return end
   if not okVIM or not VIM then say("Input simulation unavailable.");return end
   if not rig() then say("Character unavailable.");return end
   local source=rawget(_G,CFG.SourceName)
   if type(source)~="table" or type(source.subscribe)~="function" or type(source.isReady)~="function" then
    say("BLOCKED: JJSVerifiedCombat is missing. Hit-confirmed chains require a real game adapter; no attack inputs sent.")
    return
   end

   local target=closest()
   if not target then say("No eligible living player/NPC found.");return end

   gate:cancel();disconnect(S.sourceConnection);S.sourceConnection=nil
   disconnectList(S.connections);releaseAll()
   S.generation+=1
   local token=S.generation
   S.model=target.model;S.humanoid=target.humanoid;S.root=target.root
   S.source=source;S.active=true;S.armed=false;S.syntheticThree=false;S.stage="CONNECTING"
   S.pairCount=0;S.cycleCount=0;S.failedDashes=0;S.nextDash=0;S.nextJump=0
   S.jumpAirborne=false;S.backoff=false;S.mixUsed=false;S.sideKey=Enum.KeyCode.D
   S.sidePreferenceUntil=0;S.progressPosition=nil;S.progressAt=os.clock()
   S.flickFrom=nil;S.flickTo=nil;S.flickStarted=0;S.flickUntil=0
   S.route=nil;S.routeAt=-math.huge;S.rayParams=nil
   busy=true;manualSequenceBusy=true
   gui:SetAttribute("BlackflashChainV2Active",true)
   gui:SetAttribute("BlackflashChainV3Active",S.version==3)

   local function current()
    return S.active and S.generation==token and S.source==source
   end
   local ok,connection=pcall(source.subscribe,function(event)
    if not current() then return end
    if rawget(_G,CFG.SourceName)~=source then
     stop("Stopped: verified-hit adapter changed.");return
    end
    local acceptedOK,accepted=pcall(gate.accept,gate,event)
    if not acceptedOK then
     stop("Stopped: invalid hit-adapter callback.")
     REPORT("Verified-hit callback",accepted);return
    end
    if accepted then
     -- Continue on feedback instead of waiting out an extra repeat timer.
     task.defer(function() if current() then tick() end end)
    end
   end)

   -- subscribe() may yield; never revive a cancelled/unloaded generation.
   if not current() then
    if ok then disconnect(connection) end
    return
   end
   if not ok then
    stop("Stopped: hit subscription failed: "..tostring(connection))
    REPORT("Verified-hit subscription",connection);return
   end
   local validConnection,method=pcall(function() return connection and connection.Disconnect end)
   if not validConnection or type(method)~="function" then
    disconnect(connection)
    stop("Stopped: subscribe() must return a disconnectable connection.");return
   end
   S.sourceConnection=connection
   if rawget(_G,CFG.SourceName)~=source then stop("Stopped: adapter changed while connecting.");return end

   local _,localHumanoid=rig()
   if not localHumanoid or not S.model:IsDescendantOf(workspace)
    or not S.humanoid:IsDescendantOf(S.model) or S.humanoid.Health<=0
    or not S.root:IsDescendantOf(S.model) then
    stop("Stopped: character or target disappeared during startup.");return
   end
   local function watch(signal,callback)
    table.insert(S.connections,signal:Connect(function(...)
     if current() then callback(...) end
    end))
   end
   watch(S.humanoid.Died,function() stop("Target died - press/release 3 for another run.") end)
   watch(localHumanoid.Died,function() stop("Your character died - inputs released.") end)
   watch(S.model.AncestryChanged,function()
    if not S.model:IsDescendantOf(workspace) then stop("Target removed - inputs released.") end
   end)
   watch(S.humanoid.AncestryChanged,function()
    if not S.humanoid:IsDescendantOf(S.model) then stop("Target humanoid removed - inputs released.") end
   end)
   watch(S.root.AncestryChanged,function()
    if not S.root:IsDescendantOf(S.model) then stop("Target root removed - inputs released.") end
   end)
   S.stage="SETUP"
   say(("V%d ready on %s - only your verified hits continue the run."):format(S.version,target.name))
   tick()
  end

  local function launch()
   local ok,err=xpcall(start,TRACE)
   if not ok then
    stop("Stopped: activation error.")
    REPORT("Blackflash V2/V3 activation",err)
   end
  end
  local function pairInputInFlight()
   return S.stage=="FIRST_DOWN" or S.stage=="WAIT_SECOND" or S.stage=="SECOND_DOWN"
  end
  bindCapture=function()
   CAS:UnbindAction(ACTION)
   if not running or not(S.enabledV2 or S.enabledV3) or pairInputInFlight() then return end
   CAS:BindActionAtPriority(ACTION,function(_,state)
    if S.syntheticThree or (manualSequenceBusy and not S.active) then S.armed=false;return Enum.ContextActionResult.Pass end
    if typing() then S.armed=false;return Enum.ContextActionResult.Pass end
    if state==Enum.UserInputState.Begin then
     if not S.active then S.armed=true end
    elseif state==Enum.UserInputState.End then
     local armed=S.armed;S.armed=false
     if armed and not S.active then launch() end
    elseif state==Enum.UserInputState.Cancel then S.armed=false end
    return Enum.ContextActionResult.Sink
   end,false,4000,Enum.KeyCode.Three)
  end

  -- Consume the old script's macro bridge; it must not duplicate owned 3s.
  blackflashV2Trigger=function()
   if manualSequenceBusy and not S.active then S.armed=false;return true end
   if not(S.enabledV2 or S.enabledV3) and not S.active and not S.syntheticThree then return false end
   if not S.active and not S.syntheticThree and not typing() then S.armed=true end
   return true
  end
  connect(UIS.InputEnded,function(input)
   if input.KeyCode~=Enum.KeyCode.Three or S.syntheticThree then return end
   if manualSequenceBusy and not S.active then S.armed=false;return end
   if typing() then S.armed=false;return end
   local armed=S.armed;S.armed=false
   if armed and not S.active and(S.enabledV2 or S.enabledV3) then launch() end
  end)

  toggle(box2,"Blackflash Chain V2",function() return S.enabledV2 end,function(value)
   S.enabledV2=value
   if not value and S.active and S.version==2 then stop("V2 off") end
   feedback2.Text=value and "V2 ready - adapter required; press AND release 3" or "V2 off"
   bindCapture()
  end)
  toggle(box3,"Blackflash Chain V3",function() return S.enabledV3 end,function(value)
   S.enabledV3=value
   if not value and S.active and S.version==3 then stop("V3 off") end
   feedback3.Text=value and "V3 ready - adapter required; press AND release 3" or "V3 off"
   bindCapture()
  end)
  toggle(box2,"Include NPCs (shared V2/V3)",function() return S.includeNPCs end,function(value)
   S.includeNPCs=value
   if not value and S.active and S.model and not Players:GetPlayerFromCharacter(S.model) then
    stop("NPC targeting disabled - press/release 3 again.")
   end
  end)
  toggle(box2,"Optional front S + Q movement",function() return S.turnaround end,function(value) S.turnaround=value end)
  toggle(routeBox,"Route Calculator / Auto Side",function() return S.calculator end,function(value)
   S.calculator=value;S.route=nil
  end)
  make("TextLabel",box2,{Size=UDim2.new(1,0,0,156),BackgroundTransparency=1,
   Text="A real JJSVerifiedCombat adapter is mandatory. Four input pairs; only your attributed damaging hit unlocks the next pair. Animation and generic health changes do not count. Miss/timeout stops the run. Both 3 key-downs require >=75% estimated body-box volume behind the target and <=7 actual studs. S+Q never bypasses this rule. Follow-up stays 400 ms; there is no artificial between-repeat sleep. Game readiness still applies.",
   TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=10,LayoutOrder=nextOrder(box2)+2})
  make("TextLabel",box3,{Size=UDim2.new(1,0,0,104),BackgroundTransparency=1,
   Text="V3: four hit-confirmed pairs, then a body/range/readiness-checked LMB. LMB must also receive your attributed hit before the next cycle. No fixed cycle pause. Target stays locked for the run. Death, despawn, miss, lost focus or off releases inputs. Press AND release 3 for a new run. V3 takes priority when both enabled.",
   TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=10,LayoutOrder=nextOrder(box3)+2})
  make("TextLabel",routeBox,{Size=UDim2.new(1,0,0,112),BackgroundTransparency=1,
   Text="Side dash first: open 6-7 stud spacing where possible; walk/orbit during Q cooldown. Jump-over is only blocked/stuck recovery, with takeoff <=6 actual studs. Post-jump backoff >=5 remains. Eased movement and facing; fixed 300 ms dash hold, then smooth 80 degree camera flick. Route/body values are estimates, not server confirmations.",
   TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=10,LayoutOrder=nextOrder(routeBox)+2})

  connect(RS.Heartbeat,function() tick() end)
  local lastPreview=-math.huge
  connect(RS.Heartbeat,function()
   if not running or not gui.Parent or os.clock()-lastPreview<.25 then return end
   lastPreview=os.clock()
   local source=rawget(_G,CFG.SourceName)
   local configured=type(source)=="table" and type(source.subscribe)=="function" and type(source.isReady)=="function"
   local lines={configured and "Adapter configured (not automatically verified)" or "Adapter missing - attacks disabled"}
   if not S.active then
    table.insert(lines,"Hit-gate install self-tests: passed")
    table.insert(lines,"Enable V2/V3; press AND release 3")
   elseif S.root and S.root.Parent then
    local _,_,root=rig()
    table.insert(lines,("State: %s | pair %d/%d | cycle %d"):format(S.stage,S.pairCount,CFG.Repeats,S.cycleCount+1))
    if root then
     local offset=flat(root.Position-S.root.Position);local distance=offset.Magnitude
     table.insert(lines,("Body behind: %.1f%% / 75%% | distance: %.2f / 7"):format(bodyBehind(S.root)*100,(root.Position-S.root.Position).Magnitude))
     local route=S.route
     if route then
      table.insert(lines,("A: %.1f deg / ~%.2fs | %s"):format(route.left.degrees,route.left.eta,route.left.dashClear and "dash clear" or route.left.walkClear and "walk clear" or "blocked"))
      table.insert(lines,("D: %.1f deg / ~%.2fs | %s"):format(route.right.degrees,route.right.eta,route.right.dashClear and "dash clear" or route.right.walkClear and "walk clear" or "blocked"))
     end
    end
   end
   local text=table.concat(lines,string.char(10))
   if routeStatus.Text~=text then routeStatus.Text=text end
  end)

  local function cameraStep(dt)
   if gui:GetAttribute("MasterDashActive") or not S.active or S.stage=="CONNECTING" or typing() or not S.root or not S.root.Parent then return end
   local camera=workspace.CurrentCamera;if not camera then return end
   local desired=nil
   if S.mixFacing then
    desired=CFrame.lookAt(camera.CFrame.Position,camera.CFrame.Position+S.mixFacing).Rotation
   else
    local aim=S.root.Position+Vector3.new(0,1,0)
    if(aim-camera.CFrame.Position).Magnitude>.05 then desired=CFrame.lookAt(camera.CFrame.Position,aim).Rotation end
   end
   if desired then camera.CFrame=CFrame.new(camera.CFrame.Position)*camera.CFrame.Rotation:Lerp(desired,1-math.exp(-CFG.CameraResponse*dt)) end
  end
  local function facingStep(dt)
   if gui:GetAttribute("MasterDashActive") or not S.active or S.stage=="CONNECTING" or typing() or not S.root or not S.root.Parent then return end
   local _,humanoid,root=rig();if not humanoid then return end
   if S.ownedHumanoid~=humanoid then
    if S.ownedHumanoid and S.ownedHumanoid.Parent then S.ownedHumanoid.AutoRotate=S.oldAutoRotate end
    S.ownedHumanoid=humanoid;S.oldAutoRotate=humanoid.AutoRotate
   end
   humanoid.AutoRotate=false
   local offset=flat(root.Position-S.root.Position);local distance=offset.Magnitude
   local vector=S.desiredMove;local remaining=nil
   if S.moveMode=="backoff" then remaining=math.max(0,CFG.PostJumpAim-distance)
   elseif S.moveMode=="open" then remaining=math.max(0,CFG.SideAim-distance)
   elseif S.moveMode=="catchup" or S.moveMode=="approach" then
    local height=math.abs(root.Position.Y-S.root.Position.Y)
    local radius=S.moveMode=="approach" and CFG.JumpRange or CFG.AttackRange
    if height>=radius then vector=Vector3.zero;remaining=0
    else
     local goal=math.max(0,math.sqrt(math.max(0,radius*radius-height*height))-.15)
     remaining=math.max(0,distance-goal)
    end
   elseif S.moveMode=="jump" then
    local rear=unitOrZero(flat(S.root.CFrame.LookVector))
    local delta=flat(S.root.Position-rear*4-root.Position)
    vector=unitOrZero(delta);remaining=delta.Magnitude
   end
   if remaining then vector=vector*math.clamp(remaining/math.max(humanoid.WalkSpeed*math.max(dt,1/240),.01),0,1) end
   if S.moveMode=="idle" then S.smoothMove=Vector3.zero
   else S.smoothMove=S.smoothMove:Lerp(vector,1-math.exp(-CFG.MovementResponse*dt)) end
   if remaining and S.smoothMove.Magnitude>vector.Magnitude and S.smoothMove.Magnitude>.001 then
    S.smoothMove=S.smoothMove.Unit*vector.Magnitude
   end
   humanoid:Move(S.smoothMove,false)
   local aim=S.mixFacing and root.Position+S.mixFacing or Vector3.new(S.root.Position.X,root.Position.Y,S.root.Position.Z)
   if(aim-root.Position).Magnitude>.05 then
    local desired=CFrame.lookAt(root.Position,aim).Rotation
    root.CFrame=CFrame.new(root.Position)*root.CFrame.Rotation:Lerp(desired,1-math.exp(-CFG.MovementResponse*dt))
   end
  end
  local function guardedRender(callback)
   return function(dt)
    if not S.active then return end
    local ok,err=xpcall(function() callback(dt) end,TRACE)
    if not ok then stop("Stopped: rendering/movement error.");REPORT("Blackflash V2/V3 render",err) end
   end
  end
  RS:BindToRenderStep(CAMERA_BIND,Enum.RenderPriority.Camera.Value+2,guardedRender(cameraStep))
  RS:BindToRenderStep(FACING_BIND,Enum.RenderPriority.Character.Value+7,guardedRender(facingStep))

  connect(UIS.WindowFocusReleased,function()
   S.armed=false
   if S.active then stop("Window lost focus - inputs released. Press/release 3 again.") end
  end)
  connect(LP.CharacterRemoving,function()
   S.armed=false
   if S.active then stop("Your character removed - inputs released.") end
   disconnectList(S.partConnections);S.partsCharacter=nil;table.clear(S.parts);S.partsDirty=true
  end)
  local function shutdown()
   S.enabledV2=false;S.enabledV3=false;S.armed=false
   CAS:UnbindAction(ACTION);stop("Off")
   blackflashV2Trigger=nil
   disconnectList(S.partConnections);S.partsCharacter=nil;table.clear(S.parts)
   RS:UnbindFromRenderStep(CAMERA_BIND);RS:UnbindFromRenderStep(FACING_BIND)
  end
  connect(unload.Activated,shutdown);connect(gui.Destroying,shutdown)
  gui:SetAttribute("BlackflashChainV2Active",false)
  gui:SetAttribute("BlackflashChainV3Active",false)
  bindCapture()
 end

 local ok,err=xpcall(InstallModule,TRACE)
 if not ok then
  pcall(function()
   status.Text="Startup module failed: Blackflash V2/V3"
   gui:SetAttribute("JJS_LastModuleError",tostring(err))
  end)
  REPORT("Blackflash V2/V3",err)
 end
end

local function cleanup()
 if not running then return end
 running=false; enabled=false; todoEnabled=false; autoBlockEnabled=false; perfectClapEnabled=false; rmbJumpEnabled=false; pullEnabled=false; lockOn=false; chainEnabled=false; release()
 if blockKeyDown then setBlock(false) end
 RS:UnbindFromRenderStep(bind)
 for _,conn in ipairs(conns) do conn:Disconnect() end
 if gui.Parent then gui:Destroy() end
end
connect(gui.Destroying,cleanup)
connect(unload.Activated,cleanup)
connect(close.Activated,function() main.Visible=false end)
connect(UIS.InputBegan,function(i)
 if UIS:GetFocusedTextBox() then return end
 if i.KeyCode==Enum.KeyCode.RightShift then main.Visible=not main.Visible end
 if i.KeyCode==Enum.KeyCode.R and perfectClapEnabled and not busy and not manualSequenceBusy then
  task.spawn(runPerfectClap)
 end
 if i.UserInputType==Enum.UserInputType.MouseButton1 and rmbJumpEnabled and not busy and not todoBusy then
  local now=os.clock()
  if now-rmbLastClick>0.6 then rmbClicks=0 end
  rmbLastClick=now
  rmbClicks+=1
  if rmbClicks>=3 then
   rmbClicks=0
   local char=LP.Character
   local hum=char and char:FindFirstChildOfClass("Humanoid")
   if hum and hum.Health>0 then hum.Jump=true end
  end
 end
 if i.KeyCode==Enum.KeyCode.Three and blackflashV2Trigger and blackflashV2Trigger() then return end
 if i.KeyCode==Enum.KeyCode.Three and not busy then
  local now=os.clock()
  lastThreeTime=now
  if todoEnabled then task.spawn(runTodo); return end
  -- V1 owns the 3-key trigger when enabled. Starting the generic macro and
  -- V1 together races on the shared `busy` flag, so one sequence silently loses.
  if chainEnabled then
   if now>=chainCooldownUntil then task.spawn(runChain) end
   return
  end
  task.spawn(run)
 end
end)
local dragging,start,pos,touch
connect(top.InputBegan,function(i)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true; start=i.Position; pos=main.Position; touch=i end
end)
connect(UIS.InputEnded,function(i) if i==touch then dragging=false end end)
connect(UIS.InputChanged,function(i)
 if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i==touch) then local d=i.Position-start; main.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y) end
end)
connect(RS.Heartbeat,function()
 local cam=workspace.CurrentCamera
 if cam then scale.Scale=math.min(1,math.max(.25,math.min((cam.ViewportSize.X-24)/760,(cam.ViewportSize.Y-64)/540))) end
end)
status.Text="Default: 325 ms | Dash 6s | Side Dash 2s"

;(function()
 local holder=make("Frame",gui,{Name="SideNotifications",AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-16,.5,0),Size=UDim2.new(0,300,.8,0),BackgroundTransparency=1})
 make("UIListLayout",holder,{Padding=UDim.new(0,8),VerticalAlignment=Enum.VerticalAlignment.Center,SortOrder=Enum.SortOrder.LayoutOrder})
 local alive=true;local count=0;local cards,links,recent={},{},{};local watched=setmetatable({},{__mode="k"})
 local function listen(s,f) local c=s:Connect(f);table.insert(links,c) end
 local function notice(title,text,color)
  if not alive then return end;local key=title..text;local now=os.clock();if recent[key] and now-recent[key]<1.5 then return end;recent[key]=now
  while #cards>=5 do table.remove(cards,1):Destroy() end;count+=1
  local f=make("Frame",holder,{Size=UDim2.fromOffset(300,74),BackgroundColor3=T.card,BorderSizePixel=0,LayoutOrder=count});corner(f,8);make("UIStroke",f,{Color=color,Transparency=.3})
  make("TextLabel",f,{BackgroundTransparency=1,Position=UDim2.fromOffset(12,8),Size=UDim2.new(1,-24,0,18),Text=title,TextColor3=color,Font=Enum.Font.GothamBold,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
  make("TextLabel",f,{BackgroundTransparency=1,Position=UDim2.fromOffset(12,29),Size=UDim2.new(1,-24,0,36),Text=text,TextWrapped=true,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left});table.insert(cards,f)
  task.delay(3.5,function() if not alive then return end;local i=table.find(cards,f);if i then table.remove(cards,i) end;f:Destroy() end)
 end
 local function hook(o)
  if watched[o] or o:IsDescendantOf(holder) then return end;watched[o]=true
  if o:IsA("TextButton") and o.Text=="" then
   local label=o:FindFirstChildWhichIsA("TextLabel");local track=nil
   for _,child in ipairs(o:GetChildren()) do if child:IsA("Frame") and child.Size==UDim2.fromOffset(36,18) then track=child;break end end
   if label and track then listen(track:GetPropertyChangedSignal("BackgroundColor3"),function() local c=track.BackgroundColor3;local on=math.abs(c.R-T.acc.R)+math.abs(c.G-T.acc.G)+math.abs(c.B-T.acc.B)<.03;notice(on and "Enabled" or "Disabled",label.Text,on and T.ok or T.warn) end) end
  elseif o:IsA("TextLabel") then
   local last=o.Text;listen(o:GetPropertyChangedSignal("Text"),function()
    local text=o.Text;if text==last then return end;last=text;local s=text:lower()
    local err=s:find("failed",1,true) or s:find("unavailable",1,true) or s:find("error",1,true)
    local event=s:find("finished",1,true) or s:find("inputs sent",1,true) or s:find("cancelled",1,true) or s:find("playing:",1,true)
    if err or event then notice(err and "Notice" or "Activity",text,err and T.warn or T.acc) end
   end)
  end
 end
 for _,o in ipairs(gui:GetDescendants()) do hook(o) end
 listen(gui.DescendantAdded,function(o) task.defer(function() if alive and o.Parent then hook(o) end end) end)
 listen(gui.Destroying,function() alive=false;for _,c in ipairs(links) do c:Disconnect() end end)
 notice("Ready","Merged client ready: Gojo, Visuals and Yuji. V2/V3 require the verified combat adapter.",T.acc)
end)()

-- VISUALS: overlays only; cooldown HUD is input-estimated, not authoritative.
;(function()
 local esp,tracers,names,npcs,hudOn=false,false,true,false,true
 local alive,elapsed=true,0
 local records,links={},{}
 local overlay=make("ScreenGui",PG,{Name="JJSVisualOverlay",IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=50})
 local folder=make("Folder",gui,{Name="JJSVisualHighlights"})
 local function listen(signal,fn) local c=signal:Connect(fn);table.insert(links,c);return c end
 local panel=card(pages.Visuals,"ESP & Tracers","Player highlights, names, distance and optional NPCs");panel.LayoutOrder=-3
 toggle(panel,"ESP",function() return esp end,function(v) esp=v end)
 toggle(panel,"Tracers",function() return tracers end,function(v) tracers=v end)
 toggle(panel,"Names & Distance",function() return names end,function(v) names=v end)
 toggle(panel,"Include NPCs",function() return npcs end,function(v) npcs=v end)
 local hudBox=card(pages.Visuals,"Dash Cooldown HUD","Estimated: front/back 6s; side 2s. Q input or manual timer starts bars.");hudBox.LayoutOrder=-2
 toggle(hudBox,"Show Dash HUD",function() return hudOn end,function(v) hudOn=v end)
 make("TextLabel",hudBox,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text="Estimates only: blocked/rejected dashes and changed game cooldowns are not verified.",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=20})
 local hud=make("Frame",overlay,{AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-72),Size=UDim2.fromOffset(252,90),BackgroundColor3=T.panel,BackgroundTransparency=.1});corner(hud,10)
 make("TextLabel",hud,{Position=UDim2.fromOffset(10,5),Size=UDim2.new(1,-20,0,16),BackgroundTransparency=1,Text="DASH COOLDOWNS - ESTIMATED",TextColor3=T.dim,Font=Enum.Font.GothamBold,TextSize=10})
 local function bar(name,y)
  local label=make("TextLabel",hud,{Position=UDim2.fromOffset(12,y),Size=UDim2.new(1,-24,0,16),BackgroundTransparency=1,Text=name,TextColor3=T.ok,Font=Enum.Font.GothamMedium,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left})
  local track=make("Frame",hud,{Position=UDim2.fromOffset(12,y+18),Size=UDim2.new(1,-24,0,5),BackgroundColor3=T.p2,BorderSizePixel=0});corner(track,3)
  local fill=make("Frame",track,{Size=UDim2.fromScale(1,1),BackgroundColor3=T.ok,BorderSizePixel=0});corner(fill,3)
  return {label=label,fill=fill,name=name}
 end
 local front,sideBar=bar("Front / Back",23),bar("Side",54)
 local function paint(row,timer,total)
  local left=timer.remaining()
  row.label.Text=left>0 and string.format("%s  %.1fs",row.name,left) or row.name.."  READY"
  row.label.TextColor3=left>0 and T.warn or T.ok
  row.fill.Size=UDim2.fromScale(1-math.clamp(left/total,0,1),1);row.fill.BackgroundColor3=left>0 and T.acc or T.ok
 end
 local function remove(model)
  local item=records[model];if not item then return end
  item.highlight:Destroy();item.line:Destroy();item.label:Destroy();records[model]=nil
 end
 local function scan()
  local seen={}
  if esp or tracers then
   for hum in pairs(humanoids) do
    local model=hum.Parent
    if model and model:IsA("Model") and model~=LP.Character and model:IsDescendantOf(workspace) and hum.Health>0 then
     local player=Players:GetPlayerFromCharacter(model)
     if player or npcs then
      seen[model]=true
      if not records[model] then
       local color=player and Color3.fromRGB(110,190,255) or Color3.fromRGB(255,190,90)
       records[model]={hum=hum,player=player,
        highlight=make("Highlight",folder,{Adornee=model,Enabled=false,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,FillColor=color,OutlineColor=color,FillTransparency=.78,OutlineTransparency=.1}),
        line=make("Frame",overlay,{AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,BackgroundColor3=color,BackgroundTransparency=.2,Visible=false}),
        label=make("TextLabel",overlay,{AnchorPoint=Vector2.new(.5,1),Size=UDim2.fromOffset(220,20),BackgroundTransparency=1,TextColor3=color,TextStrokeTransparency=.35,Font=Enum.Font.GothamMedium,TextSize=12,Visible=false})}
      end
     end
    end
   end
  end
  local stale={};for model in pairs(records) do if not seen[model] then table.insert(stale,model) end end
  for _,model in ipairs(stale) do remove(model) end
 end
 listen(RS.RenderStepped,function(dt)
  if not alive then return end
  hud.Visible=hudOn;if hudOn then paint(front,dashTimer,6);paint(sideBar,sideTimer,2) end
  elapsed+=dt;if elapsed>=.25 then elapsed=0;scan() end
  local camera=workspace.CurrentCamera
  local character=LP.Character;local ownRoot=character and character:FindFirstChild("HumanoidRootPart")
  for model,item in pairs(records) do
   local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
   local valid=camera and root and root:IsA("BasePart") and model~=character and model:IsDescendantOf(workspace) and item.hum.Parent==model and item.hum.Health>0 and (item.player or npcs)
   item.highlight.Enabled=valid and esp or false;item.line.Visible=false;item.label.Visible=false
   if valid then
    local point,onScreen=camera:WorldToViewportPoint(root.Position)
    if onScreen and point.Z>0 then
     if tracers then
      local origin=Vector2.new(camera.ViewportSize.X*.5,camera.ViewportSize.Y-8);local dest=Vector2.new(point.X,point.Y);local delta=dest-origin
      item.line.Position=UDim2.fromOffset((origin.X+dest.X)*.5,(origin.Y+dest.Y)*.5);item.line.Size=UDim2.fromOffset(delta.Magnitude,1.5)
      item.line.Rotation=math.deg(math.atan2(delta.Y,delta.X));item.line.Visible=true
     end
     if esp and names then
      local head=model:FindFirstChild("Head");local pos,visible=camera:WorldToViewportPoint((head and head.Position or root.Position)+Vector3.new(0,2,0))
      if visible and pos.Z>0 then
       item.label.Text=(item.player and item.player.DisplayName or model.Name)..(ownRoot and string.format(" [%d studs]",math.floor((ownRoot.Position-root.Position).Magnitude+.5)) or "")
       item.label.Position=UDim2.fromOffset(pos.X,pos.Y);item.label.Visible=true
      end
     end
    end
   end
  end
 end)
 listen(UIS.InputBegan,function(input,processed)
  if processed or UIS:GetFocusedTextBox() or input.KeyCode~=Enum.KeyCode.Q then return end
  local char=LP.Character;local hum=char and char:FindFirstChildOfClass("Humanoid")
  if not hum or hum.Health<=0 then return end
  if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D) then sideTimer.start() else dashTimer.start() end
 end)
 local function cleanupVisuals()
  if not alive then return end;alive=false
  for _,c in ipairs(links) do c:Disconnect() end;table.clear(links)
  local stale={};for model in pairs(records) do table.insert(stale,model) end
  for _,model in ipairs(stale) do remove(model) end
  overlay:Destroy();folder:Destroy()
 end
 listen(unload.Activated,cleanupVisuals);listen(gui.Destroying,cleanupVisuals)
end)()

-- GOJO QUICK COMBO: geometry-gated, not hit-verified. Defaults are uncalibrated.
;(function()
 local enabled,active,binding=true,false,false
 local bindKey=Enum.KeyCode.H
 local generation=0
 local target,ownedHumanoid,oldRotate,oldLock,cameraRef,oldCameraType
 local aimMode="target"
 local held={};local mouseHeld=false
 local CFG={PunchesWait=1800,RedWait=550,BlueMinimum=500,LaunchTimeout=2400,TeleportWait=1000,M1Gap=320,KickWait=1000,JumpDelay=160,Range=6,AcquireRange=40,CloseTimeout=2000,KeyPulse=35}
 local panel=card(pages.Gojo,"Quick Combo","H: start/cancel | editable keybind | base Gojo")
 local info=make("TextLabel",panel,{Size=UDim2.new(1,0,0,64),BackgroundTransparency=1,Text="Idle. Timing defaults are estimates. Hits and ability readiness are not verified.",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[panel]=3
 local function cleanup(message)
  generation+=1
  local wasActive=active;active=false
  for code in pairs(held) do pcall(function() VIM:SendKeyEvent(false,code,false,game) end) end;table.clear(held)
  if mouseHeld then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end;mouseHeld=false
  if ownedHumanoid and ownedHumanoid.Parent then ownedHumanoid:Move(Vector3.zero,false);ownedHumanoid.AutoRotate=oldRotate end
  if cameraRef and oldCameraType then pcall(function() cameraRef.CameraType=oldCameraType end) end
  if wasActive then lockOn=oldLock;busy=false;manualSequenceBusy=false;gui:SetAttribute("GojoQuickComboActive",false) end
  ownedHumanoid=nil;target=nil;cameraRef=nil;oldCameraType=nil
  if info.Parent then info.Text=message or "Stopped" end
 end
 toggle(panel,"Enable Quick Combo",function() return enabled end,function(v) enabled=v;if not v then cleanup("Off") end end)
 local bindButton=make("TextButton",panel,{Size=UDim2.new(1,0,0,28),Text="Keybind: H (click to change)",BackgroundColor3=T.p2,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=nextOrder(panel)+2});corner(bindButton,6)
 connect(bindButton.Activated,function() cleanup("Choose a key; Escape cancels binding");binding=true;bindButton.Text="Press a key (Escape cancels)" end)
 local timing=card(pages.Gojo,"Quick Combo Timing","Uncalibrated waits, in milliseconds. Not measured animation durations.")
 for _,entry in ipairs({{"PunchesWait","3 to 2 wait",100,3500},{"RedWait","2 to 1 wait",50,2000},{"BlueMinimum","Minimum Blue wait",0,1800},{"LaunchTimeout","Launch timeout",500,4000},{"TeleportWait","R recovery wait",100,2000},{"M1Gap","Punch interval",100,650},{"KickWait","4 recovery wait",100,2500},{"JumpDelay","Jump to slam delay",50,400},{"CloseTimeout","Melee range timeout",200,4000}}) do
  local setting,label,minimum,maximum=entry[1],entry[2],entry[3],entry[4]
  moduleSlider(timing,label,minimum,maximum,CFG[setting]," ms",function() return CFG[setting] end,function(v) CFG[setting]=v end)
 end
 local function rigs()
  local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart")
  local th=target and target:FindFirstChildOfClass("Humanoid");local tr=target and target:FindFirstChild("HumanoidRootPart")
  return h,r,th,tr
 end
 local function valid(token)
  if not active or generation~=token or not running or not gui.Parent or UIS:GetFocusedTextBox() then return false end
  local h,r,th,tr=rigs()
  return h and r and th and tr and h==ownedHumanoid and h.Health>0 and th.Health>0 and target:IsDescendantOf(workspace)
 end
 local function waitFor(token,seconds,predicate)
  local deadline=os.clock()+seconds
  repeat
   if not valid(token) then error("cancelled / character unavailable",0) end
   if predicate and predicate() then return end
   if os.clock()>=deadline then if predicate then error("condition timed out; no further inputs",0) end;return end
   RS.Heartbeat:Wait()
  until false
 end
 local function pulse(token,code)
  if not valid(token) then error("cancelled",0) end
  held[code]=true;VIM:SendKeyEvent(true,code,false,game)
  waitFor(token,CFG.KeyPulse/1000)
  VIM:SendKeyEvent(false,code,false,game);held[code]=nil
 end
 local function closeEnough()
  local _,r,_,tr=rigs();return r and tr and (r.Position-tr.Position).Magnitude<=CFG.Range
 end
 local function click(token)
  waitFor(token,CFG.CloseTimeout/1000,closeEnough)
  mouseHeld=true;VIM:SendMouseButtonEvent(0,0,0,true,game,0)
  waitFor(token,CFG.KeyPulse/1000)
  VIM:SendMouseButtonEvent(0,0,0,false,game,0);mouseHeld=false
 end
 local function threeClicks(token)
  for index=1,3 do click(token);if index<3 then waitFor(token,math.max(0,CFG.M1Gap-CFG.KeyPulse)/1000) end end
 end
 local function chooseTarget()
  local c=LP.Character;local r=c and c:FindFirstChild("HumanoidRootPart");if not r then return end
  local nearest,distance=nil,CFG.AcquireRange
  for hum in pairs(humanoids) do
   local model=hum.Parent;local root=model and model:FindFirstChild("HumanoidRootPart")
   if model and model:IsA("Model") and model~=c and model:IsDescendantOf(workspace) and root and hum.Health>0 then
    local d=(root.Position-r.Position).Magnitude;if d<distance then nearest=model;distance=d end
   end
  end
  return nearest
 end
 local function launch()
  if active then cleanup("Cancelled");return end
  if not enabled or not okVIM then info.Text="Enable Quick Combo; input service required";return end
  if busy or todoBusy or manualSequenceBusy then info.Text="Another macro is active";return end
  target=chooseTarget();if not target then info.Text="No living target within 40 studs";return end
  local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
  if not h or h.Health<=0 then target=nil;return end
  generation+=1;local token=generation
  active=true;busy=true;manualSequenceBusy=true;gui:SetAttribute("GojoQuickComboActive",true)
  ownedHumanoid=h;oldRotate=h.AutoRotate;h.AutoRotate=false;h:Move(Vector3.zero,false)
  oldLock=lockOn;lockOn=false;cameraRef=workspace.CurrentCamera
  if cameraRef then oldCameraType=cameraRef.CameraType;cameraRef.CameraType=Enum.CameraType.Scriptable end
  aimMode="target"
  task.spawn(function()
   local ok,err=pcall(function()
    info.Text="Three opening punches"
    waitFor(token,CFG.CloseTimeout/1000,closeEnough);threeClicks(token)
    waitFor(token,math.max(0,CFG.M1Gap-CFG.KeyPulse)/1000)
    info.Text="Rapid Punches";pulse(token,Enum.KeyCode.Three);waitFor(token,CFG.PunchesWait/1000)
    info.Text="Reversal Red";pulse(token,Enum.KeyCode.Two);waitFor(token,CFG.RedWait/1000)
    info.Text="Lapse Blue; waiting for launch"
    local _,_,_,tr=rigs();local launchY=tr.Position.Y
    pulse(token,Enum.KeyCode.One);aimMode="up";waitFor(token,CFG.BlueMinimum/1000)
    waitFor(token,CFG.LaunchTimeout/1000,function()
     local _,_,th,root=rigs()
     return th.FloorMaterial==Enum.Material.Air and root.Position.Y>launchY+1.5 and root.AssemblyLinearVelocity.Y>1
    end)
    aimMode="target";RS.RenderStepped:Wait();waitFor(token,0)
    info.Text="Airborne target: Limitless";pulse(token,Enum.KeyCode.R);waitFor(token,CFG.TeleportWait/1000)
    info.Text="Waiting for melee range: three punches";threeClicks(token)
    waitFor(token,math.max(0,CFG.M1Gap-CFG.KeyPulse)/1000)
    info.Text="Twofold Kick";waitFor(token,CFG.CloseTimeout/1000,closeEnough);pulse(token,Enum.KeyCode.Four)
    waitFor(token,CFG.KickWait/1000);info.Text="Three more punches";threeClicks(token)
    info.Text="Jump > downslam";pulse(token,Enum.KeyCode.Space);waitFor(token,CFG.JumpDelay/1000)
    waitFor(token,.7,function() local hum=rigs();return hum.FloorMaterial==Enum.Material.Air end)
    aimMode="down";RS.RenderStepped:Wait();waitFor(token,0);click(token);waitFor(token,.15)
   end)
   if generation==token then cleanup(ok and "Inputs complete (hits not verified)" or "Stopped: "..tostring(err)) end
  end)
 end
 local renderName="JJSGojoQuickComboAim"
 RS:BindToRenderStep(renderName,Enum.RenderPriority.Camera.Value+10,function()
  if not active or gui:GetAttribute("MasterDashActive") then return end
  local ok,err=pcall(function()
   if not valid(generation) then cleanup("Stopped: focus/target/character changed");return end
   local _,root,_,tr=rigs();local camera=workspace.CurrentCamera
   if camera~=cameraRef then cleanup("Stopped: camera changed");return end
   local offset=Vector3.new(tr.Position.X-root.Position.X,0,tr.Position.Z-root.Position.Z)
   if offset.Magnitude>.01 then root.CFrame=CFrame.lookAt(root.Position,root.Position+offset) end
   if camera then
    local aim=tr.Position+Vector3.new(0,1,0)
    if aimMode=="up" then aim+=Vector3.new(0,12,0) elseif aimMode=="down" then aim=root.Position+offset*.3-Vector3.new(0,8,0) end
    if (aim-camera.CFrame.Position).Magnitude>.01 then camera.CFrame=CFrame.lookAt(camera.CFrame.Position,aim) end
   end
  end)
  if not ok then cleanup("Stopped: camera error");REPORT("Gojo camera",err) end
 end)
 local reserved={Three=true,Two=true,One=true,Four=true,R=true,Q=true,W=true,A=true,S=true,D=true,Space=true,Escape=true,Unknown=true,RightShift=true,K=true,L=true,B=true,N=true,X=true,G=true,J=true,F6=true,F7=true,F8=true}
 connect(UIS.InputBegan,function(input,processed)
  if input.UserInputType~=Enum.UserInputType.Keyboard or UIS:GetFocusedTextBox() then return end
  if binding then
   if input.KeyCode==Enum.KeyCode.Escape then binding=false
   elseif reserved[input.KeyCode.Name] then bindButton.Text="Reserved key - choose another";return
   else bindKey=input.KeyCode;binding=false end
   bindButton.Text="Keybind: "..bindKey.Name.." (click to change)";return
  end
  if active and input.KeyCode==Enum.KeyCode.Escape then cleanup("Cancelled");return end
  if not processed and input.KeyCode==bindKey then launch() end
 end)
 connect(UIS.WindowFocusReleased,function() if active then cleanup("Stopped: window lost focus") end end)
 connect(LP.CharacterRemoving,function() if active then cleanup("Stopped: respawn") end end)
 local function shutdown() enabled=false;binding=false;cleanup("Off");RS:UnbindFromRenderStep(renderName) end
 connect(unload.Activated,shutdown);connect(gui.Destroying,shutdown)
end)()

-- Added character modules. Local timing is a fallback, not measured recovery.
;(function()
 local function finite(x) return type(x)=="number" and x==x and x>-math.huge and x<math.huge end
 local BODY_NAMES={Head=true,Torso=true,UpperTorso=true,LowerTorso=true,
   ["Left Arm"]=true,["Right Arm"]=true,["Left Leg"]=true,["Right Leg"]=true,
   LeftUpperArm=true,LeftLowerArm=true,LeftHand=true,RightUpperArm=true,RightLowerArm=true,RightHand=true,
   LeftUpperLeg=true,LeftLowerLeg=true,LeftFoot=true,RightUpperLeg=true,RightLowerLeg=true,RightFoot=true}

 local function partRearFraction(part,origin,normal)
   local cf,size=part.CFrame,part.Size;local center=normal:Dot(cf.Position-origin);local widths={}
   for _,width in ipairs({math.abs(normal:Dot(cf.RightVector))*size.X,math.abs(normal:Dot(cf.UpVector))*size.Y,math.abs(normal:Dot(cf.LookVector))*size.Z}) do
    if width>.0001 then table.insert(widths,width) end
   end
   local count=#widths;local span=0
   for _,width in ipairs(widths) do span+=width*.5 end
   if center>=span then return 0 end
   if center<=-span then return 1 end
   if count==0 then return 0 end
   local total=0;local distance=span-center;local denominator=count==3 and 6 or count==2 and 2 or 1
   for _,width in ipairs(widths) do denominator*=width end
   for mask=0,2^count-1 do
    local shift,sign=0,1
    for index=1,count do
     if bit32.band(mask,bit32.lshift(1,index-1))~=0 then shift+=widths[index];sign=-sign end
    end
    total+=sign*math.max(distance-shift,0)^count
   end
   return math.clamp(total/denominator,0,1)
  end
  
 local function newHitGate(userId,clock)
   local gate={userId=userId,clock=clock,ticket=nil,used={},ring={},ringIndex=0}
   function gate:cancel()
    if self.ticket then self.ticket.closed=true end
    self.ticket=nil
   end
   function gate:begin(target,duration)
    self:cancel()
    local now=self.clock()
    self.ticket={target=target,openedAt=now,deadline=now+duration,hit=false,closed=false}
    return self.ticket
   end
   function gate:accept(event)
    local ticket=self.ticket
    if not ticket or ticket.closed or ticket.hit or type(event)~="table" or event.confirmed~=true then return false end
    local now=self.clock()
    if now>ticket.deadline or event.attackerUserId~=self.userId or event.targetModel~=ticket.target
     or not finite(event.damage) or event.damage<=0 or not finite(event.serverTime)
     or event.serverTime<ticket.openedAt or event.serverTime>ticket.deadline
     or event.serverTime>now+.15 then return false end
    local idType=type(event.hitId)
    if idType=="string" then
     if #event.hitId==0 or #event.hitId>128 then return false end
    elseif idType=="number" then
     if not finite(event.hitId) then return false end
    else return false end
    local key=idType..":"..tostring(event.hitId)
    if self.used[key] then return false end
    self.ringIndex=self.ringIndex%256+1
    local oldKey=self.ring[self.ringIndex]
    if oldKey then self.used[oldKey]=nil end
    self.ring[self.ringIndex]=key;self.used[key]=true
    ticket.hit=true;ticket.hitId=event.hitId
    return true
   end
   return gate
  end
  
 local bindingOwner=nil;local binds={H=true,G=true,J=true,F6=true,F7=true,F8=true}
 local reserved={One=true,Two=true,Three=true,Four=true,R=true,Q=true,W=true,A=true,S=true,D=true,F=true,Space=true,Unknown=true,RightShift=true,K=true,L=true,B=true,N=true,X=true}
 local function install(spec)
  local active,enabled=false,false;local gen=0;local bind=spec.bind
  local held={};local mouse=false;local model,hum,root,camera,oldCamera,oldRotate,oldLock
  local source,connection=nil,nil;local moveGoal=nil;local down=false;local side=Enum.KeyCode.D
  local gate=newHitGate(LP.UserId,function() return workspace:GetServerTimeNow() end)
  local cfg={Interval=spec.interval or 350,Pulse=35,M1Gap=320,CloseTimeout=2000,StrikesWait=1500,JumpToStrike=60,JumpTimeout=2000,FollowupDelay=400,HitTimeout=800,JumpDelay=160,CrushingWait=700,BlueMinimum=350,LaunchTimeout=2200,TeleportWait=850,KickWait=650,PunchesWait=1800,RedWait=550}
  local cooldownUntil={};local cds={[Enum.KeyCode.One]=13,[Enum.KeyCode.Two]=20,[Enum.KeyCode.Three]=15,[Enum.KeyCode.Four]=18,[Enum.KeyCode.R]=15}
  local panel=card(pages[spec.page],spec.name,spec.description);panel.LayoutOrder=spec.order
  local info=make("TextLabel",panel,{Size=UDim2.new(1,0,0,64),BackgroundTransparency=1,Text=spec.note,TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[panel]=3
  local function stop(message)
   gen+=1;local was=active;active=false;moveGoal=nil;gate:cancel();source=nil
   if connection then pcall(function() connection:Disconnect() end) end;connection=nil
   for k in pairs(held) do pcall(function() VIM:SendKeyEvent(false,k,false,game) end) end;table.clear(held)
   if mouse then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end;mouse=false
   if not spec.pair then
    if hum and hum.Parent then hum:Move(Vector3.zero,false);hum.AutoRotate=oldRotate end
    if camera and oldCamera then pcall(function() camera.CameraType=oldCamera end) end
    if was then lockOn=oldLock end
   end
   if was then busy=false;manualSequenceBusy=false;gui:SetAttribute("MasterMacroActive",false) end
   model=nil;hum=nil;root=nil;camera=nil
   if info.Parent then info.Text=message or "Stopped" end
   if message then gui:SetAttribute("MasterLastStatus",spec.name..": "..message) end
  end
  toggle(panel,"Enable "..spec.name,function() return enabled end,function(v) enabled=v;if not v then stop("Off") end end)
  local binding=make("TextButton",panel,{Size=UDim2.new(1,0,0,28),Text="Keybind: "..bind.Name.." (click to change)",BackgroundColor3=T.p2,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=nextOrder(panel)+2});corner(binding,6)
  connect(binding.Activated,function() if bindingOwner and bindingOwner~=spec then return end;stop("Choose a key; Escape cancels");bindingOwner=spec;binding.Text="Press a key" end)
  local settings=card(pages[spec.page],spec.name.." Settings","Timing fallback is uncalibrated. Dash/flick settings are fixed.");settings.LayoutOrder=spec.order+1;settings:SetAttribute("MasterSettingsOwner",spec.name)
  local names=spec.pair and {"Interval","Pulse"} or spec.kind=="yuji" and {"M1Gap","JumpToStrike","StrikesWait","JumpTimeout","FollowupDelay","HitTimeout","JumpDelay","CrushingWait","CloseTimeout"} or {"M1Gap","BlueMinimum","LaunchTimeout","TeleportWait","KickWait","PunchesWait","RedWait","CloseTimeout"}
  for _,key in ipairs(names) do local k=key;moduleSlider(settings,k,20,4000,cfg[k]," ms",function() return cfg[k] end,function(v) cfg[k]=v end) end
  if spec.kind=="advanced" then
   local b=make("TextButton",settings,{Size=UDim2.new(1,0,0,28),Text="Side: D (right)",BackgroundColor3=T.p2,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,LayoutOrder=nextOrder(settings)+2})
   connect(b.Activated,function() if active then return end;side=side==Enum.KeyCode.D and Enum.KeyCode.A or Enum.KeyCode.D;b.Text=side==Enum.KeyCode.D and "Side: D (right)" or "Side: A (left)" end)
  end
  local function targetRig() return model and model:FindFirstChildOfClass("Humanoid"),model and model:FindFirstChild("HumanoidRootPart") end
  local function valid(token)
   if not active or gen~=token or not running or not gui.Parent or UIS:GetFocusedTextBox() or not hum or not hum.Parent or hum.Health<=0 or LP.Character~=hum.Parent then return false end
   if spec.pair then return true end
   local th,tr=targetRig();return th and tr and th.Health>0 and model:IsDescendantOf(workspace)
  end
  local function waitFor(token,seconds,predicate)
   local deadline=os.clock()+seconds
   repeat
    if not valid(token) then error("cancelled / character unavailable",0) end
    if predicate and predicate() then return end
    if os.clock()>=deadline then if predicate then error("condition timed out; no further input",0) end;return end
    RS.Heartbeat:Wait()
   until false
  end
  local function actionReady(token,key)
   local adapter=rawget(_G,"JJSActionFeedback")
   if type(adapter)~="table" or type(adapter.isReady)~="function" then return end
   waitFor(token,cfg.CloseTimeout/1000,function()
    local ok,result=pcall(adapter.isReady,spec.character,key.Name,model)
    if not valid(token) or rawget(_G,"JJSActionFeedback")~=adapter then error("readiness lifecycle changed",0) end
    if not ok then error("action readiness adapter failed",0) end
    return result==true
   end)
  end
  local function pulse(token,key)
   if not valid(token) then error("cancelled",0) end
   if key~=Enum.KeyCode.Space and not(spec.kind=="yuji" and key==Enum.KeyCode.Three) then actionReady(token,key) end
   if spec.kind=="advanced" and cds[key] then
    if os.clock()<(cooldownUntil[key] or 0) then error("estimated cooldown: "..key.Name,0) end
    cooldownUntil[key]=os.clock()+cds[key]
   end
   gui:SetAttribute("MasterLastAction",spec.name..": "..key.Name)
   held[key]=true;VIM:SendKeyEvent(true,key,false,game);waitFor(token,cfg.Pulse/1000);VIM:SendKeyEvent(false,key,false,game);held[key]=nil
  end
  local function closeEnough() local _,tr=targetRig();return root and tr and (root.Position-tr.Position).Magnitude<=6 end
  local function click(token)
   waitFor(token,cfg.CloseTimeout/1000,closeEnough)
   mouse=true;VIM:SendMouseButtonEvent(0,0,0,true,game,0);waitFor(token,cfg.Pulse/1000);VIM:SendMouseButtonEvent(0,0,0,false,game,0);mouse=false
  end
  local function three(token) for i=1,3 do click(token);if i<3 then waitFor(token,math.max(0,cfg.M1Gap-cfg.Pulse)/1000) end end end
  local function rearReady()
   local _,tr=targetRig();if not tr or (root.Position-tr.Position).Magnitude>7 then return false end
   local normal=Vector3.new(tr.CFrame.LookVector.X,0,tr.CFrame.LookVector.Z);if normal.Magnitude<.001 then return false end;normal=normal.Unit
   if normal:Dot(root.Position-tr.Position)>=0 then return false end
   local total,behind=0,0
   for _,p in ipairs(LP.Character:GetChildren()) do if p:IsA("BasePart") and BODY_NAMES[p.Name] then local volume=p.Size.X*p.Size.Y*p.Size.Z;total+=volume;behind+=volume*partRearFraction(p,tr.Position,normal) end end
   return total>0 and behind/total>=.75
  end
  local function connectCombat(token)
   source=rawget(_G,"JJSVerifiedCombat")
   if type(source)~="table" or type(source.subscribe)~="function" or type(source.isReady)~="function" then error("BLOCKED: configure real JJSVerifiedCombat adapter first",0) end

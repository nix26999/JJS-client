  if needPostJumpBackoff then if d<POST_JUMP_MIN then move("postJumpBackoff",offset.Magnitude>.01 and offset.Unit or Vector3.new(0,0,1));return else needPostJumpBackoff=false;if phase=="postJumpBackoff" then releasePositioning() end end end

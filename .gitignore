-- Shared V2/V3 engine; turnaround S+Q variant starts only from the target's front.
do
 local CAS=game:GetService("ContextActionService")
 local enabledV2,enabledV3,active=false,false,false;local runVersion=2
 local V3_FIXED={Turn=75,CameraHold=200,RepeatGap=340,JumpLead=35,CycleWait=300}
 local includeNPCsV2=false;local turnaroundMixups=false;local calculatorEnabled=true;local autoCameraAngle=false
 local generation=0;local held={};local mouseDown=false;local targetRoot=nil;local ownedHumanoid,previousAutoRotate=nil,nil
 local repeatGapMs,jumpLeadMs,cameraFlickHoldMs=250,120,250;local postDashTurnDegrees=90;local blackflashPrefireMs=200
 local SIDE_MIN,CATCHUP_DISTANCE,ATTACK_MIN,ATTACK_MAX=6,7,2,6;local ATTACK_CENTER=4
 local POST_JUMP_MIN,POST_JUMP_AIM=5,5.25;local needPostJumpBackoff=false
 local nextDash=0;local phase="idle";local steering=Vector3.zero;local mixFacing=Vector3.zero;local strafeKey=Enum.KeyCode.D
 local flickUntil=0;local flickRotation=nil;local flickNavigationRight=Vector3.zero
 local lockSuppressed=false;local borrowedLock=false;local previousLockOn=false
 local frontSequenceArmed=false;local frontSequenceModel=nil
 local fightModel,fightHumanoid=nil,nil;local fightLinks={};local suppressStartUntil=0
 local targetCacheAt=-math.huge;local targetCacheReady=false;local cachedCandidate,cachedRoot=nil,nil;local routeCache=nil
 local sharedParams=nil;local paramsModel,paramsCharacter=nil,nil
 local MOVE_KEYS={Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D};local PAUSED_FOR_TYPING={}
 local action="JJSBlackflashV2Activate";local cameraBind,faceBind="JJSBlackflashV2Camera","JJSBlackflashV2Facing"
 local box=card(pages["Auto Blackflash"],"Blackflash Chain V2","Press 3 | 3 Black Flash sequences, then LMB and stop")
 local feedback=make("TextLabel",box,{Size=UDim2.new(1,0,0,64),BackgroundTransparency=1,Text="Off - enable V2 and press 3",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[box]=3
 local boxV3=card(pages["Auto Blackflash"],"Blackflash Chain V3","Press 3 | 3 Black Flash sequences > wait 300 ms > LMB > loop until target dies")
 local feedbackV3=make("TextLabel",boxV3,{Size=UDim2.new(1,0,0,64),BackgroundTransparency=1,Text="Off - enable V3 and press 3; V3 takes priority if both are enabled",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[boxV3]=3
 local calcBox=card(pages["Auto Blackflash"],"V2 / V3 Route Calculator","Cached left/right orbit, obstacle and ETA estimates")
 local calcStatus=make("TextLabel",calcBox,{Size=UDim2.new(1,0,0,106),BackgroundTransparency=1,Text="Waiting for a live target",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3});ord[calcBox]=3
 gui:SetAttribute("BlackflashChainV2Active",false);gui:SetAttribute("BlackflashChainV3Active",false)
 local start,bindCapture,stop,stopForDefeat

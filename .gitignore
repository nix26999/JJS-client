  local now=os.clock()
  if not force and targetCacheReady and now-targetCacheAt<1/30 then if not cachedCandidate then return nil end;if cachedRoot and cachedRoot.Parent and cachedCandidate.Humanoid.Health>0 and cachedCandidate.Model:IsDescendantOf(workspace) then return cachedCandidate,cachedRoot end end
  local best,bestRoot,bestDistance=nil,nil,math.huge
  for hum in pairs(humanoids) do local model=hum.Parent
   if hum.Health>0 and model and model:IsA("Model") and model~=LP.Character and model:IsDescendantOf(workspace) then local owner=Players:GetPlayerFromCharacter(model)
    if owner~=LP and(owner or includeNPCsV2) then local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart;if root and root:IsA("BasePart") then local d=(root.Position-r.Position).Magnitude;if d<bestDistance then best={DisplayName=owner and owner.DisplayName or model.Name,IsNPC=owner==nil,Model=model,Humanoid=hum};bestRoot=root;bestDistance=d end end end
   end
  end

  local pre=math.max(0,(setting("Prefire") or 200)/1000)
  local behind = early and (willBeBehindSoon(tr, pre) or approachingRear(tr) or rearSide(tr)) or rearSide(tr)
  if not behind and not authorizedFrontVariant(tr) then return false end

   for i=1,count do local theta=angle*turn*i/count;local c,s=math.cos(theta),math.sin(theta);local point=Vector3.new(tr.Position.X+(unit.X*c+unit.Z*s)*radius,r.Position.Y,tr.Position.Z+(-unit.X*s+unit.Z*c)*radius);local delta=point-previous

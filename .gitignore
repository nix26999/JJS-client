  local total,behind=0,0
  for _,part in ipairs(char:GetChildren()) do if part:IsA("BasePart") and BODY_NAMES[part.Name] then local volume=part.Size.X*part.Size.Y*part.Size.Z;total+=volume;behind+=volume*partRearFraction(part,tr.Position,normal) end end
  local fraction=total>0 and behind/total or 0

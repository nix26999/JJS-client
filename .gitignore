 local function bodyBehindFraction(tr,fresh)
  local h,r=rig();local char=LP.Character;if not h or not tr or not tr.Parent or not char then return 0 end
  local normal=flat(tr.CFrame.LookVector);if normal.Magnitude<.01 then return 0 end;normal=normal.Unit
  local now=os.clock()

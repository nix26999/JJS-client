 for _,s in ipairs({{"M1 spacing",150,650,"punchGap"},{"After uppercut",0,600,"afterUppercut"},{"After Cursed Strikes",500,3500,"afterStrikes"},{"After second 3 M1s",0,800,"afterSecondM1s"},{"Black Flash second tap",150,700,"blackFlashDelay"},{"After Black Flash",100,1200,"afterBlackFlash"},{"Aerial jump lead",35,400,"aerialLead"}}) do local name=s[4];moduleSlider(box,s[1],s[2],s[3],math.floor(timings[name]*1000+.5)," ms",function() return timings[name]*1000 end,function(v) timings[name]=v/1000 end) end

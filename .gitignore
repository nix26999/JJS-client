local function toggle(p,name,get,set)
 local b=make("TextButton",p,{Text="",Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,LayoutOrder=order(p)+2})
 text(b,name,nil,UDim2.new(1,-55,1,0),12);local state=text(b,"OFF",UDim2.new(1,-48,0,0),UDim2.fromOffset(48,30),11)
 local function paint() state.Text=get() and "ON" or "OFF";state.TextColor3=get() and T.acc or T.mut end
 connect(b.Activated,function() set(not get());paint() end);paint();return paint
end

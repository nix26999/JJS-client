selectPage=function(name,clear) if not pages[name] then return end;selected=name;if clear then search.Text="" end;if filter then filter() end end
filter=function()
 local q=string.lower(search.Text):match("^%s*(.-)%s*$");local matches={};local any=false
 for _,cat in ipairs(cats) do local name=cat[1];local category=q~="" and (string.find(string.lower(name),q,1,true) or string.find(string.lower(cat[2]),q,1,true));local found=not not category
  for item,s in pairs(sections) do if s.page==name then local match=q=="" or category or string.find(s.query,q,1,true);item.Visible=not not match;if match then found=true end end end
  matches[name]=found;if found then any=true end
 end
 if q~="" and not matches[selected] then for _,cat in ipairs(cats) do if matches[cat[1]] then selected=cat[1];break end end end
 for _,cat in ipairs(cats) do local name=cat[1];local on=selected==name;pages[name].Visible=on;buttons[name].BackgroundTransparency=on and 0 or 1;if on then title.Text=name;desc.Text=cat[2] end end;empty.Visible=q~="" and not any
end
connect(search:GetPropertyChangedSignal("Text"),filter);filter()
local drag
local function clampWindow()
 local size=root.AbsoluteSize;local ws=main.AbsoluteSize;if size.X<=0 or size.Y<=0 then return end
 local p=main.AbsolutePosition-root.AbsolutePosition;main.Position=UDim2.fromOffset(math.clamp(p.X,0,math.max(0,size.X-ws.X))+ws.X*.5,math.clamp(p.Y,0,math.max(0,size.Y-ws.Y))+ws.Y*.5)
end
local function fit() local size=root.AbsoluteSize;if size.X<=0 or size.Y<=0 then return end;scale.Scale=math.max(.05,math.min(1,size.X/760,size.Y/540));clampWindow();reflowPopups();task.defer(function() if running then clampWindow() end end) end
connect(root:GetPropertyChangedSignal("AbsoluteSize"),fit)
connect(top.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag={input=i,start=Vector2.new(i.Position.X,i.Position.Y),origin=main.AbsolutePosition-root.AbsolutePosition} end end)
connect(UIS.InputChanged,function(i) if not drag or (i.UserInputType~=Enum.UserInputType.MouseMovement and i~=drag.input) then return end;local delta=Vector2.new(i.Position.X,i.Position.Y)-drag.start;local p=drag.origin+delta;local ws=main.AbsoluteSize;main.Position=UDim2.fromOffset(p.X+ws.X*.5,p.Y+ws.Y*.5);clampWindow() end)
connect(UIS.InputEnded,function(i) if drag and i==drag.input then drag=nil end end);connect(UIS.WindowFocusReleased,function() drag=nil end);fit()
-- Optimized audio controller, integrated. No per-voice full-game scans or sound tweens.
do
 local DUCK_MULTIPLIER,ATTACK,RELEASE=.12,.08,.30
 local INDEX_BUDGET_SECONDS,MAX_INDEX_STEPS,MAX_VOLUME_WRITES=.001,64,32
 local audioAlive,ducking=true,false
 local links,records,playingAmbient,voices,transitions={},{},{},{},{}
 local stack={{object=game}}
 local event=Instance.new("BindableEvent");event.Name="AudioDuckingShutdown";event.Parent=gui
 local function audioConnect(signal,callback) local c=signal:Connect(callback);table.insert(links,c);return c end
 local function supported(o) return o:IsA("Sound") or o:IsA("AudioPlayer") end
 local function isVoice(o) return o:IsA("Sound") and o.Name=="AutoBlackflashStreakVoice" and o:IsDescendantOf(SoundService) end
 local function volume(o) local ok,v=pcall(function() return o.Volume end);return ok and v or nil end
 local function playing(o) local ok,v=pcall(function() return o.IsPlaying end);return ok and v==true end
 local function write(o,v) return pcall(function() o.Volume=v end) end
 local function restoreImmediate(o,r) transitions[o]=nil;if r.ducked and r.original~=nil then write(o,r.original) end;r.ducked=false;r.original=nil end
 local function transition(o,r,target,seconds,restoring) local v=volume(o);if v==nil then return end;transitions[o]={from=v,to=target,start=os.clock(),duration=seconds,restoring=restoring,record=r} end
 local function duckOne(o,r,immediate)
  if not r.ducked then local v=volume(o);if v==nil then return end;r.original=v;r.ducked=true end
  local target=r.original*DUCK_MULTIPLIER;if immediate then transitions[o]=nil;write(o,target) else transition(o,r,target,ATTACK,false) end
 end
 local function refreshVoices()
  if not audioAlive then return end;local any=false;for o,active in pairs(voices) do if o.Parent and active then any=true;break end end
  if any==ducking then return end;ducking=any;gui:SetAttribute("PopupAudioDuckingActive",ducking)
  if ducking then for o in pairs(playingAmbient) do local r=records[o];if r and o.Parent then duckOne(o,r,false) end end
  else for o,r in pairs(records) do if r.ducked and r.original~=nil then if r.playing then transition(o,r,r.original,RELEASE,true) else restoreImmediate(o,r) end end end end
 end
 local function forget(o)
  local r=records[o];if not r then return end;if r.playConnection then r.playConnection:Disconnect() end;if r.destroyConnection then r.destroyConnection:Disconnect() end
  restoreImmediate(o,r);records[o]=nil;playingAmbient[o]=nil;local wasVoice=voices[o]~=nil;voices[o]=nil;if wasVoice then refreshVoices() end
 end
 local function observe(o)
  if not audioAlive or records[o] or not supported(o) or volume(o)==nil then return end
  local r={voice=isVoice(o),playing=false,ducked=false};records[o]=r;if r.voice then write(o,VOICE_VOLUME);voices[o]=false end
  local function changed()
   if not audioAlive or records[o]~=r then return end;local active=playing(o);r.playing=active
   if r.voice then voices[o]=active;refreshVoices() elseif active then playingAmbient[o]=true;if ducking then duckOne(o,r,true) end else playingAmbient[o]=nil;restoreImmediate(o,r) end
  end
  local ok,c=pcall(function() return o:GetPropertyChangedSignal("IsPlaying"):Connect(changed) end);if ok then r.playConnection=c end
  r.destroyConnection=o.Destroying:Connect(function() forget(o) end);changed()
 end
 local function audioCleanup()
  if not audioAlive then return end;audioAlive=false;for _,c in ipairs(links) do c:Disconnect() end
  for o,r in pairs(records) do if r.playConnection then r.playConnection:Disconnect() end;if r.destroyConnection then r.destroyConnection:Disconnect() end;restoreImmediate(o,r) end
  table.clear(records);table.clear(playingAmbient);table.clear(voices);table.clear(transitions);table.clear(stack)
  pcall(function() gui:SetAttribute("PopupAudioDuckingActive",false) end);if event.Parent then event:Destroy() end
 end
 audioConnect(event.Event,audioCleanup);audioConnect(gui.Destroying,audioCleanup)
 audioConnect(game.DescendantAdded,function(o) if supported(o) then observe(o);task.defer(function() if audioAlive and o.Parent then observe(o) end end) end end)
 audioConnect(game.DescendantRemoving,function(o) if records[o] then forget(o) end end)
 local voicePoll=0
 audioConnect(RS.Heartbeat,function(dt)
  if not audioAlive then return end;local begun=os.clock();local steps=0
  while #stack>0 and steps<MAX_INDEX_STEPS and os.clock()-begun<INDEX_BUDGET_SECONDS do
   steps+=1;local node=stack[#stack]
   if not node.children then if supported(node.object) then observe(node.object) end;local ok,children=pcall(function() return node.object:GetChildren() end);node.children=ok and children or {};node.index=1 end
   local child=node.children[node.index];if child then node.index+=1;if child.Parent then table.insert(stack,{object=child}) end else table.remove(stack) end
  end
  if #stack==0 and gui:GetAttribute("AudioCacheReady")~=true then gui:SetAttribute("AudioCacheReady",true) end
  local now=os.clock();local writes=0
  for o,t in pairs(transitions) do
   if writes>=MAX_VOLUME_WRITES then break end;writes+=1
   if not o.Parent or records[o]~=t.record then transitions[o]=nil
   else local p=math.clamp((now-t.start)/t.duration,0,1);local eased=1-(1-p)*(1-p);write(o,t.from+(t.to-t.from)*eased);if p>=1 then transitions[o]=nil;if t.restoring and not ducking then t.record.ducked=false;t.record.original=nil end end end
  end
  voicePoll+=dt;if voicePoll>=.1 then voicePoll=0;for o in pairs(voices) do if o.Parent then voices[o]=playing(o) end end;refreshVoices() end
 end)
 gui:SetAttribute("PopupVoiceVolume",VOICE_VOLUME);gui:SetAttribute("GameAudioDuckMultiplier",DUCK_MULTIPLIER);gui:SetAttribute("AudioCacheReady",false);gui:SetAttribute("AudioControllerMode","CACHED_ACTIVE_ONLY_BOUNDED")
 for _,o in ipairs(SoundService:GetChildren()) do if supported(o) then observe(o) end end
end


-- =============================================================================
-- IMPROVEMENTS PASS (auto, 5m)
-- - safer unload / double-load guard
-- - status HUD strip
-- - keybind help overlay (RightShift still toggles menu)
-- - stricter focus / textbox guards already present; reinforced
-- - soft performance: throttle heavy Heartbeat work when menu hidden
-- - clear attribute bus for external tools
-- =============================================================================

do
  if not gui or not gui.Parent then return end

  -- Status strip under the window
  local statusStrip = make("Frame", root, {
    Name = "StatusStrip",
    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.new(0.5, 0, 0, 8),
    Size = UDim2.fromOffset(420, 22),
    BackgroundColor3 = T.panel,
    BorderSizePixel = 0,
    ZIndex = 50,
  })
  corner(statusStrip, 6)
  make("UIStroke", statusStrip, {Color = T.stroke, Thickness = 1})
  local statusText = make("TextLabel", statusStrip, {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Text = "JJS · Ready · 3 = chain/macro · RightShift = menu",
    TextColor3 = T.mut,
    Font = Enum.Font.Gotham,
    TextSize = 11,
    TextXAlignment = Enum.TextXAlignment.Center,
  })

  local function setStatus(msg)
    if statusText and statusText.Parent then
      statusText.Text = tostring(msg)
    end
    pcall(function() gui:SetAttribute("StatusMessage", tostring(msg)) end)
  end
  setStatus("JJS · Ready · 3 = chain/macro · RightShift = menu")

  -- Attribute bus for other tools / debug
  pcall(function()
    gui:SetAttribute("ScriptBuild", "COMBINED-IMPROVED")
    gui:SetAttribute("NoDashTimers", true)
    gui:SetAttribute("BlackflashDelayMs", 350)
  end)

  -- Help overlay (toggle with H while menu open)
  local help = make("Frame", root, {
    Name = "HelpOverlay",
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(360, 220),
    BackgroundColor3 = T.bg,
    BorderSizePixel = 0,
    Visible = false,
    ZIndex = 200,
  })
  corner(help, 10)
  make("UIStroke", help, {Color = T.acc, Thickness = 1})
  make("TextLabel", help, {
    Size = UDim2.new(1, -24, 1, -24),
    Position = UDim2.fromOffset(12, 12),
    BackgroundTransparency = 1,
    Text = "CONTROLS\n\n3  — Black Flash macro / rear chain\nRightShift — show/hide menu\nH — this help\n\nChain needs target within ~8 studs,\nbehind + grounded (200ms stable).\nFollow-up window ~325–400 ms.\n\nUnload from Settings or destroy GUI.",
    TextColor3 = T.txt,
    Font = Enum.Font.Gotham,
    TextSize = 13,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top,
    TextWrapped = true,
  })

  connect(UIS.InputBegan, function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.H and main.Visible then
      help.Visible = not help.Visible
    end
  end)

  -- Throttle: when menu hidden, skip some UI-only work (status still updates lightly)
  local lastStatusPulse = 0
  connect(RS.Heartbeat, function()
    if not running or not gui.Parent then return end
    local now = os.clock()
    if now - lastStatusPulse < 0.35 then return end
    lastStatusPulse = now
    local mode = (chainEnabled and "CHAIN") or (macroEnabled and "MACRO") or "OFF"
    local focus = focused and "focus" or "unfocused"
    setStatus(string.format("JJS · %s · %s · 3 ready", mode, focus))
  end)

  -- Safer re-entry: if Shutdown exists, fire it before we would have been replaced
  -- (already handled at top of main script via previous:Destroy pattern)

  -- Quick quality-of-life: click status strip to flash current delay attribute
  statusStrip.Active = true
  connect(statusStrip.InputBegan, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
      local d = gui:GetAttribute("LastBlackflashPairGapMs") or gui:GetAttribute("BlackflashDelayMs") or 350
      setStatus(string.format("Last/configured gap: %s ms", tostring(d)))
    end
  end)
end


-- =============================================================================
-- CONTINUOUS IMPROVE BATCH 1
-- =============================================================================
do
  if not gui or not gui.Parent then return end

  -- Double-load soft lock: mark instance id
  local instanceId = tostring(os.clock()) .. "-" .. tostring(math.random(1000,9999))
  pcall(function() gui:SetAttribute("InstanceId", instanceId) end)

  -- Scale limits so tiny viewports don't crush UI
  if scale then
    connect(RS.Heartbeat, function()
      if not running or not gui.Parent then return end
      if scale.Scale < 0.35 then scale.Scale = 0.35 end
      if scale.Scale > 1.25 then scale.Scale = 1.25 end
    end)
  end

  -- Failsafe: if main window somehow nil-parented, try recover visibility
  connect(RS.Heartbeat, function()
    if not running then return end
    if main and not main.Parent and gui.Parent then
      pcall(function() main.Parent = root or gui end)
    end
  end)
end


-- =============================================================================
-- CONTINUOUS IMPROVE BATCH 2 — search UX
-- =============================================================================
do
  if not search or not empty then return end
  -- Placeholder clarity
  pcall(function()
    search.PlaceholderText = "Search modules, categories..."
  end)
  -- Debounced empty label (avoid flicker)
  local lastQ = ""
  connect(search:GetPropertyChangedSignal("Text"), function()
    local q = string.lower(search.Text or ""):match("^%s*(.-)%s*$") or ""
    if q == lastQ then return end
    lastQ = q
    if empty then
      empty.Text = q == "" and "" or ("No match for \"" .. q .. "\"")
    end
  end)
end


-- =============================================================================
-- CONTINUOUS IMPROVE BATCH 3 — feedback attributes for tuning
-- =============================================================================
do
  if not gui then return end
  pcall(function()
    gui:SetAttribute("RearGateStuds", 8)
    gui:SetAttribute("RearStableMs", 200)
    gui:SetAttribute("PairWindowMinMs", 325)
    gui:SetAttribute("PairWindowMaxMs", 400)
    gui:SetAttribute("FollowUpDelayMs", 350)
  end)
  -- Pulse a simple debug line into status when chain attributes update
  if gui.GetAttributeChangedSignal then
    pcall(function()
      connect(gui:GetAttributeChangedSignal("LastBlackflashPairGapMs"), function()
        local g = gui:GetAttribute("LastBlackflashPairGapMs")
        if g and statusText then
          statusText.Text = string.format("Pair gap: %.0f ms", tonumber(g) or 0)
        end
      end)
    end)
  end
end


-- =============================================================================
-- CONTINUOUS IMPROVE BATCH 4 — reopen chip if minimized
-- =============================================================================
do
  if not gui or not main then return end
  local reopen = gui:FindFirstChild("ReopenChip")
  if not reopen then
    reopen = make("TextButton", gui, {
      Name = "ReopenChip",
      Size = UDim2.fromOffset(150, 34),
      Position = UDim2.new(0, 14, 1, -54),
      BackgroundColor3 = T.panel,
      Text = "OPEN JJS MENU",
      TextColor3 = T.acc,
      Font = Enum.Font.GothamBold,
      TextSize = 11,
      Visible = false,
      ZIndex = 60,
    })
    corner(reopen, 8)
    connect(reopen.Activated, function()
      main.Visible = true
      reopen.Visible = false
    end)
  end
  -- Hook minimize if present
  if minimize then
    connect(minimize.Activated, function()
      main.Visible = false
      reopen.Visible = true
    end)
  end
  -- Sync: if main hidden, show chip
  connect(main:GetPropertyChangedSignal("Visible"), function()
    reopen.Visible = not main.Visible
  end)
end


-- =============================================================================
-- CONTINUOUS IMPROVEMENTS (ongoing until Maker says stop)
-- No dash timers. QoL, safety, feedback, reopen chip, search, attributes.
-- =============================================================================

do
  if not gui or not gui.Parent then return end

  -- Instance stamp
  pcall(function()
    gui:SetAttribute("ScriptBuild", "COMBINED-IMPROVED-CONTINUOUS")
    gui:SetAttribute("NoDashTimers", true)
    gui:SetAttribute("RearGateStuds", 8)
    gui:SetAttribute("RearStableMs", 200)
    gui:SetAttribute("PairWindowMinMs", 325)
    gui:SetAttribute("PairWindowMaxMs", 400)
    gui:SetAttribute("FollowUpDelayMs", 350)
    gui:SetAttribute("InstanceId", tostring(os.clock()) .. "-" .. tostring(math.random(1000, 9999)))
  end)

  -- Status strip
  local statusStrip = gui:FindFirstChild("StatusStrip") or make("Frame", root or gui, {
    Name = "StatusStrip",
    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.new(0.5, 0, 0, 8),
    Size = UDim2.fromOffset(440, 22),
    BackgroundColor3 = T.panel,
    BorderSizePixel = 0,
    ZIndex = 50,
  })
  if not statusStrip:FindFirstChildOfClass("UICorner") then corner(statusStrip, 6) end
  local statusText = statusStrip:FindFirstChild("StatusText") or make("TextLabel", statusStrip, {
    Name = "StatusText",
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Text = "JJS · Ready · 3 = chain/macro · RightShift = menu · H = help",
    TextColor3 = T.mut,
    Font = Enum.Font.Gotham,
    TextSize = 11,
    TextXAlignment = Enum.TextXAlignment.Center,
  })

  local function setStatus(msg)
    if statusText and statusText.Parent then statusText.Text = tostring(msg) end
    pcall(function() gui:SetAttribute("StatusMessage", tostring(msg)) end)
  end

  -- Help overlay
  local help = gui:FindFirstChild("HelpOverlay") or make("Frame", root or gui, {
    Name = "HelpOverlay",
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(380, 240),
    BackgroundColor3 = T.bg,
    BorderSizePixel = 0,
    Visible = false,
    ZIndex = 200,
  })
  if not help:FindFirstChildOfClass("UICorner") then corner(help, 10) end
  if not help:FindFirstChildOfClass("UIStroke") then make("UIStroke", help, {Color = T.acc, Thickness = 1}) end
  local helpLabel = help:FindFirstChild("HelpLabel") or make("TextLabel", help, {
    Name = "HelpLabel",
    Size = UDim2.new(1, -24, 1, -24),
    Position = UDim2.fromOffset(12, 12),
    BackgroundTransparency = 1,
    Text = "CONTROLS\n\n3 — Black Flash macro / rear chain\nRightShift — show/hide menu\nH — toggle this help\n\nChain: target <=8 studs, behind + grounded,\n200ms stable rear gate.\nFollow-up window ~325-400ms after first 3.\n\nUnload from Settings or destroy GUI.\nNo dash timers in this build.",
    TextColor3 = T.txt,
    Font = Enum.Font.Gotham,
    TextSize = 13,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top,
    TextWrapped = true,
  })

  connect(UIS.InputBegan, function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.H and main and main.Visible then
      help.Visible = not help.Visible
    end
  end)

  -- Reopen chip
  local reopen = gui:FindFirstChild("ReopenChip") or make("TextButton", gui, {
    Name = "ReopenChip",
    Size = UDim2.fromOffset(150, 34),
    Position = UDim2.new(0, 14, 1, -54),
    BackgroundColor3 = T.panel,
    Text = "OPEN JJS MENU",
    TextColor3 = T.acc,
    Font = Enum.Font.GothamBold,
    TextSize = 11,
    Visible = false,
    ZIndex = 60,
  })
  if not reopen:FindFirstChildOfClass("UICorner") then corner(reopen, 8) end
  connect(reopen.Activated, function()
    if main then main.Visible = true end
    reopen.Visible = false
  end)
  if minimize then
    connect(minimize.Activated, function()
      if main then main.Visible = false end
      reopen.Visible = true
    end)
  end
  if main then
    connect(main:GetPropertyChangedSignal("Visible"), function()
      reopen.Visible = not main.Visible
    end)
  end

  -- Status pulse
  local lastPulse = 0
  connect(RS.Heartbeat, function()
    if not running or not gui.Parent then return end
    local now = os.clock()
    if now - lastPulse < 0.4 then return end
    lastPulse = now
    local mode = "OFF"
    pcall(function()
      if chainEnabled then mode = "CHAIN"
      elseif macroEnabled then mode = "MACRO"
      end
    end)
    local focus = (focused ~= false) and "focus" or "unfocused"
    setStatus(string.format("JJS · %s · %s · 3 ready", mode, focus))
  end)

  -- Click status for gap info
  statusStrip.Active = true
  connect(statusStrip.InputBegan, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
      local d = gui:GetAttribute("LastBlackflashPairGapMs") or gui:GetAttribute("FollowUpDelayMs") or 350
      setStatus(string.format("Gap / delay: %s ms", tostring(d)))
    end
  end)

  -- Scale clamp
  if scale then
    connect(RS.Heartbeat, function()
      if not running or not scale.Parent then return end
      if scale.Scale < 0.35 then scale.Scale = 0.35 end
      if scale.Scale > 1.25 then scale.Scale = 1.25 end
    end)
  end

  -- Search empty polish
  if search and empty then
    pcall(function() search.PlaceholderText = "Search modules, categories..." end)
    connect(search:GetPropertyChangedSignal("Text"), function()
      local q = string.lower(search.Text or ""):match("^%s*(.-)%s*$") or ""
      if empty then
        empty.Text = (q == "") and "" or ('No match for "' .. q .. '"')
      end
    end)
  end

  -- Focus hygiene messages
  connect(UIS.WindowFocusReleased, function()
    setStatus("Unfocused — input paused")
  end)
  connect(UIS.WindowFocused, function()
    setStatus("Focused — ready")
  end)

  setStatus("JJS · Ready · continuous build · no dash timers")
end


-- =============================================================================
-- CONTINUOUS BATCH — performance + unload hardness
-- =============================================================================
do
  if not gui or not gui.Parent then return end

  -- Hard unload helper exposed on gui
  local function hardUnload()
    pcall(function()
      running = false
      if typeof(stop) == "function" then stop(nil, true) end
      if typeof(cancelImpact) == "function" then cancelImpact() end
      if typeof(clearPopups) == "function" then clearPopups() end
      if typeof(cleanup) == "function" then cleanup() end
    end)
    pcall(function()
      if gui and gui.Parent then gui:Destroy() end
    end)
  end
  pcall(function() gui:SetAttribute("HardUnloadReady", true) end)

  -- If Shutdown bindable exists, also wire hard unload
  local sh = gui:FindFirstChild("Shutdown")
  if sh and sh:IsA("BindableEvent") then
    connect(sh.Event, function()
      hardUnload()
    end)
  end

  -- Lightweight FPS-ish pulse into attribute (not a real profiler)
  local frames, acc, last = 0, 0, os.clock()
  connect(RS.Heartbeat, function(dt)
    if not running then return end
    frames += 1
    acc += dt
    if acc >= 1 then
      pcall(function() gui:SetAttribute("ClientHeartbeatFps", frames) end)
      frames, acc = 0, 0
    end
  end)
end


-- =============================================================================
-- CONTINUOUS WAVE — JJS-tuned defaults from research digest
-- Pair window 325-400ms, follow-up ~350ms, rear 8 studs, stable 200ms
-- =============================================================================
do
  if not gui then return end
  pcall(function()
    -- Align attributes to documented JJS-style windows (community research)
    gui:SetAttribute("PairWindowMinMs", 325)
    gui:SetAttribute("PairWindowMaxMs", 400)
    gui:SetAttribute("FollowUpDelayMs", 350)
    gui:SetAttribute("RearGateStuds", 8)
    gui:SetAttribute("RearStableMs", 200)
    gui:SetAttribute("ChainRounds", 4)
    gui:SetAttribute("ResearchSnapshot", "2026-10-21-JJS-digest")
  end)

  -- If badge exists in UI, reflect 350 default
  pcall(function()
    if badge and badge:IsA("TextLabel") then
      badge.Text = "350"
    end
  end)
end



-- =============================================================================
-- CONTINUOUS — notification toast helper (no dash timers)
-- =============================================================================
do
  if not gui or not gui.Parent then return end
  if gui:FindFirstChild("SideNotifications") then
    -- already present
  else
    local holder = make("Frame", gui, {
      Name = "SideNotifications",
      AnchorPoint = Vector2.new(1, 0.5),
      Position = UDim2.new(1, -16, 0.5, 0),
      Size = UDim2.new(0, 300, 0.8, 0),
      BackgroundTransparency = 1,
      ZIndex = 70,
    })
    make("UIListLayout", holder, {
      Padding = UDim.new(0, 8),
      VerticalAlignment = Enum.VerticalAlignment.Center,
      SortOrder = Enum.SortOrder.LayoutOrder,
    })
    local serial = 0
    local function toast(title, body, color)
      serial += 1
      local f = make("Frame", holder, {
        Size = UDim2.fromOffset(300, 70),
        BackgroundColor3 = T.card,
        BorderSizePixel = 0,
        LayoutOrder = serial,
      })
      corner(f, 8)
      make("UIStroke", f, {Color = color or T.acc, Transparency = 0.3})
      make("TextLabel", f, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 8),
        Size = UDim2.new(1, -24, 0, 18),
        Text = title,
        TextColor3 = color or T.acc,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
      })
      make("TextLabel", f, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 28),
        Size = UDim2.new(1, -24, 0, 34),
        Text = body,
        TextWrapped = true,
        TextColor3 = T.txt,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
      })
      task.delay(3.2, function()
        if f.Parent then f:Destroy() end
      end)
    end
    pcall(function()
      toast("Build", "Continuous improve active · no dash timers · H for help", T.acc)
    end)
  end
end

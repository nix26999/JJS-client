  local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude;local exclude={character};if model then table.insert(exclude,model) end;p.FilterDescendantsInstances=exclude;p.RespectCanCollide=true;sharedParams=p;paramsModel=model;paramsCharacter=character;return p
 end

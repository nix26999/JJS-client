   local current=source;if not current or rawget(_G,"JJSVerifiedCombat")~=current then error("adapter changed",0) end
   local ok,result=pcall(current.isReady,action,model)
   if not valid(token) or source~=current or rawget(_G,"JJSVerifiedCombat")~=current then error("cancelled / adapter changed",0) end
   if not ok then error("readiness callback failed",0) end;return result==true and rearReady()
  end
  local function jumpBehind(token)
   waitFor(token,cfg.CloseTimeout/1000,closeEnough)
   local _,tr=targetRig();local look=Vector3.new(tr.CFrame.LookVector.X,0,tr.CFrame.LookVector.Z);if look.Magnitude<.001 then error("target facing unavailable",0) end
   moveGoal=tr.Position-look.Unit*4

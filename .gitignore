   end
   local function inputPair()
    check();local p,tr=updateTarget(true);if not attackReady(tr) then return false end
    local pairModel=targetModel;local hum=p.Humanoid;local health=hum.Health;local observed=false;local seenTracks={};local h=rig();local animator=h:FindFirstChildOfClass("Animator")

  local h,r=rig();if not h then return nil end
  if active and runVersion==3 and fightModel and fightHumanoid then
   if fightHumanoid.Health<=0 or not fightModel:IsDescendantOf(workspace) then return nil end
   local owner=Players:GetPlayerFromCharacter(fightModel);if not owner and not includeNPCsV2 then return nil end
   local root=fightModel:FindFirstChild("HumanoidRootPart") or fightModel.PrimaryPart;if not root or not root:IsA("BasePart") then return nil end
   if cachedCandidate and cachedCandidate.Model==fightModel and cachedCandidate.Humanoid==fightHumanoid then return cachedCandidate,root end

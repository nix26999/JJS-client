local function bindKillRemote(remote)
 if remote.Name~="BlackflashKillConfirmed" or not remote:IsA("RemoteEvent") or remote==confirmedRemote then return end
 if confirmedConnection then confirmedConnection:Disconnect() end;confirmedRemote=remote;lastKillId=0
 confirmedConnection=connect(remote.OnClientEvent,function(payload)
  if not running or confirmationMode~="ConfirmedOnly" or type(payload)~="table" or payload.kind~="BlackFlashKill" or type(payload.id)~="number" or payload.id~=payload.id or payload.id<=lastKillId then return end
  lastKillId=payload.id;playImpact()
 end);updateKillStatus()
end
local existing=ReplicatedStorage:FindFirstChild("BlackflashKillConfirmed");if existing then bindKillRemote(existing) end
connect(ReplicatedStorage.ChildAdded,bindKillRemote)
connect(ReplicatedStorage.ChildRemoved,function(o) if o==confirmedRemote then if confirmedConnection then confirmedConnection:Disconnect() end;confirmedRemote=nil;updateKillStatus() end end)
local function rootOf(h) local m=h and h.Parent;local r=m and m:FindFirstChild("HumanoidRootPart");return r and r:IsA("BasePart") and r or nil end
local function localHumanoid() local c=LP.Character;return c and c:FindFirstChildOfClass("Humanoid") end
local function localRoot() local c=LP.Character;return c and c:FindFirstChild("HumanoidRootPart") end
local function distance(h) local a,b=localRoot(),rootOf(h);return a and b and (a.Position-b.Position).Magnitude or math.huge end
local function living() local h=localHumanoid();return h and h.Health>0 and localRoot() end
local function nearby(h) return h.Parent~=LP.Character and h:IsDescendantOf(workspace) and distance(h)<=10 end
local function arm(first,second,target,owner)
 local gap=second-first;if gap<.325 or gap>.4 then return nil end
 local targets={};if target then if target.Health>0 and nearby(target) then targets[target]=true end else for h in pairs(tracked) do if h.Health>0 and nearby(h) then targets[h]=true end end end
 local candidate={targets=targets,deadline=second+.6,hit=false,owner=owner,character=LP.Character};pending=candidate;return candidate
end
local function track(h)
 if not h:IsA("Humanoid") or tracked[h] then return end;local r={health=h.Health};tracked[h]=r
 r.connection=h.HealthChanged:Connect(function(health)
  local before=r.health;r.health=health;local p=pending
  if not running or not focused or not p or health>=before or before<=0 or os.clock()>p.deadline or not p.targets[h] or not nearby(h) or UIS:GetFocusedTextBox() or p.character~=LP.Character or (p.owner and current~=p.owner) then return end
  if not p.hit then p.hit=true;showPopup(false) end
  if confirmationMode=="EstimatedLethal" and health<=0 and not lethalNotified[h] then lethalNotified[h]=true;playImpact() end
 end)
end
local function untrack(h) local r=tracked[h];if r then r.connection:Disconnect();tracked[h]=nil end end
connect(workspace.DescendantAdded,track);connect(workspace.DescendantRemoving,untrack);for _,o in ipairs(workspace:GetDescendants()) do track(o) end
local function nearest()
 local best,d=nil,math.huge
 for h in pairs(tracked) do if rootOf(h) and h.Health>0 and h.Parent~=LP.Character then local other=Players:GetPlayerFromCharacter(h.Parent);local same=other and not LP.Neutral and not other.Neutral and LP.Team and LP.Team==other.Team;local gap=distance(h);if not same and gap<d then best,d=h,gap end end end;return best
end
local function rearFraction(h)
 local a,b=localRoot(),rootOf(h);if not a or not b then return 0 end
 local look=b.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z);if look.Magnitude<.01 then return 0 end;look=look.Unit;local count=0
 for _,z in ipairs({-.4,.4}) do for _,x in ipairs({-.9,-.45,0,.45,.9}) do local p=a.CFrame:PointToWorldSpace(Vector3.new(x,0,z));if (p-b.Position):Dot(look)<-.1 then count+=1 end end end
 gui:SetAttribute("BlackflashRearSamples",count);return count/10
end
local function rearGround(j)
 local a,b=localRoot(),rootOf(j.target);local h=localHumanoid()
 return a and b and h and h.FloorMaterial~=Enum.Material.Air and math.abs(a.Position.Y-b.Position.Y)<=2 and distance(j.target)<=8 and rearFraction(j.target)>=.3
end
local function valid(j)
 local h=localHumanoid()
 return running and focused and current==j and LP.Character==j.character and h and h.Health>0 and not UIS:GetFocusedTextBox() and (j.mode=="CHAIN" and chainEnabled or j.mode=="MACRO" and macroEnabled) and (j.mode~="CHAIN" or (j.target.Health>0 and j.target:IsDescendantOf(workspace) and rootOf(j.target) and workspace.CurrentCamera==j.camera))
end
local function waitUntil(j,deadline) while valid(j) do local left=deadline-os.clock();if left<=0 then return true end;task.wait(math.min(left,.015)) end;return false end
local function key(j,k,down)
 if down then j.keys[k]=true end;injecting=true;if k==Enum.KeyCode.Three then echoUntil=os.clock()+.08 end
 local ok,err=pcall(function() VIM:SendKeyEvent(down,k,false,game) end);injecting=false;if not ok then error(err,0) end;if not down then j.keys[k]=nil end
end
stop=function(message,disable)
 local j=current;current=nil
 if disable then macroEnabled=false;chainEnabled=false;if paintMacro then paintMacro() end;if paintChain then paintChain() end end
 if j then
  if j.thread and j.thread~=coroutine.running() then pcall(task.cancel,j.thread) end;if j.cameraConnection then j.cameraConnection:Disconnect() end;for _,c in ipairs(j.connections) do c:Disconnect() end
  if j.camera then pcall(function() j.camera.CameraType=j.savedType;j.camera.CameraSubject=j.savedSubject and j.savedSubject.Parent and j.savedSubject or localHumanoid() end);pcall(function() UIS.MouseBehavior=j.savedMouse end) end
  injecting=true;local failed=false
  for k in pairs(j.keys) do if k==Enum.KeyCode.Three then echoUntil=os.clock()+.08 end;if not pcall(function() VIM:SendKeyEvent(false,k,false,game) end) then failed=true end end;injecting=false
  if failed then macroEnabled=false;chainEnabled=false;paintMacro();paintChain();message=(message or "Stopped").." | Release failed; OFF." end
 end
 if disable or not focused or UIS:GetFocusedTextBox() then pending=nil elseif pending and pending.owner==j then pending.owner=nil end
 lastTap=nil;targetRef.Value=nil;gui:SetAttribute("BlackflashChainV2Enabled",false);if message then say(message) end
end
local function angle(a,b) return math.atan2(math.sin(b-a),math.cos(b-a)) end
local function lock(j)
 local camera=assert(workspace.CurrentCamera,"Camera unavailable");local a=assert(localRoot(),"Root unavailable")
 j.camera=camera;j.savedType=camera.CameraType;j.savedSubject=camera.CameraSubject;j.savedMouse=UIS.MouseBehavior;j.cameraDistance=math.clamp((camera.CFrame.Position-a.Position).Magnitude,4,18)
 local look=camera.CFrame.LookVector;j.yaw=math.atan2(-look.X,-look.Z);j.pitch=math.asin(math.clamp(look.Y,-1,1));j.pivot=camera.CFrame.Position+look*j.cameraDistance
 camera.CameraType=Enum.CameraType.Scriptable;UIS.MouseBehavior=Enum.MouseBehavior.LockCenter
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={j.character,j.target.Parent}
 j.cameraConnection=RS.RenderStepped:Connect(function(dt)
  if current~=j then return end;local a,b=localRoot(),rootOf(j.target);if not a or not b then return end
  UIS.MouseBehavior=Enum.MouseBehavior.LockCenter;local mouse=UIS:GetMouseDelta();j.yaw-=mouse.X*.0025;j.pitch=math.clamp(j.pitch-mouse.Y*.0025,-1.15,1.15)
  j.pivot=j.pivot:Lerp(a.Position+Vector3.new(0,1.8,0),1-math.exp(-18*dt));local back=b.Position-b.CFrame.LookVector*.65+Vector3.new(0,.65,0);local d=back-j.pivot;if d.Magnitude<.01 then return end;d=d.Unit
  if j.flickStart then local t=math.clamp((os.clock()-j.flickStart)/.16,0,1);j.yaw=j.flickFrom+j.flickDelta*(t*t*(3-2*t));if t>=1 then j.flickStart=nil end
  else local desired=math.atan2(-d.X,-d.Z);j.yaw+=angle(j.yaw,desired)*(1-math.exp(-(j.approaching and 15 or 7)*dt))/(1+mouse.Magnitude*.06) end
  j.pitch+=(math.asin(math.clamp(d.Y,-1,1))-j.pitch)*(1-math.exp(-7*dt));local rotation=CFrame.Angles(0,j.yaw,0)*CFrame.Angles(j.pitch,0,0);local proposed=j.pivot-rotation.LookVector*j.cameraDistance;local hit=workspace:Raycast(j.pivot,proposed-j.pivot,params)
  camera.CFrame=CFrame.new(hit and hit.Position+hit.Normal*.3 or proposed)*rotation;camera.Focus=CFrame.new(back)
 end)
 targetRef.Value=j.target;gui:SetAttribute("BlackflashChainV2Enabled",true)
end
local function approach(j)
 if distance(j.target)<=8 then return true end
 say("Approaching target: W until within 8 studs.");j.approaching=true
 if not waitUntil(j,os.clock()+.12) then return false end;key(j,Enum.KeyCode.W,true)
 local best=distance(j.target);local progressAt=os.clock();local deadline=os.clock()+6
 while valid(j) and distance(j.target)>8 and os.clock()<deadline do local d=distance(j.target);if d<best-.35 then best=d;progressAt=os.clock() end;if os.clock()-progressAt>1.5 then break end;task.wait() end
 key(j,Enum.KeyCode.W,false);j.approaching=false;return valid(j) and distance(j.target)<=8
end
local function jumpBehind(j)
 if distance(j.target)>8 and not approach(j) then return false end;say("Jump fallback: move to rear ground, not target's head.")
 local h=localHumanoid();if not h then return false end;key(j,Enum.KeyCode.W,false);local moving=true
 local function endMove() if not moving then return end;moving=false;RS:UnbindFromRenderStep(MOVE_ACTION);pcall(function() h:Move(Vector3.zero,false) end) end
 table.insert(j.connections,{Disconnect=endMove});RS:UnbindFromRenderStep(MOVE_ACTION)
 RS:BindToRenderStep(MOVE_ACTION,Enum.RenderPriority.Last.Value+1,function()
  if not valid(j) then endMove();return end;local a,b=localRoot(),rootOf(j.target);if not a or not b then endMove();return end
  local look=b.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z);if look.Magnitude<.01 then return end
  local d=b.Position-look.Unit*4-a.Position;d=Vector3.new(d.X,0,d.Z);h:Move(d.Magnitude>.65 and d.Unit or Vector3.zero,false)
 end)
 key(j,Enum.KeyCode.Space,true);h.Jump=true;if not waitUntil(j,os.clock()+.05) then endMove();return false end;key(j,Enum.KeyCode.Space,false)
 local deadline=os.clock()+1.5;local landedAt
 while valid(j) and os.clock()<deadline do
  local a,b=localRoot(),rootOf(j.target);if not a or not b then break end;local look=b.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z);local offset=a.Position-b.Position;local flat=Vector3.new(offset.X,0,offset.Z);local depth=look.Magnitude>.01 and -flat:Dot(look.Unit) or 0
  if rearGround(j) and depth>=2.5 then landedAt=landedAt or os.clock();if os.clock()-landedAt>=.08 then endMove();return true end else landedAt=nil end;task.wait()
 end;endMove();return false
end
local function positionBehind(j)
 if not approach(j) then return false end;if rearGround(j) then return true end
 if os.clock()-lastSide<2 then return jumpBehind(j) end
 say("Side dash: D + Q; immediate 90-degree flick; hold D until behind.")
 j.approaching=false;key(j,Enum.KeyCode.W,false);key(j,Enum.KeyCode.S,false);key(j,Enum.KeyCode.A,false)
 if not waitUntil(j,os.clock()+.035) then return false end;key(j,Enum.KeyCode.D,true)
 if not waitUntil(j,os.clock()+.05) then return false end;key(j,Enum.KeyCode.Q,true);lastSide=os.clock()
 local targetRoot=rootOf(j.target);if not targetRoot then key(j,Enum.KeyCode.Q,false);key(j,Enum.KeyCode.D,false);return false end
 local direction=targetRoot.Position-j.camera.CFrame.Position;local targetYaw=math.atan2(-direction.X,-direction.Z);local turnError=angle(j.yaw,targetYaw)
 j.flickFrom=j.yaw;j.flickDelta=(turnError>=0 and 1 or -1)*math.rad(90);j.flickStart=lastSide
 if not waitUntil(j,lastSide+.035) then return false end;key(j,Enum.KeyCode.Q,false)
 local deadline=lastSide+1.5
 while valid(j) and os.clock()<deadline do if rearGround(j) then key(j,Enum.KeyCode.D,false);return true end;task.wait() end
 key(j,Enum.KeyCode.D,false);if not valid(j) then return false end;return jumpBehind(j)
end
local function stableRear(j)
 local since;local deadline=os.clock()+1.2;say("Waiting 200ms continuously behind and grounded.")
 while valid(j) and os.clock()<deadline do local now=os.clock();if rearGround(j) then since=since or now;if now-since>=.2 then return true end else since=nil end;task.wait() end;return false
end
local function start(started)
 if current or not VIM or not living() then return end
 local mode=chainEnabled and "CHAIN" or macroEnabled and "MACRO" or nil;if not mode then return end
 local target=mode=="CHAIN" and nearest() or nil;if mode=="CHAIN" and not target then say("No living target. Press 3 to retry.");return end
 local j={mode=mode,target=target,character=LP.Character,keys={},connections={},physicalReleased=false};current=j
 local h=localHumanoid();table.insert(j.connections,h.Died:Connect(function() if current==j then stop("Player died; OFF.",true) end end))
 if target then table.insert(j.connections,target.Died:Connect(function() if current==j then stop("Target died; chain stopped. Press 3 again.",false) end end)) end
 j.thread=task.defer(function()
  local complete=false
  local ok,err=xpcall(function()
   if mode=="CHAIN" then lock(j) end
   for round=1,(mode=="CHAIN" and 4 or 1) do
    if not valid(j) then return end
    if mode=="CHAIN" and (not positionBehind(j) or not stableRear(j) or not rearGround(j)) then say("Positioning failed. Stopped until 3 is pressed again.");return end
    local first=started
    if mode=="CHAIN" then first=os.clock();key(j,Enum.KeyCode.Three,true);if not waitUntil(j,first+.035) then return end;key(j,Enum.KeyCode.Three,false) end
    say(string.format("Round %d/%d: follow-up targeted at +350ms.",round,mode=="CHAIN" and 4 or 1))
    if not waitUntil(j,first+.350) then return end
    if mode=="MACRO" and not j.physicalReleased then say("Release initial 3 before 350ms.");return end
    if mode=="CHAIN" and not rearGround(j) then say("Rear/range/ground lost before follow-up; stopped.");return end
    local second=os.clock();local gap=second-first
    if mode=="CHAIN" and (gap<.325 or gap>.4) then say("Follow-up deadline missed; cancelled rather than sending a late pair.");return end
    local candidate=arm(first,second,target,j);key(j,Enum.KeyCode.Three,true);gui:SetAttribute("LastBlackflashPairGapMs",gap*1000)
    if not waitUntil(j,second+.035) then return end;key(j,Enum.KeyCode.Three,false)
    if mode=="CHAIN" then
     if not candidate then say("Timing not qualified; stopped.");return end
     while valid(j) and not candidate.hit and os.clock()<=candidate.deadline do task.wait() end
     if not valid(j) then return end;if not candidate.hit then say("No estimated target hit. Lock released; press 3 to retry.");return end
     gui:SetAttribute("BlackflashChainRound",round);if round<4 and not waitUntil(j,os.clock()+.25) then return end
    end
   end;complete=true
  end,function(e) return debug.traceback(tostring(e),2) end)
  if current~=j then return end
  if not ok then stop("Input/camera error: "..tostring(err),true)
  elseif complete then stop(mode=="CHAIN" and "Four estimated rounds complete. Lock OFF; press 3 again." or "Macro ready.",false)
  else stop(chainStatus.Text.." | Lock OFF; waiting for 3.",false) end
 end)
end
CAS:BindActionAtPriority(ACTION,function(_,state)
 if injecting or os.clock()<echoUntil or not running or not focused or UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
 if state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then heldThree=false;if current and current.mode=="MACRO" then current.physicalReleased=true end;return chainEnabled and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass end
 if state~=Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
 if heldThree then return chainEnabled and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass end;heldThree=true
 if current then return chainEnabled and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass end
 if macroEnabled or chainEnabled then if not VIM then say("Virtual input backend unavailable.") else start(os.clock()) end
 else local now=os.clock();if lastTap and now-lastTap>=.325 and now-lastTap<=.4 then arm(lastTap,now);lastTap=nil else lastTap=now end end
 return chainEnabled and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
end,false,Enum.ContextActionPriority.High.Value+100,Enum.KeyCode.Three)
connect(UIS.InputEnded,function(i) if i.KeyCode==Enum.KeyCode.Three and not injecting and os.clock()>=echoUntil then heldThree=false;if current and current.mode=="MACRO" then current.physicalReleased=true end end end)
connect(UIS.InputBegan,function(i,processed)
 if UIS:GetFocusedTextBox() then return end;if i.KeyCode==Enum.KeyCode.RightShift then show(not main.Visible);return end
 if not processed and i.KeyCode==Enum.KeyCode.Q and (UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D)) then local now=os.clock();if now-lastSide>=2 then lastSide=now end end
end)
connect(UIS.WindowFocusReleased,function() focused=false;heldThree=false;stop("Focus lost; press 3 again.",false);cancelImpact();resetStreak() end)
connect(UIS.WindowFocused,function() focused=true end)
connect(UIS.TextBoxFocused,function() heldThree=false;stop("Text entry; stopped.",false);resetStreak() end)
connect(LP.CharacterRemoving,function() heldThree=false;stop("Character removed; OFF.",true);cancelImpact();clearPopups() end)
local function cleanup()
 if cleanedUp then return end;cleanedUp=true;running=false;stop(nil,true);cancelImpact();clearPopups();CAS:UnbindAction(ACTION);RS:UnbindFromRenderStep(MOVE_ACTION)

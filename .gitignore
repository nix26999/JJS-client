 return make("TextLabel",p,{Size=UDim2.new(1,0,0,48),BackgroundTransparency=1,Text=message,TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=10,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(p)+2})
end
for name,page in pairs(pages) do if name~="Yuji" and name~="Settings" and name~="Visuals" then card(page,"No modules added",descriptions[name],name) end end
local function cancelImpact()
 impactToken+=1
 if impactConnection then impactConnection:Disconnect();impactConnection=nil end
 if activeImpactLayer then activeImpactLayer:Destroy();activeImpactLayer=nil end
end
local function updateFinisherStatus()
 if not finisherStatus or not finisherStatus.Parent then return end
 if confirmationMode=="EstimatedLethal" then
  finisherStatus.Text="ESTIMATED LETHAL mode: lethal health loss after a timing pair. Attacker/Black Flash NOT verified."
 elseif confirmedRemote and confirmedRemote.Parent then
  finisherStatus.Text="CONFIRMED ONLY: server signal connected. Effect runs only on BlackFlashKill events."
 else
  finisherStatus.Text="CONFIRMED ONLY: waiting for the package's BlackflashKillConfirmed server signal. Client health alone cannot prove a Black Flash kill."
 end
end
local function playImpactFrames()
 if not running or not impactFramesEnabled then return end
 cancelImpact();local token=impactToken
 local layer=make("Frame",gui,{Name="BlackflashKillFinisher16",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=90});activeImpactLayer=layer
 local bg=make("Frame",layer,{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=1,BorderSizePixel=0,ZIndex=91})
 local pieces={};local rng=Random.new(21)
 local function segment(a,b,width,born,isRed)
  local glow=make("Frame",layer,{AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,BackgroundColor3=Color3.fromRGB(255,45,85),ZIndex=92})
  local ink=make("Frame",layer,{AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,ZIndex=93})
  table.insert(pieces,{a=a,b=b,w=width,born=born,red=isRed,glow=glow,ink=ink})
 end
 for branch=1,9 do
  local p=branch<=6 and Vector2.new(90,170) or Vector2.new(rng:NextNumber(800,1920),-20)
  local a=branch<=6 and rng:NextNumber(-.1,1.3) or rng:NextNumber(1.3,3.4)
  local width=rng:NextNumber(12,26)
  for k=1,13 do
   a+=rng:NextNumber(-.6,.6);local q=p+Vector2.new(math.cos(a),math.sin(a))*rng:NextNumber(50,150)
   segment(p,q,math.max(1.5,width*(1-k/15)),(k-1)/17,false)
   if k%3==0 then local aa=a+rng:NextNumber(-1,1);segment(p,p+Vector2.new(math.cos(aa),math.sin(aa))*rng:NextNumber(100,280),4,k/17,true) end
   p=q
  end
 end
 for i=1,34 do local a=2*math.pi*i/34;local dir=Vector2.new(math.cos(a),math.sin(a));local p=Vector2.new(1150,620)+dir*70;segment(p,p+dir*rng:NextNumber(200,850),rng:NextNumber(3,10),0,i%3==0) end
 local ring=make("Frame",layer,{AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,ZIndex=94});corner(ring,999)
 local ringStroke=make("UIStroke",ring,{Color=Color3.fromRGB(220,25,55),Thickness=8})
 local growth={.10,.28,.46,.62,.74,.84,.92,.97,1,1,1,1,1,1,1,1}
 local backAlpha={1,1,1,1,1,.92,.75,.55,.35,.20,.08,0,0,0,0,0}
 local function drawFrame(frame)
  local size=layer.AbsoluteSize;local sx,sy=size.X/1920,size.Y/1080;local sf=math.min(sx,sy)
  local fade=frame<=11 and 1 or math.max(0,(16-frame)/5)
  local inverse=not reducedFlash and frame>=2 and frame<=4
  bg.BackgroundColor3=inverse and Color3.new(0,0,0) or Color3.new(1,1,1)
  bg.BackgroundTransparency=1-(reducedFlash and math.min(.16,backAlpha[frame]) or backAlpha[frame])*fade
  for _,s in ipairs(pieces) do
   local progress=math.clamp((growth[frame]-s.born)/.22,0,1)
   local a=Vector2.new(s.a.X*sx,s.a.Y*sy);local b=Vector2.new(s.b.X*sx,s.b.Y*sy);local d=(b-a)*progress;local mid=a+d/2;local width=math.max(1,s.w*sf)
   for _,o in ipairs({s.glow,s.ink}) do o.Visible=progress>0 and fade>0;o.Position=UDim2.fromOffset(mid.X,mid.Y);o.Rotation=math.deg(math.atan2(d.Y,d.X)) end
   s.glow.Size=UDim2.fromOffset(d.Magnitude,width+8*sf);s.glow.BackgroundTransparency=1-.35*fade
   s.ink.Size=UDim2.fromOffset(d.Magnitude,width);s.ink.BackgroundTransparency=1-fade
   s.ink.BackgroundColor3=s.red and Color3.fromRGB(193,18,31) or (inverse and Color3.new(1,1,1) or Color3.new(0,0,0))
  end
  local progress=math.clamp((frame-1)/8,0,1);ring.Visible=frame>=2 and frame<=9
  ring.Position=UDim2.fromOffset(1150*sx,620*sy);ring.Size=UDim2.fromOffset((160+1240*progress)*sx,(100+800*progress)*sy)
  ringStroke.Thickness=math.max(1,(22*(1-progress)+3)*sf);ringStroke.Transparency=1-fade
 end
 local started=os.clock();local lastFrame=1;drawFrame(1)
 impactConnection=RS.RenderStepped:Connect(function()
  if not running or not impactFramesEnabled or token~=impactToken or not layer.Parent then cancelImpact();return end
  local elapsed=os.clock()-started;if elapsed>=FRAME_COUNT/FPS then cancelImpact();return end
  local frame=math.min(FRAME_COUNT,math.floor(elapsed*FPS)+1);if frame~=lastFrame then lastFrame=frame;drawFrame(frame) end
 end)
end
local phrases={"Perfect!","BLACKFLASH","HOLY","Great!","Amazing!","Absolute Cinema","Anotha One","YUJI ITDAORI!"}
local phraseRng,lastPhrase=Random.new(),nil

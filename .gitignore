 local p=make("ScrollingFrame",content,{Name=name,Size=UDim2.new(1,0,1,-96),Position=UDim2.fromOffset(0,96),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=T.acc,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),Visible=i==1})
 make("UIPadding",p,{PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,16)});make("UIListLayout",p,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder});pages[name]=p
 connect(b.Activated,function() selectPage(name,true) end)
end
local ord,searchSections={},{}
local function nextOrder(p) ord[p]=(ord[p] or 0)+1;return ord[p] end
local function card(p,name,sub,terms)
 local c=make("Frame",p,{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=T.card,BorderSizePixel=0,LayoutOrder=nextOrder(p)});corner(c,10);stroke(c)
 make("UIPadding",c,{PaddingTop=UDim.new(0,10),PaddingBottom=UDim.new(0,10),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12)});make("UIListLayout",c,{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
 local heading=make("TextLabel",c,{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=0})
 make("TextLabel",c,{Size=UDim2.new(1,0,0,32),BackgroundTransparency=1,Text=sub,TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=10,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=1})
 make("Frame",c,{Size=UDim2.new(1,0,0,1),BackgroundColor3=T.stroke,BorderSizePixel=0,LayoutOrder=2});searchSections[c]={page=p,text=string.lower(name.." "..sub.." "..(terms or ""))};return c,heading
end
local function toggle(p,name,get,set)
 local r=make("TextButton",p,{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="",LayoutOrder=nextOrder(p)+2})
 make("TextLabel",r,{Size=UDim2.new(1,-50,1,0),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
 local track=make("Frame",r,{Size=UDim2.fromOffset(36,18),Position=UDim2.new(1,-36,.5,-9),BackgroundColor3=T.p2,BorderSizePixel=0});corner(track,9)
 local knob=make("Frame",track,{Size=UDim2.fromOffset(14,14),Position=UDim2.new(0,2,.5,-7),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0});corner(knob,7)
 local function paint() track.BackgroundColor3=get() and T.acc or Color3.fromRGB(45,45,55);knob.Position=get() and UDim2.new(1,-16,.5,-7) or UDim2.new(0,2,.5,-7) end
 connect(r.Activated,function() set(not get());paint() end);paint();return paint
end

  if not force and routeCache and routeCache.Root==tr and now-routeCache.At<.12 and(r.Position-routeCache.PlayerPos).Magnitude<.75 and(tr.Position-routeCache.TargetPos).Magnitude<.75 and look:Dot(routeCache.Look)>.985 and right:Dot(routeCache.Right)>.985 and math.abs(speed-routeCache.Speed)<1 then return routeCache.Plan end

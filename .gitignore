local streakTimerLabel=text(gui,"STREAK 0/10 | 0.00s",UDim2.fromScale(.5,.065),UDim2.fromOffset(330,28),13)
streakTimerLabel.Name="PopupStreakTimer";streakTimerLabel.AnchorPoint=Vector2.new(.5,0);streakTimerLabel.TextXAlignment=Enum.TextXAlignment.Center;streakTimerLabel.Font=Enum.Font.GothamBold;streakTimerLabel.ZIndex=83
make("UIStroke",streakTimerLabel,{Color=Color3.new(0,0,0),Thickness=2})
local function updateStreakDisplay(left)
 gui:SetAttribute("PopupStreakIndex",streakIndex);gui:SetAttribute("PopupStreakRemaining",left)
 streakTimerLabel.Visible=popupEnabled;streakTimerLabel.Text=string.format("STREAK %d/%d | %.2fs",streakIndex,#SEQUENCE,left)
end
local function resetStreak() streakIndex=0;streakAt=nil;updateStreakDisplay(0) end
resetStreak()
local sparkRoot=make("Frame",gui,{Name="Combo910Sparkles",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=84})
local sparklePool={}
local sparkleRng=Random.new()
-- Fixed reusable dot pool; no particle allocation during animation.
for i=1,32 do
 local o=make("Frame",sparkRoot,{Name="Spark"..i,AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(2,2),BackgroundTransparency=1,BorderSizePixel=0,Visible=false,ZIndex=84})
 sparklePool[i]={object=o,phase=sparkleRng:NextNumber(),life=sparkleRng:NextNumber(.65,1.3),cycle=-1,edge=0,along=0,paddingU=0}
end
local sparkleTarget,sparkleKind,sparkleStart=nil,nil,0
local function hideSparkles() sparkleTarget=nil;for _,p in ipairs(sparklePool) do p.object.Visible=false end end
local sparkleElapsed=0
connect(RS.Heartbeat,function(dt)
 if not running then return end
 sparkleElapsed+=dt;if sparkleElapsed<.05 then return end;sparkleElapsed=0
 if streakAt then local left=math.max(0,STREAK_WINDOW-(os.clock()-streakAt));if left<=0 then resetStreak() else updateStreakDisplay(left) end end
 if not sparkleTarget or not sparkleTarget.Parent or not popupEnabled then for _,p in ipairs(sparklePool) do p.object.Visible=false end;return end
 local pos,size=sparkleTarget.AbsolutePosition,sparkleTarget.AbsoluteSize
 local age=os.clock()-sparkleStart
 local fade=1-sparkleTarget.TextTransparency
 local count=sparkleKind=="purple" and 20 or 32
 local bounds=sparkleTarget.TextBounds
 local wordHalfX=math.min(size.X*.5,math.max(30,bounds.X*.5))
 local wordHalfY=math.min(size.Y*.5,math.max(10,bounds.Y*.5))
 local screenScale=math.clamp(root.AbsoluteSize.Y/720,.55,1.5)
 local centerX,centerY=pos.X+size.X*.5,pos.Y+size.Y*.5
 for i,p in ipairs(sparklePool) do
  local o=p.object
  if i>count or fade<=0 then o.Visible=false else
   local clock=age/p.life+p.phase
   local cycle=math.floor(clock)
   local t=clock-cycle
   if cycle~=p.cycle then
    p.cycle=cycle
    p.edge=sparkleRng:NextInteger(0,3)
    p.along=sparkleRng:NextNumber(-1,1)
    p.paddingU=sparkleRng:NextNumber()
   end
   -- Real particle-count falloff: 75% near the word, ~19% middle, ~6% far.
   local rank=(i-.5)/count
   local halfX,halfY
   if rank<.75 then
    local padding=(6+24*p.paddingU)*screenScale
    halfX=wordHalfX+padding
    halfY=wordHalfY+padding
   elseif rank<.94 then
    local padding=(38+48*p.paddingU)*screenScale
    halfX=wordHalfX+padding
    halfY=wordHalfY+padding+(wordHalfX-wordHalfY)*.35
   else
    -- Sparse outer dots form a wider SQUARE envelope, not a circle.
    local half=math.max(wordHalfX,wordHalfY)+(100+85*p.paddingU)*screenScale
    halfX,halfY=half,half
   end
   local x,y
   if p.edge==0 then x=centerX+p.along*halfX;y=centerY-halfY
   elseif p.edge==1 then x=centerX+halfX;y=centerY+p.along*halfY
   elseif p.edge==2 then x=centerX+p.along*halfX;y=centerY+halfY
   else x=centerX-halfX;y=centerY+p.along*halfY end
   -- Gentle outward drift keeps the scatter box-shaped throughout its lifetime.
   local drift=1+t*.06
   x=centerX+(x-centerX)*drift
   y=centerY+(y-centerY)*drift
   local brightness=math.sin(t*math.pi)*fade
   local pixels=sparkleKind=="purple" and (1.5+brightness) or (4+brightness*6)
   o.Visible=brightness>.08
   o.Position=UDim2.fromOffset(x,y)
   o.Size=UDim2.fromOffset(pixels,pixels)
   o.Rotation=0
   o.BackgroundTransparency=1-brightness*.9
   o.BackgroundColor3=sparkleKind=="purple" and SEQUENCE[9].color or (i%2==0 and Color3.fromRGB(255,175,20) or Color3.fromRGB(255,215,0))
  end
 end
end)
local function removeSound(s) if sounds[s] then sounds[s]=nil;pcall(function() s:Destroy() end) end end
local function playVoice(id)
 -- Only one popup voice at a time: cancel the previous voice before starting the next.
 local previousVoices={};for sound in pairs(sounds) do table.insert(previousVoices,sound) end
 for _,sound in ipairs(previousVoices) do pcall(function() sound:Stop() end);removeSound(sound) end
 local s=make("Sound",SoundService,{Name="AutoBlackflashStreakVoice",SoundId=id,Volume=VOICE_VOLUME,PlaybackSpeed=1,Looped=false});sounds[s]=true
 local ended;ended=s.Ended:Connect(function() if ended then ended:Disconnect() end;removeSound(s) end)
 s.Destroying:Once(function() if ended then ended:Disconnect() end end)
 local ok,err=pcall(function() s:Play() end);if not ok then warn("Popup sound failed: "..tostring(err));removeSound(s) end
 task.delay(20,function() removeSound(s) end)
end
local function reflowPopups()
 local gap=math.clamp(math.max(1,root.AbsoluteSize.Y)*.10,48,80)
 for i,r in ipairs(popupRecords) do if r.holder.Parent then TS:Create(r.holder,TweenInfo.new(.15),{Position=UDim2.new(.5,0,.12,(i-1)*gap)}):Play() end end
end
local function clearPopups()
 for _,r in ipairs(popupRecords) do if r.holder.Parent then r.holder:Destroy() end end;table.clear(popupRecords)
 for s in pairs(sounds) do removeSound(s) end;resetStreak();hideSparkles()
end
local popupRng=Random.new()
local function showPopup(preview)
 if not running or (not popupEnabled and not preview) then return end
 local index
 if preview then index=1 else
  local now=os.clock();if not streakAt or now-streakAt>=STREAK_WINDOW then streakIndex=0 end
  streakIndex=math.min(streakIndex+1,#SEQUENCE);streakAt=now;index=streakIndex;updateStreakDisplay(STREAK_WINDOW)
 end
 local entry=SEQUENCE[index];local color=entry.color or Color3.fromHSV(popupRng:NextNumber(),.82,1)
 local fade=.36;local hold=entry.hold or math.max(0,(entry.duration or 1.4)-fade)
 local holder=make("Frame",gui,{Name="OrderedBlackflashPopup",AnchorPoint=Vector2.new(.5,0),Position=UDim2.fromScale(.5,.12),Size=UDim2.new(.9,0,0,80),BackgroundTransparency=1,ZIndex=80})
 make("UISizeConstraint",holder,{MaxSize=Vector2.new(650,80)})
 local ps=make("UIScale",holder,{Scale=.65})
 local phrase=text(holder,entry.text,UDim2.fromOffset(12,0),UDim2.new(1,-24,0,58),44);phrase.TextXAlignment=Enum.TextXAlignment.Center;phrase.TextScaled=true;phrase.Font=Enum.Font.GothamBlack;phrase.ZIndex=82;phrase.TextColor3=color
 make("UITextSizeConstraint",phrase,{MinTextSize=16,MaxTextSize=54});make("UIStroke",phrase,{Color=Color3.new(0,0,0),Thickness=4})
 local tag=text(holder,preview and "PREVIEW - NOT A HIT" or string.format("Estimated hit / %d/%d",index,#SEQUENCE),UDim2.fromOffset(0,59),UDim2.new(1,0,0,18),10);tag.TextXAlignment=Enum.TextXAlignment.Center;tag.ZIndex=82;make("UIStroke",tag,{Color=Color3.new(0,0,0),Thickness=2})
 local record={holder=holder};table.insert(popupRecords,1,record);reflowPopups();TS:Create(ps,TweenInfo.new(.16,Enum.EasingStyle.Back),{Scale=1}):Play()
 for i=1,2 do local ring=make("Frame",holder,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.35),Size=UDim2.fromOffset(18,18),BackgroundTransparency=1,ZIndex=80});corner(ring,999);local outline=make("UIStroke",ring,{Color=i==1 and Color3.fromRGB(255,24,45) or Color3.fromRGB(8,0,4),Thickness=3});TS:Create(ring,TweenInfo.new(.32),{Size=UDim2.fromOffset(300+i*60,70)}):Play();TS:Create(outline,TweenInfo.new(.32),{Transparency=1}):Play() end
 if entry.sparkles and not preview then sparkleTarget=phrase;sparkleKind=entry.sparkles;sparkleStart=os.clock() end
 if not preview then playVoice(entry.sound or POPUP_SOUND_POOL[popupRng:NextInteger(1,#POPUP_SOUND_POOL)]) end
 gui:SetAttribute("LastBlackflashPopupPhrase",entry.text)
 task.delay(hold,function()
  if not running or not holder.Parent then return end
  for _,o in ipairs(holder:GetDescendants()) do if o:IsA("TextLabel") then TS:Create(o,TweenInfo.new(fade),{TextTransparency=1}):Play() elseif o:IsA("UIStroke") then TS:Create(o,TweenInfo.new(fade),{Transparency=1}):Play() end end
  TS:Create(ps,TweenInfo.new(fade),{Scale=.92}):Play()
 end)
 task.delay(hold+fade,function() if holder.Parent then holder:Destroy() end;local at=table.find(popupRecords,record);if at then table.remove(popupRecords,at) end;if running then reflowPopups() end end)
end

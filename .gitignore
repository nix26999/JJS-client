    if p and p.Model~=targetModel then targetModel=p.Model;resetRoute();flickUntil=0;routeCache=nil;bodyCache=nil;sideChoiceUntil=0 end;enforcePriority();return p,tr
   end
   local function waitUntil(deadline) while os.clock()<deadline do check();beat() end;check() end
   local function waitFor(seconds) local untilTime=os.clock()+seconds;repeat check();updateTarget();beat() until os.clock()>=untilTime;check();return true end
   local function animationBusy()
    if os.clock()-lastPairAt>1.4 then return false end

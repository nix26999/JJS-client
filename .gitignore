   if spec.kind=="advanced" then for key,deadline in pairs(cooldownUntil) do if os.clock()<deadline then info.Text=string.format("Estimated cooldown %s: %.1fs",key.Name,deadline-os.clock());return end end end
   local c=LP.Character;hum=c and c:FindFirstChildOfClass("Humanoid");root=c and c:FindFirstChild("HumanoidRootPart")

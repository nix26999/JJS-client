end)()

-- Diagnostics, compact UI, search and per-module settings drawers.
;(function()
 local alive=true;local links={};local drawers={}
 local function listen(signal,fn) local c=signal:Connect(fn);table.insert(links,c);return c end
 local diag=card(pages.Settings,"Diagnostics","Explicit adapter/input status; no fabricated hit confirmation")
 local debugText=make("TextBox",diag,{Size=UDim2.new(1,0,0,126),BackgroundColor3=T.p2,Text="",TextEditable=false,ClearTextOnFocus=false,MultiLine=true,TextWrapped=true,TextColor3=T.dim,TextSize=11,Font=Enum.Font.Code,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=3})
 local elapsed=0
 listen(RS.Heartbeat,function(dt)
  elapsed+=dt;if elapsed<.25 then return end;elapsed=0
  local a=rawget(_G,"JJSVerifiedCombat");local b=rawget(_G,"JJSActionFeedback")
  local verified=type(a)=="table" and type(a.subscribe)=="function" and type(a.isReady)=="function"
  local readiness=type(b)=="table" and type(b.isReady)=="function"
  debugText.Text=table.concat({"Inputs: "..(okVIM and "service obtained (delivery not verified)" or "UNAVAILABLE"),"Hit adapter: "..(verified and "interface present; authenticity not independently verified" or "MISSING: V2/V3 + Yuji Quick Combo are blocked"),"Optional action readiness: "..(readiness and "interface present" or "absent; other skills use uncalibrated waits"),"Last action: "..tostring(gui:GetAttribute("MasterLastAction") or "none"),"Last status: "..tostring(gui:GetAttribute("MasterLastStatus") or "none"),"Last error: "..tostring(gui:GetAttribute("MasterLastError") or gui:GetAttribute("JJS_LastModuleError") or "none")},"\n")
 end)
 local function titleOf(c) for _,x in ipairs(c:GetChildren()) do if x:IsA("TextLabel") and x.LayoutOrder==0 then return x end end end
 local function cardLike(c,p) return c:IsA("Frame") and c.Parent==p and c:FindFirstChildOfClass("UIListLayout") and titleOf(c) end
 local function sorted(c)
  local rows={};for i,o in ipairs(c:GetChildren()) do if o:IsA("GuiObject") then table.insert(rows,{object=o,index=i}) end end
  table.sort(rows,function(a,b) if a.object.LayoutOrder==b.object.LayoutOrder then return a.index<b.index end;return a.object.LayoutOrder<b.object.LayoutOrder end);return rows
 end
 local function toggleLabel(o)
  if not o:IsA("TextButton") or o.Text~="" then return end
  local label=o:FindFirstChildWhichIsA("TextLabel")
  for _,c in ipairs(o:GetChildren()) do if c:IsA("Frame") and c.Size==UDim2.fromOffset(36,18) and label then return label.Text end end
 end
 local tooltip=make("TextLabel",gui,{Name="MasterTooltip",Size=UDim2.fromOffset(330,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=T.panel,Text="",TextWrapped=true,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,Visible=false,ZIndex=100});corner(tooltip,8)
 make("UIPadding",tooltip,{PaddingTop=UDim.new(0,8),PaddingBottom=UDim.new(0,8),PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10)})
 local hovered=nil
 local function moveTooltip()
  if not tooltip.Visible then return end;local camera=workspace.CurrentCamera;if not camera then tooltip.Visible=false;return end
  local inset=gui.IgnoreGuiInset and Vector2.zero or select(1,game:GetService("GuiService"):GetGuiInset());local mouse=UIS:GetMouseLocation()-inset;local viewport=camera.ViewportSize-inset
  local width=math.max(80,math.min(330,viewport.X-16));tooltip.Size=UDim2.fromOffset(width,0)
  tooltip.Position=UDim2.fromOffset(math.clamp(mouse.X+12,8,math.max(8,viewport.X-width-8)),math.clamp(mouse.Y+12,8,math.max(8,viewport.Y-tooltip.AbsoluteSize.Y-8)))
 end
 local function hover(label)
  listen(label.MouseEnter,function() hovered=label;tooltip.Text=label.Text;tooltip.Visible=main.Visible and #label.Text>0;moveTooltip() end)
  listen(label.MouseLeave,function() if hovered==label then hovered=nil;tooltip.Visible=false end end)
  listen(label:GetPropertyChangedSignal("Text"),function() if hovered==label then tooltip.Text=label.Text;moveTooltip() end end)
 end
 local search=make("TextBox",content,{Name="ModuleSearch",Position=UDim2.fromOffset(16,57),Size=UDim2.new(1,-32,0,30),BackgroundColor3=T.p2,BorderSizePixel=0,Text="",PlaceholderText="Search modules or settings...",PlaceholderColor3=T.mut,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false});corner(search,8)
 make("UIPadding",search,{PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10)})
 make("TextLabel",side,{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,Text="WORKSPACE",TextColor3=T.mut,Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=-100})
 for _,b in pairs(buttons) do
  b.Size=UDim2.new(1,0,0,30);b.TextXAlignment=Enum.TextXAlignment.Left;b.TextSize=12;make("UIPadding",b,{PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,6)})
  local mark=make("Frame",b,{Position=UDim2.new(0,0,.5,-7),Size=UDim2.fromOffset(3,14),BackgroundColor3=T.acc,BorderSizePixel=0});corner(mark,2)
  local function selected() mark.Visible=b.BackgroundTransparency<.5 end;selected();listen(b:GetPropertyChangedSignal("BackgroundTransparency"),selected)
 end
 for _,page in pairs(pages) do
  page.Position=UDim2.fromOffset(0,96);page.Size=UDim2.new(1,0,1,-96);page.ScrollBarImageColor3=T.acc;page.ScrollBarThickness=4
  local layout=page:FindFirstChildOfClass("UIListLayout");if layout then layout.Padding=UDim.new(0,6) end
  local cards,byTitle={},{}
  for _,c in ipairs(page:GetChildren()) do if cardLike(c,page) then table.insert(cards,c);byTitle[titleOf(c).Text]=c end end
  local companions,skip={},{}
  for _,c in ipairs(cards) do
   local owner=c:GetAttribute("MasterSettingsOwner");if not owner and titleOf(c).Text=="Quick Combo Timing" then owner="Quick Combo" end
   if owner and byTitle[owner] then companions[byTitle[owner]]=c;skip[c]=true end
  end
  for _,c in ipairs(cards) do if not skip[c] then
   local title=titleOf(c);local name=title.Text
   local p=c:FindFirstChildOfClass("UIPadding");if p then p.PaddingTop=UDim.new(0,7);p.PaddingBottom=UDim.new(0,7);p.PaddingLeft=UDim.new(0,10);p.PaddingRight=UDim.new(0,10) end
   local layout=c:FindFirstChildOfClass("UIListLayout");if layout then layout.Padding=UDim.new(0,4) end
   corner(c,9);title.TextSize=12;title.TextWrapped=true;title.AutomaticSize=Enum.AutomaticSize.Y;title.Size=UDim2.new(1,0,0,20)
   local candidates={};local primary=false
   if name~="Session" and name~="Dash Cooldowns" and name~="Diagnostics" then
    for _,row in ipairs(sorted(c)) do
     local o=row.object;local label=toggleLabel(o)
     local header=o==title or (o:IsA("TextLabel") and o.LayoutOrder==1) or (o:IsA("Frame") and o.Size.Y.Offset==1)
     if not header then
      if label and (not primary or (name=="ESP & Tracers" and (label=="ESP" or label=="Tracers"))) then primary=true
      elseif o:IsA("TextButton") or o:IsA("TextBox") or o:IsA("ScrollingFrame") or (o:IsA("Frame") and o:FindFirstChildWhichIsA("GuiButton",true)) then table.insert(candidates,o) end
     end
    end
   end
   local companion=companions[c];local extras={}
   if companion then for _,row in ipairs(sorted(companion)) do local o=row.object;if not(o:IsA("TextLabel") and (o.LayoutOrder==0 or o.LayoutOrder==1)) and not(o:IsA("Frame") and o.Size.Y.Offset==1) then table.insert(extras,o) end end end
   if #candidates>0 or #extras>0 then
    local body=make("Frame",c,{Name="ModuleSettings",Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Visible=false,LayoutOrder=100000})
    make("UIListLayout",body,{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder})
    local order=0;for _,o in ipairs(candidates) do order+=1;o.LayoutOrder=order;o.Parent=body end;for _,o in ipairs(extras) do order+=1;o.LayoutOrder=order;o.Parent=body end
    if companion then companion:Destroy() end
    make("UIPadding",title,{PaddingRight=UDim.new(0,34)})
    local arrow=make("TextButton",title,{Name="SettingsArrow",AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Size=UDim2.fromOffset(26,20),Text=">",TextColor3=T.acc,BackgroundColor3=T.p2,Font=Enum.Font.GothamBold,TextSize=15,BorderSizePixel=0});corner(arrow,6)
    local function expand(value) body.Visible=value;arrow.Text=value and "v" or ">";c:SetAttribute("SettingsExpanded",value) end
    expand(false);listen(arrow.Activated,function() expand(not body.Visible) end);drawers[c]={body=body,expand=expand}
   end
   for _,o in ipairs(c:GetChildren()) do
    if o:IsA("TextLabel") then
     hover(o)
     if o.LayoutOrder==1 then o.Visible=false elseif o.LayoutOrder>2 then o.AutomaticSize=Enum.AutomaticSize.None;o.Size=UDim2.new(1,0,0,16);o.TextWrapped=false;o.TextTruncate=Enum.TextTruncate.AtEnd;o.TextSize=10 end
    end
   end
   for _,o in ipairs(c:GetDescendants()) do
    if o:IsA("TextButton") and o.Size.Y.Offset==28 and o.Size.Y.Scale==0 then o.Size=UDim2.new(o.Size.X.Scale,o.Size.X.Offset,0,24) end
    if o:IsA("Frame") and o.Size.Y.Offset==44 and o.AutomaticSize==Enum.AutomaticSize.None then for _,bar in ipairs(o:GetChildren()) do if bar:IsA("TextButton") and bar.Text=="" and bar.Size.Y.Offset==14 then o.Size=UDim2.new(o.Size.X.Scale,o.Size.X.Offset,0,36);bar.Position=UDim2.new(bar.Position.X.Scale,bar.Position.X.Offset,0,20);bar.Size=UDim2.new(bar.Size.X.Scale,bar.Size.X.Offset,0,12) end end end
   end
  end end
 end
 local function filter()
  if not alive then return end;local q=string.lower(search.Text):match("^%s*(.-)%s*$")
  for _,page in pairs(pages) do for _,c in ipairs(page:GetChildren()) do if cardLike(c,page) then
   local match=q=="";if not match then for _,o in ipairs(c:GetDescendants()) do if (o:IsA("TextLabel") or o:IsA("TextButton")) and string.find(string.lower(o.Text),q,1,true) then match=true;break end end end
   c.Visible=match;local d=drawers[c]
   if d and q~="" then for _,o in ipairs(d.body:GetDescendants()) do if (o:IsA("TextLabel") or o:IsA("TextButton")) and string.find(string.lower(o.Text),q,1,true) then d.expand(true);break end end end
  end end end
 end
 listen(search:GetPropertyChangedSignal("Text"),filter)
 listen(UIS.InputChanged,function(input) if input.UserInputType==Enum.UserInputType.MouseMovement then moveTooltip() end end)
 listen(main:GetPropertyChangedSignal("Visible"),function() if not main.Visible then hovered=nil;tooltip.Visible=false end end)
 listen(gui.Destroying,function() alive=false;for _,c in ipairs(links) do c:Disconnect() end;table.clear(links) end)
 filter()
end)()

assert(RS:IsClient(),"Client required")
local UI_ROOT=assert(gethui and gethui(),"Executor gethui() unavailable")
local previous=UI_ROOT:FindFirstChild("AutoBlackflash")
if previous then
 local event=previous:FindFirstChild("Shutdown")
 if event and event:IsA("BindableEvent") then pcall(function() event:Fire() end) end
 if previous.Parent then previous:Destroy() end
end

 local function setting(name)
  if runVersion==3 then return V3_FIXED[name] end
  if name=="Turn" then return postDashTurnDegrees elseif name=="CameraHold" then return cameraFlickHoldMs elseif name=="RepeatGap" then return repeatGapMs elseif name=="JumpLead" then return jumpLeadMs elseif name=="Prefire" then return blackflashPrefireMs end
 end
 local function say(text) local label=runVersion==3 and feedbackV3 or feedback;if runVersion==3 then text=text:gsub("^V2","V3") end;if label.Parent and label.Text~=text then label.Text=text end end
 local function flat(v) return Vector3.new(v.X,0,v.Z) end
 local function rig() local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart");if h and r and h.Health>0 then return h,r end end
 local function typing() return UIS:GetFocusedTextBox()~=nil end
 local function invalidateCaches() targetCacheAt=-math.huge;targetCacheReady=false;cachedCandidate=nil;cachedRoot=nil;routeCache=nil;sharedParams=nil;paramsModel=nil;paramsCharacter=nil end
 local function sendKey(code,down) local ok,err=pcall(function() VIM:SendKeyEvent(down,code,false,game) end);if not ok then error(err,0) end end
 local function key(code,down)
  if down then if typing() then error(PAUSED_FOR_TYPING,0) end;if held[code] then return end;held[code]=true;if code==Enum.KeyCode.Three then suppressStartUntil=os.clock()+.1 end;sendKey(code,true)
  elseif held[code] then sendKey(code,false);held[code]=nil end
 end
 local function releaseInputs() for code in pairs(held) do pcall(function() sendKey(code,false) end) end;held={};if mouseDown then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end;mouseDown=false end
 local function restoreLockOn() if borrowedLock then lockOn=previousLockOn end;borrowedLock=false;lockSuppressed=false;mixFacing=Vector3.zero end
 local function restoreFacing() if ownedHumanoid and ownedHumanoid.Parent then ownedHumanoid.AutoRotate=previousAutoRotate end;ownedHumanoid=nil end
 local function move(mode,vector)
  if typing() then error(PAUSED_FOR_TYPING,0) end;phase=mode;steering=vector or Vector3.zero

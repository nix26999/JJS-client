 local flash=make("Frame",gui,{Name="BlackflashImpactFlash",Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(220,0,24),BackgroundTransparency=reducedFlash and .9 or .62,BorderSizePixel=0,ZIndex=79})
 TS:Create(flash,TweenInfo.new(.22),{BackgroundTransparency=1}):Play()
 for i=1,28 do
  local a=phraseRng:NextNumber(0,360);local r=phraseRng:NextInteger(150,390);local red=i%3==0
  local shard=make("Frame",flash,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(phraseRng:NextInteger(45,190),phraseRng:NextInteger(3,10)),Rotation=a,BackgroundColor3=red and Color3.fromRGB(255,20,42) or Color3.fromRGB(5,0,2),BorderSizePixel=0,ZIndex=80})
  TS:Create(shard,TweenInfo.new(.26,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Position=UDim2.new(.5,math.cos(math.rad(a))*r,.5,math.sin(math.rad(a))*r),BackgroundTransparency=1,Size=UDim2.fromOffset(18,1)}):Play()
 end
 task.delay(.32,function() if flash.Parent then flash:Destroy() end end)
 local holder=make("Frame",gui,{Name="BlackflashPopup",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.19),Size=UDim2.fromOffset(540,128),BackgroundTransparency=1,ZIndex=80});popup=holder
 local ps=make("UIScale",holder,{Scale=.55})
 local text=make("TextLabel",holder,{Size=UDim2.new(1,-48,0,76),Position=UDim2.fromOffset(24,24),BackgroundTransparency=1,Text=phrases[index],TextColor3=Color3.fromHSV(phraseRng:NextNumber(),.82,1),Font=Enum.Font.GothamBlack,TextScaled=true,TextWrapped=true,ZIndex=82})
 make("UITextSizeConstraint",text,{MinTextSize=18,MaxTextSize=54});make("UIStroke",text,{Color=Color3.new(0,0,0),Thickness=4})
 local red,black=Color3.fromRGB(255,24,45),Color3.fromRGB(8,0,4)
 local variant=phraseRng:NextInteger(1,3)
 for i=1,(variant==2 and 3 or 2) do
  local ring=make("Frame",holder,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(18,18),BackgroundTransparency=1,ZIndex=80});corner(ring,999)
  local outline=make("UIStroke",ring,{Color=i%2==0 and red or black,Thickness=4})
  TS:Create(ring,TweenInfo.new(.34),{Size=UDim2.fromOffset(330+i*45,92)}):Play();TS:Create(outline,TweenInfo.new(.34),{Transparency=1,Thickness=1}):Play()
 end
 for i=1,18 do
  local a=phraseRng:NextNumber(-180,180)
  local line=make("Frame",holder,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(phraseRng:NextInteger(24,78),phraseRng:NextInteger(3,8)),Rotation=a,BackgroundColor3=i%3==0 and red or black,BorderSizePixel=0,ZIndex=81})
  TS:Create(line,TweenInfo.new(.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Position=UDim2.new(.5,phraseRng:NextInteger(-245,245),.5,phraseRng:NextInteger(-54,54)),BackgroundTransparency=1,Size=UDim2.fromOffset(12,1)}):Play()
 end
 local tag=make("TextLabel",holder,{Size=UDim2.new(1,0,0,18),Position=UDim2.new(0,0,1,-8),BackgroundTransparency=1,Text=preview and "PREVIEW - NOT A HIT" or "Estimated hit",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=11,ZIndex=82});make("UIStroke",tag,{Color=Color3.new(0,0,0),Thickness=2})
 TS:Create(ps,TweenInfo.new(.13,Enum.EasingStyle.Back),{Scale=1.12}):Play()
 task.delay(.13,function() if popup==holder and token==popupToken then TS:Create(ps,TweenInfo.new(.12),{Scale=1}):Play() end end)
 task.delay(1.02,function() if popup~=holder or token~=popupToken then return end;for _,o in ipairs(holder:GetDescendants()) do if o:IsA("TextLabel") then TS:Create(o,TweenInfo.new(.36),{TextTransparency=1}):Play() elseif o:IsA("UIStroke") then TS:Create(o,TweenInfo.new(.36),{Transparency=1}):Play() elseif o:IsA("Frame") then TS:Create(o,TweenInfo.new(.36),{BackgroundTransparency=1}):Play() end end end)
 task.delay(1.4,function() if popup==holder and token==popupToken then popup=nil;holder:Destroy() end end)
end

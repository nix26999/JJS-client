       waitFor(token,cfg.LaunchTimeout/1000,function() local th,r=targetRig();return th.FloorMaterial==Enum.Material.Air and r.Position.Y>initialY+1 end)
       pulse(token,Enum.KeyCode.R);waitFor(token,cfg.TeleportWait/1000);dash(token)
       waitFor(token,cfg.CloseTimeout/1000,closeEnough);pulse(token,Enum.KeyCode.Four);waitFor(token,cfg.KickWait/1000)
       waitFor(token,cfg.CloseTimeout/1000,closeEnough);pulse(token,Enum.KeyCode.Three);waitFor(token,cfg.PunchesWait/1000)
       pulse(token,Enum.KeyCode.Two);waitFor(token,cfg.RedWait/1000);dash(token)
      end
     end
    end)

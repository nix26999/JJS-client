 local function key(code,down)
  if down then if typing() then error(TYPING,0) end;if held[code] then return end;held[code]=true;if code==Enum.KeyCode.Three then suppressStartUntil=os.clock()+.1 end;sendKey(code,true)
  elseif held[code] then sendKey(code,false);held[code]=nil end

  local cone=math.acos(math.clamp(.65/math.max(radius,.65),0,1));local rr=(signed*sign)%(math.pi*2);local lr=(-signed*sign)%(math.pi*2)
  if rearSide(tr) then rr=0;lr=0 else rr=math.max(0,rr-cone);lr=math.max(0,lr-cone) end;local p=paramsFor(tr)

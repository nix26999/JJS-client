 end
 local function rearSide(tr,fresh) return bodyBehindFraction(tr,fresh)>=CFG.BodyBehind end
 local function frontSide(tr) local d,offset=spacing(tr);if not d or d<.05 then return false end;local look=flat(tr.CFrame.LookVector);return look.Magnitude>.01 and offset.Unit:Dot(look.Unit)>=.55 end
 local function attackReady(tr)
  local h,r=rig();if not h or not tr or not tr.Parent then return false end
  local model=tr:FindFirstAncestorOfClass("Model");local hum=model and model:FindFirstChildOfClass("Humanoid");if not hum or hum.Health<=0 then return false end

   end)
  end
  local renderName="Master_"..spec.id
  if not spec.pair then RS:BindToRenderStep(renderName,Enum.RenderPriority.Camera.Value+10,function()
   if not active or gui:GetAttribute("MasterDashActive") then return end
   local ok,err=pcall(function()
    if not valid(gen) then stop("Stopped: lifecycle changed");return end
    if spec.kind=="yuji" and source and rawget(_G,"JJSVerifiedCombat")~=source then stop("Stopped: adapter changed");return end
    if workspace.CurrentCamera~=camera then stop("Stopped: camera changed");return end
    local _,tr=targetRig();local delta=Vector3.new(tr.Position.X-root.Position.X,0,tr.Position.Z-root.Position.Z)
    if moveGoal then local d=Vector3.new(moveGoal.X-root.Position.X,0,moveGoal.Z-root.Position.Z);hum:Move(d.Magnitude>.25 and d.Unit or Vector3.zero,false) end
    if delta.Magnitude>.01 then root.CFrame=CFrame.lookAt(root.Position,root.Position+delta) end
    if camera then local aim=down and root.Position+delta*.3-Vector3.new(0,8,0) or tr.Position+Vector3.new(0,1,0);if (aim-camera.CFrame.Position).Magnitude>.01 then camera.CFrame=CFrame.lookAt(camera.CFrame.Position,aim) end end
   end)
   if not ok then stop("Stopped: render error");REPORT(spec.name,err) end
  end) end
  connect(UIS.InputBegan,function(input,processed)
   if input.UserInputType~=Enum.UserInputType.Keyboard or UIS:GetFocusedTextBox() then return end
   if bindingOwner then
    if bindingOwner~=spec then return end
    if input.KeyCode==Enum.KeyCode.Escape then bindingOwner=nil
    elseif reserved[input.KeyCode.Name] or (binds[input.KeyCode.Name] and input.KeyCode~=bind) then binding.Text="Reserved key";return
    else binds[bind.Name]=nil;bind=input.KeyCode;binds[bind.Name]=true;bindingOwner=nil end
    binding.Text="Keybind: "..bind.Name.." (click to change)";return
   end
   if active and input.KeyCode==Enum.KeyCode.Escape then stop("Cancelled");return end
   if not processed and input.KeyCode==bind then launch() end
  end)
  connect(UIS.WindowFocusReleased,function() if active then stop("Stopped: focus lost") end end);connect(LP.CharacterRemoving,function() if active then stop("Stopped: respawn") end end)
  local function shutdown() enabled=false;if bindingOwner==spec then bindingOwner=nil end;stop("Off");if not spec.pair then RS:UnbindFromRenderStep(renderName) end end
  connect(unload.Activated,shutdown);connect(gui.Destroying,shutdown)
 end
 install({id="YujiQuick",character="Yuji",kind="yuji",page="Yuji",name="Quick Combo",bind=Enum.KeyCode.G,order=7,description="G | 3 M1 > jump + 1 > rear BF > 3 M1 > rear BF > downslam > 2",note="Real hit adapter required. BF pairs need >=75% body behind, <=7 studs and relevant attributed hits. Perfect hits are not guaranteed."})
 install({id="GojoAdvanced",character="Gojo",kind="advanced",page="Gojo",name="Advanced Combo",bind=Enum.KeyCode.J,order=20,description="J | 3 M1 > 1 > R > side dash > 4 > 3 > 2 > side dash",note="Uncalibrated fallback waits; local cooldown estimates ignore manual skills and server readiness. No 70% damage guarantee."})
 install({id="MegumiAbyss",character="Megumi",pair=true,page="Megumi",name="The Well's Unknown Abyss",bind=Enum.KeyCode.F6,order=1,first=Enum.KeyCode.Three,second=Enum.KeyCode.Two,interval=120,description="F6 | Toad 3 > Nue 2",note="Base Ten Shadows, manual aim. 120 ms is a trial input interval, not a verified activation window."})
 install({id="MahitoBF",character="Mahito",pair=true,page="Mahito",name="Focus Strike Black Flash",bind=Enum.KeyCode.F7,order=1,first=Enum.KeyCode.Three,second=Enum.KeyCode.Three,interval=350,description="F7 | Focus Strike 3 > timed second 3",note="Appropriate Perfection mode, manual aim. 350 ms is uncalibrated; successful Black Flash is not confirmed."})
